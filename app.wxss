/* ==================================================================
   全局主题令牌（换肤体系的核心）
   ------------------------------------------------------------------
   · 默认值 = 暖橙主题（page 级 CSS 变量，全站继承）
   · .theme-blue = 清透蓝主题覆盖（挂在每页最外层 .theme-root 上）
   · 页面 wxss 一律使用 var(--token)，禁止硬编码主题色——
     新增样式时从这里取令牌，换肤才能彻底（图标、按钮、卡片同色系联动）
   ================================================================== */
page {
  /* 品牌色（按钮 / 选中态 / 强调） */
  --brand: #E8590C;
  --brand-a: #F7A23B;   /* 渐变起 */
  --brand-b: #E8590C;   /* 渐变止 */
  --brand-soft: #FDEEE2;  /* 品牌浅底（chip 选中底、提示底） */
  --brand-soft-2: #FBE3D1; /* 比浅底深一档（入口大卡用，只重一点点） */
  --brand-tint: #FFF4E8;  /* 更浅的暖底（输入底、提示条） */
  --brand-tint-0: rgba(255, 244, 232, 0);  /* 同上的透明端（渐隐用，避免渐变中段发灰） */
  --brand-border: #F6DCC0;  /* 品牌浅边框 */
  --brand-glow: rgba(232, 89, 12, 0.15);
  --brand-shadow: rgba(232, 89, 12, 0.28);  /* 品牌按钮投影 */
  --brand-shadow-soft: rgba(232, 89, 12, 0.25);
  /* 中性色 */
  --bg: #FAF9F7;   /* 页面底 */
  --card: #FFFFFF;   /* 卡片 */
  --chip: #F5F3F0;   /* 未选中 chip / 次级底 */
  --line: #F0EEEA;   /* 分隔线 */
  --line-2: #E5E2DD;   /* 描边 */
  --line-3: #ECEAE6;   /* 深分隔 */
  --text: #232323;   /* 标题 */
  --text-2: #3A3A3A;   /* 正文 */
  --sub: #6B655E;   /* 次要说明 */
  --muted: #9C948A;   /* 弱化信息 / 未选中 tab */
  --faint: #B8B2AA;   /* 占位 / 箭头 */
  /* 语义色（两主题通用，蓝主题略调冷） */
  --ok: #3A9E5F;  --ok-soft: #E8F3EA;
  --sent: #00C79B;  /* 已发送/当前 等实心状态胶囊：薄荷青绿（两主题统一） */
  --warn: #B8860B;  /* 待发送等中间态 */
  --info: #5A7BD6;  --info-soft: #EDF1FB;
  --danger: #C0564A;
  /* 阴影 */
  --shadow: rgba(60, 40, 20, 0.05);   /* 卡片投影 */
  --mask: rgba(0, 0, 0, 0.55);   /* 弹窗遮罩 */

  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--text);
}

/* ---------- 清透蓝主题（设计规范：主 #59A8FF / 深 #0D1349 / 浅蓝 #A2DCFD） ---------- */
.theme-blue {
  --brand: #59A8FF;
  --brand-a: #59A8FF;
  --brand-b: #3D8BEE;
  --brand-soft: #E3F0FF;
  --brand-soft-2: #D7E9FF; /* 比浅底深一档（入口大卡用，只重一点点） */
  --brand-tint: #EFF6FF;
  --brand-tint-0: rgba(239, 246, 255, 0);
  --brand-border: #C7E1FF;
  --brand-glow: rgba(89, 168, 255, 0.18);
  --brand-shadow: rgba(89, 168, 255, 0.32);
  --brand-shadow-soft: rgba(89, 168, 255, 0.28);

  --bg: #F3F8FE;
  --card: #FDFEFF;
  --chip: #EDF3FA;
  --line: #E4EEF8;
  --line-2: #D5E3F2;
  --line-3: #E8F0F9;
  --text: #0D1349;
  --text-2: #33415E;
  --sub: #5E7290;
  --muted: #8FA3BC;
  --faint: #A9BACC;

  --ok: #3AA97F;  --ok-soft: #E3F6EC;
  --warn: #5E8BC7;
  --info: #4A7DDC;  --info-soft: #EDF1FB;
  --danger: #D9534F;

  --shadow: rgba(30, 70, 140, 0.08);
}

/* ---------- 极简主题（简洁版：白纸黑字 / 单一墨色强调 / 细线框替代投影） ----------
   设计原则：
   · 只用「墨黑 + 中性灰」一个色相做强调，其余信息靠字重与间距分层
   · 卡片改用 2rpx 细线框（box-shadow 描边，不占布局），几乎不留投影
   · 状态色（已发送/待发送/危险）保持语义不变，只把饱和度压一档
   ------------------------------------------------------------------ */
.theme-min {
  --brand: #1F2329;
  --brand-a: #34383F;
  --brand-b: #1B1E23;
  --brand-soft: #F1F2F4;
  --brand-soft-2: #E9EBEF; /* 比浅底深一档（入口大卡用，只重一点点） */
  --brand-tint: #F7F8FA;
  --brand-tint-0: rgba(247, 248, 250, 0);
  --brand-border: #E2E4E8;
  --brand-glow: rgba(31, 35, 41, 0.10);
  --brand-shadow: rgba(17, 19, 22, 0.16);
  --brand-shadow-soft: rgba(17, 19, 22, 0.12);

  --bg: #F6F7F9;
  --card: #FFFFFF;
  --chip: #F2F3F5;
  --line: #EDEEF0;
  --line-2: #E2E4E8;
  --line-3: #EAEBED;
  --text: #16181C;
  --text-2: #33373D;
  --sub: #5F656E;
  --muted: #8E949D;
  --faint: #B4B9C1;

  --ok: #2F8F5B;  --ok-soft: #E9F3ED;
  --sent: #00C79B;
  --warn: #A9761A;
  --info: #4B6FD6;  --info-soft: #EEF1FA;
  --danger: #C0453B;

  --shadow: rgba(17, 19, 22, 0.04);
  --mask: rgba(0, 0, 0, 0.5);
}
/* 极简版独有的排版收敛：卡片用细线框，投影几乎取消（只做样式，不动结构） */
.theme-min .card {
  box-shadow: 0 0 0 2rpx var(--line-2);
}
.theme-min .btn {
  box-shadow: none;
}

/* 每页最外层根节点：承载主题类，撑满全屏并把主题底色铺到页面上 */
.theme-root {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* ---------- 卡片体系 ---------- */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
.sec {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 0 20rpx;
}
.sec::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, var(--brand-a), var(--brand-b));
}
.sec .label { margin: 0; }
.label { font-size: 28rpx; font-weight: 700; color: var(--text); margin: 28rpx 0 16rpx; }
.h1 { font-size: 34rpx; font-weight: 700; }
.mi { font-size: 24rpx; color: var(--muted); }
/* ---------- 胶囊 ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--text-2);
  transition: all 0.15s;
}
.chip.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 700;
  box-shadow: inset 0 0 0 3rpx var(--brand), 0 4rpx 12rpx var(--brand-glow);
}
/* ---------- 按钮 ---------- */
.btn {
  background: linear-gradient(135deg, var(--brand-a), var(--brand-b));
  color: #fff;
  border-radius: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx var(--brand-shadow);
}
.btn.ghost {
  background: var(--card);
  color: var(--text-2);
  border: 2rpx solid var(--line-2);
  font-weight: 500;
  box-shadow: none;
}
.btn-hover { opacity: 0.85; transform: scale(0.985); }
/* ---------- 输入 ---------- */
.input, .pickerbox {
  background: var(--bg);
  border: 2rpx solid var(--line-2);
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
/* ---------- 头像 ---------- */
.ava {
  width: 92rpx; height: 92rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, var(--brand-a), var(--brand-b));
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex: none;
  box-shadow: 0 6rpx 14rpx var(--brand-shadow-soft);
}
/* ---------- 页脚标语：全局统一居中 ---------- */
.slogan { text-align: center; color: var(--faint); font-size: 24rpx; margin: 40rpx 0 20rpx; }
.pill { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #fff; }
/* ---------- 统一说明条：淡黄底 + 浅边框，全 App 解释/说明类文字统一用 ---------- */
/* 只定盒子样式不带外边距：卡内、页级、弹层里各自配合并类控制间距 */
.note {
  font-size: 24rpx; color: var(--sub); line-height: 1.7;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  border-radius: 16rpx; padding: 16rpx 22rpx;
}
.empty { text-align: center; color: var(--muted); padding: 140rpx 40rpx; font-size: 27rpx; line-height: 1.8; }
.chev { color: var(--faint); font-size: 38rpx; font-weight: 300; }
/* 品牌色大按钮内的白色线性图标（如「＋ 记录本节成果」） */
.btn { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.bico { width: 32rpx; height: 32rpx; }
/* 下拉选择框：文字 + 统一箭头图标 */
.pickerbox { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.pickerbox .xico { width: 26rpx; height: 26rpx; }
/* ---------- 语音输入：输入框右端麦克风 ---------- */
/* 结构：<view class="vin"><input class="… vin-in"/><image class="vmic"/></view> */
.vin { position: relative; }
.vin .vin-in { padding-right: 80rpx; }
.vin .vmic {
  position: absolute; right: 24rpx; top: 50%; margin-top: -18rpx;
  width: 36rpx; height: 36rpx; opacity: 0.5;
}
/* 行内搜索框里的麦克风：不套 .vin，直接排在输入框后面（flex 行内一枚小图标） */
.smic { flex: none; width: 32rpx; height: 32rpx; opacity: 0.5; }

/* 麦克风「正在聆听」：平时是半透明小灰图标，录音时变红底白图 + 脉冲光环，
   一眼能看出正在收音、再点一下就结束（用户反馈：选中与没选中区别不大） */
.vmic.rec, .smic.rec {
  opacity: 1;
  border-radius: 50%;
  background: var(--danger);
  filter: brightness(0) invert(1);   /* 图标描边统一变白，压在红底上 */
  animation: micpulse 1.1s ease-in-out infinite;
}
@keyframes micpulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(192, 86, 74, 0.40); }
  50% { box-shadow: 0 0 0 14rpx rgba(192, 86, 74, 0); }
}

/* 表单字段级校验提示：跟在对应输入框下面的一行小字（红） */
.field-err { font-size: 22rpx; color: var(--warn); margin-top: 8rpx; line-height: 1.5; }
