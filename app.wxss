page {
  background: #F4FAFF;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #0D1349;
}
/* ---------- 卡片体系 ---------- */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(13, 19, 73, 0.05);
}
.sec {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 0 20rpx;
}
.sec::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #A2DCFD, #59A8FF);
}
.sec .label { margin: 0; }
.label { font-size: 28rpx; font-weight: 700; color: #0D1349; margin: 28rpx 0 16rpx; }
.h1 { font-size: 34rpx; font-weight: 700; }
.mi { font-size: 24rpx; color: #93A5BE; }
/* ---------- 胶囊 ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #EFF5FC;
  color: #3A4A63;
  transition: all 0.15s;
}
.chip.on {
  background: #E3F1FF;
  color: #59A8FF;
  font-weight: 700;
  box-shadow: inset 0 0 0 3rpx #59A8FF, 0 4rpx 12rpx rgba(89, 168, 255, 0.15);
}
/* ---------- 按钮 ---------- */
.btn {
  background: linear-gradient(135deg, #A2DCFD, #59A8FF);
  color: #fff;
  border-radius: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(89, 168, 255, 0.28);
}
.btn.ghost {
  background: #fff;
  color: #3A4A63;
  border: 2rpx solid #DCE8F4;
  font-weight: 500;
  box-shadow: none;
}
.btn-hover { opacity: 0.85; transform: scale(0.985); }
/* ---------- 输入 ---------- */
.input, .pickerbox {
  background: #F7FBFF;
  border: 2rpx solid #DCE8F4;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
/* ---------- 头像 ---------- */
.ava {
  width: 92rpx; height: 92rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, #A2DCFD, #59A8FF);
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex: none;
  box-shadow: 0 6rpx 14rpx rgba(89, 168, 255, 0.25);
}
.pill { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #fff; }
.empty { text-align: center; color: #93A5BE; padding: 140rpx 40rpx; font-size: 27rpx; line-height: 1.8; }
.chev { color: #B9C8DC; font-size: 38rpx; font-weight: 300; }
