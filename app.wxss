page {
  background: #f7f6f3;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #232323;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.h1 { font-size: 36rpx; font-weight: 700; }
.mi { font-size: 24rpx; color: #9c948a; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f0eeea;
  color: #4a4a4a;
}
.chip.on { background: #fdeee2; color: #e8590c; font-weight: 600; box-shadow: inset 0 0 0 3rpx #e8590c; }
.btn {
  background: #e8590c;
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}
.btn.ghost { background: #fff; color: #4a4a4a; border: 2rpx solid #e5e2dd; font-weight: 500; }
.input {
  background: #fff;
  border: 2rpx solid #e5e2dd;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.label { font-size: 27rpx; font-weight: 600; color: #4a4a4a; margin: 24rpx 0 16rpx; }
.ava {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: #f0a95f; color: #fff; font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.pill { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; color: #fff; }
