/* 全站统一头像：色块底 + 白色首字；照片铺满 */
.ava {
  position: relative; overflow: hidden; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700; line-height: 1;
  box-shadow: 0 4rpx 12rpx var(--brand-shadow-soft);
}
.ava .img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.ava .ch { position: relative; }
/* 角色色块：与 mgr 页原有配色一致，迁到组件里全站共用 */
.ava-brand { background: linear-gradient(135deg, var(--brand-a), var(--brand-b)); }
.ava-owner { background: linear-gradient(135deg, #6B8FD6, #4A7DDC); }
.ava-parent { background: linear-gradient(135deg, #7FB069, #3A9E5F); }
