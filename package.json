{
  "name": "chengguo-deploy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "node deploy.js",
    "test": "node tests/run.js",
    "test:roles": "node tests/verify_journey.js && node tests/verify_owner.js && node tests/verify_teacher.js && node tests/verify_parent.js",
    "test:e2e": "node tests/e2e_smoke.js",
    "lint": "node tools/lint.js",
    "size": "node tools/size.js",
    "review": "node tools/review.js",
    "check": "node tools/lint.js && node tools/schema-doc.js --check && node tools/size.js && node tests/run.js",
    "docs:schema": "node tools/schema-doc.js",
    "cloud": "node tools/cf-deploy.js",
    "cloud:ls": "node tools/cf-deploy.js --list",
  "cloud:info": "node tools/cf-deploy.js --info",
    "preview": "node tools/mp-release.js preview",
    "ship": "node tools/mp-release.js ship",
    "upload": "node tools/mp-release.js ship"
  },
  "dependencies": {
    "miniprogram-ci": "^2.1.9"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.13.0"
  }
}
