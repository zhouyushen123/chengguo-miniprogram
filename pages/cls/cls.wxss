.clshead {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 16rpx; margin-bottom: 16rpx;
}
.cnt { font-size: 22rpx; color: var(--muted); flex: none; }

/* 状态分类筛选条 */
.filtbar { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.fchip {
  font-size: 23rpx; color: var(--sub); background: var(--line);
  border-radius: 999rpx; padding: 8rpx 24rpx;
}
.fchip.on { background: var(--text-2); color: #fff; font-weight: 500; }
/* 页签内的统计数：比文字淡一档，选中时随页签变白 */
.fchip .fc { margin-left: 6rpx; opacity: 0.62; }

/* 学生三状态色块：一行 5 个 */
.stugrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; }
.stile {
  padding: 16rpx 0; text-align: center; min-width: 0;
  background: var(--line); border-radius: 12rpx;
  font-size: 25rpx; color: var(--sub); font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.stile.s-rec { background: var(--sent); color: #fff; font-weight: 600; }
.stile.s-sent { background: #4a7ddc; color: #fff; font-weight: 600; }

.hint { margin-top: 16rpx; font-size: 24rpx; color: var(--faint); text-align: center; }

.legend { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--muted); }
.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.dot.dg { background: var(--sent); }
.dot.db { background: #4a7ddc; }
.dot.dn { background: var(--line); border: 2rpx solid var(--line-2); }
.lg.tip { margin-left: auto; }

/* 一键发送按钮 */
.sendbtn {
  margin-top: 20rpx; text-align: center;
  background: var(--brand); color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 999rpx; padding: 20rpx 0;
}
.sendbtn.off { background: var(--line); color: var(--faint); font-weight: 400; }
/* 本次课没记录时替代结清按钮的淡提示：说明按钮去哪了，不占主操作位 */
.settlehint { margin-top: 22rpx; }
/* 批量录入入口：次级按钮，与发布结清按钮隔开 */
.batchbtn {
  margin-top: 16rpx; text-align: center;
  background: var(--chip); color: var(--sub); font-size: 27rpx;
  border-radius: 999rpx; padding: 18rpx 0; border: 2rpx solid var(--line-2);
}

/* 班级记录筛选 */
.rechead { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; }
.rechead .label { flex: none; }
.pickers { display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end; }
.pkbox {
  font-size: 22rpx; color: var(--sub); background: var(--bg);
  border: 2rpx solid var(--line-2); border-radius: 999rpx; padding: 8rpx 20rpx;
  white-space: nowrap; display: inline-flex; align-items: center; gap: 8rpx;
}
.pico { width: 22rpx; height: 22rpx; }

.recrow { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--chip); }
.recrow:last-child { border-bottom: none; }
.hleft { flex: 1; min-width: 0; }
.chev { width: 30rpx; height: 30rpx; flex: none; }

/* ---------- 家长回执（本次课已看比例 / 留言数） ---------- */
.fbline {
  display: flex; align-items: center; gap: 10rpx;
  margin-top: 18rpx; padding: 14rpx 20rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  border-radius: 18rpx; font-size: 25rpx; color: var(--text-2);
}
.fbdot { color: var(--brand); }
.fblink { margin-left: auto; color: var(--brand); font-weight: 600; }
