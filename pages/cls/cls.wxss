.clshead {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 16rpx; margin-bottom: 16rpx;
}
.cnt { font-size: 22rpx; color: #9c948a; flex: none; }
.cnt b { font-size: 26rpx; }
.cnt b.blue { color: #4a7ddc; }
.cnt b.gray { color: #b8b2aa; }

/* 状态分类筛选条 */
.filtbar { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.fchip {
  font-size: 23rpx; color: #6f6a63; background: #f0eeea;
  border-radius: 999rpx; padding: 8rpx 24rpx;
}
.fchip.on { background: #3a3a3a; color: #fff; font-weight: 500; }

/* 学生三状态色块：一行 5 个 */
.stugrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; }
.stile {
  padding: 16rpx 0; text-align: center; min-width: 0;
  background: #f0eeea; border-radius: 12rpx;
  font-size: 25rpx; color: #6f6a63; font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.stile.s-rec { background: #3a9e5f; color: #fff; font-weight: 600; }
.stile.s-sent { background: #4a7ddc; color: #fff; font-weight: 600; }

.hint { margin-top: 16rpx; font-size: 24rpx; color: #b8b2aa; text-align: center; }

.legend { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #9c948a; }
.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.dot.dg { background: #3a9e5f; }
.dot.db { background: #4a7ddc; }
.dot.dn { background: #f0eeea; border: 2rpx solid #e0dcd6; }
.lg.tip { margin-left: auto; }

/* 一键发送按钮 */
.sendbtn {
  margin-top: 20rpx; text-align: center;
  background: #e8590c; color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 999rpx; padding: 20rpx 0;
}
.sendbtn.off { background: #f0eeea; color: #b8b2aa; font-weight: 400; }

/* 班级记录筛选 */
.rechead { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.rechead .label { flex: none; }
.pickers { display: flex; gap: 12rpx; }
.pkbox {
  font-size: 22rpx; color: #6f6a63; background: #faf9f7;
  border: 2rpx solid #e5e2dd; border-radius: 999rpx; padding: 8rpx 20rpx;
  white-space: nowrap;
}

.recrow { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f5f3f0; }
.recrow:last-child { border-bottom: none; }
.hleft { flex: 1; min-width: 0; }
.chev { color: #c9c4bd; font-size: 36rpx; }
