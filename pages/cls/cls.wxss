.clshead {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 20rpx;
}
.cnt { font-size: 25rpx; color: #9c948a; }
.cnt b { color: #3a9e5f; font-size: 30rpx; }

/* 学生状态色块：一行 5 个，绿=已录，灰=未录 */
.stugrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; }
.stile {
  padding: 16rpx 0; text-align: center; min-width: 0;
  background: #f0eeea; border-radius: 12rpx;
  font-size: 25rpx; color: #6f6a63; font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.stile.done { background: #3a9e5f; color: #fff; font-weight: 600; }

.legend { display: flex; align-items: center; gap: 28rpx; margin-top: 20rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #9c948a; }
.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.dot.g { background: #3a9e5f; }
.dot.n { background: #f0eeea; border: 2rpx solid #e0dcd6; }
.lg.tip { margin-left: auto; }

.recrow { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f5f3f0; }
.recrow:last-child { border-bottom: none; }
.hleft { flex: 1; min-width: 0; }
.chev { color: #c9c4bd; font-size: 36rpx; }
