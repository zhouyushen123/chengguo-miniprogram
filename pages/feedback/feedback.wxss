.wrap { padding-top: 16rpx; padding-bottom: 40rpx; }

/* 概览：左边一个大数字，右边两行说明 */
.sum { display: flex; align-items: center; gap: 24rpx; }
.suml { display: flex; align-items: baseline; gap: 8rpx; flex: none; }
.sumn { font-size: 60rpx; font-weight: 700; color: var(--brand); line-height: 1; }
.sumn.warn { color: var(--danger); }
.sumt { font-size: 24rpx; color: var(--muted); }
.sumr { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }

/* 班级页签 */
.clsbar { white-space: nowrap; padding: 0 24rpx 8rpx; }
.clsrow { display: inline-flex; gap: 14rpx; }
.clsrow .chip { flex: none; }

/* 留言卡：已处理的整体降饱和，未处理的靠左描边突出 */
.fb { position: relative; }
.fb.done { opacity: 0.72; }
.fbh { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.fbh b { font-size: 30rpx; flex: none; }
.fbh .ell { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fbh .pill { flex: none; }
.p-new { background: var(--danger); color: #fff; }
.p-done { background: var(--line-2); color: var(--sub); }
.fbt {
  margin-top: 14rpx; font-size: 28rpx; color: var(--text); line-height: 1.7;
  background: var(--bg); border-radius: 18rpx; padding: 18rpx 22rpx;
  white-space: pre-wrap; word-break: break-word;
}
.btnrow { display: flex; margin-top: 16rpx; }
.btnrow .btn { flex: 1; font-size: 27rpx; padding: 18rpx 0; }
