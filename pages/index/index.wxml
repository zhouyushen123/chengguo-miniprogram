<view class="theme-root {{themeCls}}">
<!-- 自定义导航栏：标题靠左（原生导航标题只能居中），需避开右上角胶囊 -->
<view class="cnav" style="padding-top:{{statusBarH}}px">
  <view class="cnav-t">{{navTitle}}</view>
</view>
<!-- 演示数据提示：现在看的是样板间，看够了点右边开始用自己的一摊 -->
<view wx:if="{{sandbox}}" class="demobar">
  <text class="demobar-t">演示数据 · 只看不改</text>
  <text class="demobar-btn" hover-class="btn-hover" bindtap="startReal">开始使用</text>
</view>
<view wx:if="{{!isParent}}">
  <!-- 全新机构：库里没有班级也没有学生。这时候摆"开始录入"和三块 0 只会让人以为东西是坏的，
       所以换成一张开通卡，把"先建机构 → 学期 → 班级 → 学生"这条路直接铺在首页上 -->
  <block wx:if="{{empty}}">
    <view class="topbar">
      <view class="hello">初次见面，{{uName}}</view>
      <view class="datechip">{{dateStr}}</view>
    </view>
    <view class="onboard card">
      <view class="obtitle">先花一分钟把机构建起来</view>
      <view class="obsub">填好机构信息，再建学期、班级、学生，就能录第一条成果了。</view>
      <view class="obsteps">
        <view class="obstep"><text class="obn">1</text>机构信息</view>
        <view class="obstep"><text class="obn">2</text>本学期</view>
        <view class="obstep"><text class="obn">3</text>一个班</view>
        <view class="obstep"><text class="obn">4</text>加学生</view>
      </view>
      <view class="btn" hover-class="btn-hover" bindtap="goSetup">开始开通</view>
      <view class="obdemo" bindtap="viewDemo">先看看示例数据 ›</view>
    </view>
    <view class="slogan">橙果 · 让每一次进步都被看见</view>
  </block>

  <block wx:else>
  <!-- 顶部欢迎 -->
  <view class="topbar">
    <view class="hello">{{roleLabel}} · 欢迎回来，{{uName}}</view>
    <view class="datechip">{{dateStr}}</view>
  </view>

  <!-- 主操作区：左大卡 + 右侧两叠卡（记录入口 / 搜索学生） -->
  <view class="herog-wrap">
    <view class="herog">
      <view class="hgc big" hover-class="btn-hover" bindtap="goRecord">
        <image class="hgc-ico" src="{{icoPlusW}}" mode="aspectFit" />
        <view class="hgc-t">开始录入</view>
        <view class="hgc-s">选学生 · 打分 · 发家长</view>
      </view>
      <view class="hgc-col">
        <view class="hgc a" hover-class="btn-hover" bindtap="goRecords">
          <image class="hgc-ico sm" src="{{icoDoc}}" mode="aspectFit" />
          <view class="hgc-t sm">全部记录</view>
          <view class="hgc-s">按学生查看</view>
        </view>
        <view class="hgc searchcell">
          <image class="scico" src="{{icoSearch}}" mode="aspectFit" />
          <input class="scinput" placeholder="搜索学生姓名" placeholder-class="ph" value="{{q}}" bindinput="onSearch" confirm-type="search" />
          <image class="smic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="q" />
          <image wx:if="{{q}}" class="sclear" src="{{icoClose}}" mode="aspectFit" bindtap="clearSearch" />
        </view>
      </view>
    </view>
    <view wx:if="{{q}}" class="sresults">
      <view wx:for="{{results}}" wx:key="id" class="sresult" hover-class="btn-hover" bindtap="goStudent" data-sid="{{item.id}}">
        <text class="sname">{{item.name}}</text>
        <text class="smeta">{{item.meta}}</text>
        <image class="chev" src="{{icoChev}}" mode="aspectFit" />
      </view>
      <view wx:if="{{!results.length}}" class="mi" style="padding:20rpx 8rpx">没找到「{{q}}」相关学生</view>
      <view wx:elif="{{moreCount}}" class="mi smore">还有 {{moreCount}} 位匹配学生，请继续输入缩小范围</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat" hover-class="btn-hover" bindtap="goMgr">
      <view class="num">{{clsCount}}</view>
      <view class="sl">班级 ›</view>
    </view>
    <view class="stat" hover-class="btn-hover" bindtap="goMgr">
      <view class="num">{{stuCount}}</view>
      <view class="sl">学生 ›</view>
    </view>
    <view class="stat" hover-class="btn-hover" bindtap="goRecords">
      <view class="num {{pending?'warn':''}}">{{pending}}</view>
      <view class="sl">本次未录入 ›</view>
    </view>
  </view>

  <!-- 我的班级 -->
  <view class="sechead">
    <text class="sectitle">我的班级</text>
    <text class="seclink" bindtap="goMgr">管理</text>
  </view>
  <!-- 我的班级：整块一张卡，里面是班级条目 -->
  <view wx:if="{{myClasses.length}}" class="card panel">
    <view class="clsgrid">
      <view class="clstile c{{index%3}}" wx:for="{{myClasses}}" wx:key="id" hover-class="btn-hover" bindtap="goCls" data-id="{{item.id}}">
        <view class="ctname">{{item.name}}</view>
        <view class="ctmeta">{{item.count}} 名学生</view>
        <view wx:if="{{item.pending}}" class="ctwarn">本次未录<text class="dot"></text></view>
      </view>
    </view>
  </view>
  <view wx:if="{{!myClasses.length}}" class="empty">还没有班级，去「我的」里创建</view>

  <!-- 最近成果：整块一张卡 -->
  <view class="sechead">
    <text class="sectitle">最近成果</text>
    <text class="seclink" bindtap="goRecords">全部</text>
  </view>
  <view wx:if="{{recent.length}}" class="card panel">
    <view class="recgrid">
      <view class="rectile" wx:for="{{recent}}" wx:key="id" hover-class="btn-hover" bindtap="openRec" data-rid="{{item.id}}" data-sid="{{item.sid}}">
        <view class="rtname">{{item.name}}</view>
        <view class="rtmeta">{{item.clsName}} · {{item.sd}} · {{item.score}}分</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!recent.length}}" class="empty">还没有成果记录，点上面「开始录入」记一条吧</view>
  </block>
</view>

<view wx:else>
  <view class="topbar">
    <view class="hello">{{roleLabel}} · {{uName}}</view>
    <view class="datechip">{{dateStr}}</view>
  </view>

  <!-- 多孩家庭：切换孩子 -->
  <view wx:if="{{kids.length > 1}}" class="kidchips">
    <view wx:for="{{kids}}" wx:key="id" class="kchip {{kidId===item.id?'on':''}}" bindtap="pickKid" data-id="{{item.id}}">{{item.name}}</view>
  </view>

  <!-- 订阅成绩通知：微信服务通知（唯一官方免费触达）。未配置模板时点了解并跳过，不弹窗也不报错 -->
  <view wx:if="{{notifyTip}}" class="notifybar" hover-class="btn-hover" bindtap="onSubscribe">
    <view class="notifybar-main">
      <view class="notifybar-t">开启成绩通知</view>
      <view class="notifybar-d">老师发布成果后微信提醒，不再漏看</view>
    </view>
    <text class="notifybar-btn">开启</text>
  </view>

  <!-- 孩子卡 + 统计 -->
  <view class="card">
    <view class="pstu">
      <ava src="{{kPhoto}}" name="{{kName}}" size="{{96}}" radius="{{30}}" />
      <view class="stuinfo">
        <view class="h1">{{kName}}</view>
        <view class="mi">{{kCls}}</view>
      </view>
      <view class="seclink" bindtap="goKidPage">完整档案 ›</view>
    </view>
    <view wx:if="{{stats}}" class="pstats">
      <text class="pstat ps-c">{{stats.lessons}} 节课</text>
      <text class="pstat ps-g">优秀 {{stats.great}} 次</text>
      <text class="pstat ps-d">{{stats.days}} 个学习日</text>
      <text wx:if="{{hasCarry}}" class="pstat ps-b">剩余 {{hoursRemain}} 课时</text>
    </view>
    <view wx:if="{{stats && stats.care}}" class="caretip">有 {{stats.care}} 次课需要多鼓励，见下方「需要注意」</view>
  </view>

  <!-- 最近一次详情 -->
  <view wx:if="{{kLatest}}" class="card" hover-class="btn-hover" bindtap="openRec" data-rid="{{kLatest.id}}" data-sid="{{kidId}}">
    <view class="dimhead">
      <text class="pill pill-o">最近一次</text>
      <text class="lcourse">{{kLatest.course}}</text>
      <view class="dhr">
        <text class="mi">{{kLatest.date}}</text>
        <text wx:if="{{kLatest.tag}}" class="badge {{kLatest.tcls}}">{{kLatest.tag}}</text>
      </view>
    </view>
    <view class="notegroups" wx:if="{{kLatest.noteLines.length}}">
      <view class="kline" wx:for="{{kLatest.noteLines}}" wx:key="index"><text wx:if="{{item.label}}" class="klabel">{{item.label}}：</text><text class="ktext">{{item.text}}</text></view>
    </view>
    <view wx:if="{{latestPhotos.length}}" class="photostrip">
      <image wx:for="{{latestPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
    </view>
    <view class="mi morelink" wx:if="{{kLatest.pcnt > latestPhotos.length}}">共 {{kLatest.pcnt}} 张照片，点看完整记录 ›</view>
    <view class="mi" wx:if="{{!kLatest.noteLines.length && !kLatest.pcnt}}">老师还没有写下文字评价</view>
  </view>
  <view wx:elif="{{stats}}" class="card mi">还没有已发布的成果记录，老师发布后就能在这里看到</view>

  <!-- 需要注意：加油/待提高的课 -->
  <block wx:if="{{kCare.length}}">
    <view class="sechead"><text class="sectitle">需要注意</text></view>
    <view class="card">
      <view class="histr" wx:for="{{kCare}}" wx:key="id" hover-class="btn-hover" bindtap="openRec" data-rid="{{item.id}}" data-sid="{{kidId}}">
        <text class="badge {{item.tcls}}">{{item.tag}}</text>
        <view class="hmain">
          <view class="ht1"><b>{{item.course}}</b></view>
          <view class="mi">{{item.date}} · {{item.snip}}</view>
        </view>
        <image class="chev" src="{{icoChev}}" mode="aspectFit" />
      </view>
    </view>
  </block>

  <!-- 历史记录 -->
  <view class="sechead">
    <text class="sectitle">历史记录</text>
    <text class="seclink" wx:if="{{kidId}}" bindtap="goKidPage">全部</text>
  </view>
  <view class="card" wx:if="{{kHistory.length}}">
    <view class="histr" wx:for="{{kHistory}}" wx:key="id" hover-class="btn-hover" bindtap="openRec" data-rid="{{item.id}}" data-sid="{{kidId}}">
      <view class="hmain">
        <view class="ht1"><b>{{item.course}}</b><text wx:if="{{item.tag}}" class="badge sm {{item.tcls}}">{{item.tag}}</text></view>
        <view class="mi">{{item.date}} · {{item.score}}分{{item.snip?' · '+item.snip:''}}</view>
      </view>
      <view wx:if="{{item.pcnt}}" class="hcam"><image class="camico" src="{{icoCam}}" mode="aspectFit" />{{item.pcnt}}</view>
    </view>
  </view>
  <view wx:elif="{{kLatest}}" class="empty">暂无更多历史记录</view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup />
</view>
