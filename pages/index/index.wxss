/* ---------- 班级横条 ---------- */
.clsbar {
  position: sticky; top: 0; z-index: 40;
  background: rgba(247, 246, 243, 0.96); backdrop-filter: blur(10px);
  padding: 20rpx 0 12rpx; white-space: nowrap;
}
.clsrow { display: inline-flex; gap: 16rpx; padding: 0 24rpx; }
/* ---------- 学生卡片 ---------- */
.sturow { display: flex; align-items: center; gap: 22rpx; }
.stuinfo { flex: 1; min-width: 0; }
.latest {
  margin-top: 20rpx; background: #F7FBFF; border-radius: 20rpx; padding: 20rpx 24rpx;
  border-left: 6rpx solid #59A8FF;
}
.lrow { display: flex; align-items: center; gap: 12rpx; }
.score { margin-left: auto; color: #59A8FF; font-weight: 800; font-size: 36rpx; }
.lnote {
  margin-top: 12rpx; font-size: 26rpx; color: #5A6B85; line-height: 1.7;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.card .btn.ghost { margin-top: 20rpx; color: #59A8FF; border-color: #A9D6F8; font-weight: 600; }
