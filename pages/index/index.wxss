/* ---------- 顶部欢迎 ---------- */
/* ---------- 自定义导航栏：标题靠左（原生导航标题只能居中） ---------- */
.cnav { padding-left: 34rpx; padding-right: 220rpx; }
.cnav-t {
  font-size: 34rpx; font-weight: 800; color: var(--text);
  line-height: 44px; /* 与右上角胶囊等高，垂直居中对齐 */
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
/* ---------- 演示数据横幅：品牌浅底细条，右侧一个实心小按钮 ---------- */
.demobar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 24rpx 18rpx; padding: 14rpx 16rpx 14rpx 24rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  border-radius: 16rpx;
}
.demobar-t { font-size: 24rpx; font-weight: 700; color: var(--brand); }
.demobar-btn {
  flex: none; font-size: 23rpx; font-weight: 800; color: #fff;
  background: var(--brand); border-radius: 999rpx; padding: 8rpx 24rpx;
}
/* ---------- 订阅成绩通知横幅：与演示横幅同构，家长端专用 ---------- */
.notifybar {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin: 0 24rpx 18rpx; padding: 18rpx 16rpx 18rpx 24rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  border-radius: 16rpx;
}
.notifybar-t { font-size: 27rpx; font-weight: 700; color: var(--text); }
.notifybar-d { font-size: 22rpx; color: var(--faint); margin-top: 4rpx; }
.notifybar-btn {
  flex: none; font-size: 23rpx; font-weight: 800; color: #fff;
  background: var(--brand); border-radius: 999rpx; padding: 10rpx 28rpx;
}
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6rpx 30rpx 28rpx;
}
.hello { font-size: 27rpx; color: var(--sub); font-weight: 600; }
/* 跨机构：一个孩子的记录可能来自两家，必须标清哪条是谁给的 */
.orgtag {
  font-size: 20rpx; font-weight: 600; color: var(--sub);
  background: var(--bg, #f2f2ef); border-radius: 6rpx;
  padding: 2rpx 8rpx; margin-left: 8rpx;
}
.kchip-n {
  font-size: 18rpx; font-weight: 700; color: #fff;
  background: var(--brand); border-radius: 999rpx;
  padding: 0 8rpx; margin-left: 6rpx;
}
/* 多机构：两家以上才出现的小标签，点了换一家 */
.tb-l { min-width: 0; }
.orgchip {
  display: inline-flex; align-items: center; gap: 10rpx;
  max-width: 420rpx; margin-bottom: 8rpx;
  background: var(--brand-soft); border: 2rpx solid var(--brand-border);
  border-radius: 999rpx; padding: 6rpx 8rpx 6rpx 20rpx;
}
.orgchip-n {
  font-size: 23rpx; font-weight: 700; color: var(--brand);
  max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.orgchip-ic {
  flex: none; font-size: 20rpx; font-weight: 700; color: var(--brand);
  background: #fff; border-radius: 999rpx; padding: 4rpx 14rpx;
}
/* 切换弹层 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 90;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sheet-t { font-size: 34rpx; font-weight: 800; color: var(--text); }
.sheet-d { margin-top: 12rpx; font-size: 24rpx; color: var(--muted); line-height: 1.6; }
.orgrow {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 18rpx; padding: 26rpx 24rpx;
  background: var(--bg, #f7f7f5); border-radius: 18rpx;
  border: 2rpx solid transparent;
}
.orgrow.on { border-color: var(--brand-border); background: var(--brand-soft); }
.orgrow-l { min-width: 0; }
.orgrow-n {
  font-size: 30rpx; font-weight: 700; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.orgrow-r { margin-top: 6rpx; font-size: 23rpx; color: var(--muted); }
.orgrow-ck { flex: none; font-size: 22rpx; font-weight: 700; color: var(--brand); }
.sheet-add {
  margin-top: 24rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  font-size: 28rpx; font-weight: 700; color: var(--brand);
  background: var(--brand-soft); border-radius: 16rpx;
}
.sheet-x { margin-top: 16rpx; text-align: center; font-size: 26rpx; color: var(--muted); padding: 12rpx; }
.datechip {
  flex: none; font-size: 24rpx; color: var(--sub); font-weight: 600;
  background: #fff; border-radius: 999rpx; padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
/* ---------- 主操作区：不对称大卡（参考卡牌式首页设计） ---------- */
/* 左：品牌渐变大卡（开始录入）；右上：浅色记录卡；右下：搜索卡；搜索结果悬浮在整个区块下方 */
.herog-wrap { position: relative; z-index: 30; margin: 0 24rpx 32rpx; }
.herog { display: flex; gap: 20rpx; }
.hgc {
  position: relative; overflow: hidden; border-radius: 28rpx;
  padding: 30rpx 28rpx; box-sizing: border-box;
}
/* 左大卡：品牌渐变，文案沉底，右上放白色加号图标 + 半透明圆装饰 */
.hgc.big {
  flex: 1.15; min-height: 264rpx;
  display: flex; flex-direction: column; justify-content: flex-end;
  background: linear-gradient(135deg, var(--brand-a), var(--brand-b));
  box-shadow: 0 12rpx 28rpx var(--brand-shadow);
}
.hgc.big::after {
  content: ""; position: absolute; right: -44rpx; top: -44rpx;
  width: 190rpx; height: 190rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}
.hgc.big .hgc-t { font-size: 38rpx; font-weight: 800; color: #fff; }
.hgc.big .hgc-s { margin-top: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.85); }
.hgc-ico { position: absolute; right: 22rpx; top: 22rpx; width: 64rpx; height: 64rpx; opacity: 0.95; }
/* 右列：两卡等高铺满 */
.hgc-col { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.hgc.a {
  flex: 1; display: flex; flex-direction: column; justify-content: flex-end;
  background: var(--brand-soft-2);   /* 比通用浅底深一档：用户反馈原来太淡、和搜索卡拉不开层次 */
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
.hgc.a .hgc-t { font-size: 30rpx; font-weight: 800; color: var(--brand); }
.hgc.a .hgc-s { margin-top: 6rpx; font-size: 21rpx; color: var(--muted); }
.hgc-ico.sm { width: 46rpx; height: 46rpx; top: 24rpx; right: 24rpx; opacity: 0.5; }
/* 右下：搜索卡（与上面卡片同圆角体系） */
.hgc.searchcell {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
  padding: 0 24rpx; background: #fff; border: 2rpx solid var(--line-2);
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
.scico { width: 32rpx; height: 32rpx; flex: none; }
.scinput { flex: 1; min-width: 0; font-size: 26rpx; }
.ph { color: var(--faint); }
.sclear {
  flex: none; width: 34rpx; height: 34rpx; padding: 5rpx;
}
/* 搜索结果：搜索框正下方悬浮弹层 */
.sresults {
  position: absolute; left: 0; right: 0; top: calc(100% + 12rpx);
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx var(--shadow);
  padding: 10rpx 24rpx; max-height: 560rpx; overflow-y: auto;
}
.sresult {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 4rpx; border-bottom: 2rpx solid var(--line);
}
.sname { font-size: 28rpx; font-weight: 600; color: var(--text-2); flex: none; }
.smeta { flex: 1; font-size: 24rpx; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chev { width: 28rpx; height: 28rpx; flex: none; }
.sresult .chev { width: 28rpx; height: 28rpx; flex: none; }
.sresult:last-child { border-bottom: none; }
.smore { padding: 14rpx 4rpx 18rpx; font-size: 22rpx; color: var(--faint); text-align: center; }
.ava.sm { width: 72rpx; height: 72rpx; font-size: 30rpx; border-radius: 24rpx; }
/* ---------- 统计 ---------- */
.stats { display: flex; gap: 20rpx; margin: 0 24rpx 32rpx; }
.stat {
  flex: 1; background: #fff; border-radius: 24rpx; padding: 26rpx 0 22rpx;
  text-align: center; box-shadow: 0 4rpx 16rpx var(--shadow);
}
.num { font-size: 44rpx; font-weight: 800; line-height: 1.2; }
.num.warn { color: var(--brand); }
.sl { margin-top: 6rpx; font-size: 23rpx; color: var(--muted); }
/* ---------- 区块标题 ---------- */
/* 标题集成进卡片里（用户反馈：浮在卡外不整体） */
.sechead {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4rpx 34rpx 16rpx;
}
.panel .sechead { padding: 6rpx 14rpx 18rpx; }
.card .sechead { padding: 0 0 16rpx; }   /* 标题在普通卡内：用卡片自带 28rpx 边距 */
.panel .empty { padding: 30rpx 20rpx; }   /* 空状态在卡内：收窄留白 */
.empty.slim { padding: 30rpx 20rpx; }     /* 通用：卡内空状态 */
.sectitle { font-size: 30rpx; font-weight: 700; }
.seclink { font-size: 25rpx; color: var(--muted); font-weight: 500; }
/* ---------- 班级 / 成果卡片 ---------- */
.clsitem .sturow, .card .sturow { cursor: pointer; }
.stuinfo { flex: 1; min-width: 0; }
.dot {
  display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--brand); margin-left: 10rpx; vertical-align: middle;
}
.oneline {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
/* ---------- 区块大卡：一个区块一张卡，内部条目为浅底格子（不再各自浮起） ---------- */
.panel { padding: 20rpx; margin-bottom: 32rpx; }
/* ---------- 我的班级：卡内条目（列宽自适应，一两个班时自动铺满不空栏） ---------- */
.clsgrid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(180rpx, 1fr));
  gap: 16rpx;
}
.clstile {
  position: relative; background: var(--bg); border-radius: 16rpx;
  padding: 24rpx 20rpx 20rpx; overflow: hidden;
}
.clstile::before {
  content: ''; position: absolute; left: 20rpx; top: 0;
  width: 48rpx; height: 6rpx; border-radius: 0 0 6rpx 6rpx;
}
.clstile.c0::before { background: #4a7ddc; }
.clstile.c1::before { background: var(--ok); }
.clstile.c2::before { background: var(--brand); }
.ctname {
  font-size: 27rpx; font-weight: 700; color: var(--text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ctmeta { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.ctwarn { margin-top: 6rpx; font-size: 21rpx; color: var(--brand); }
/* ---------- 最近成果：卡内自适应条目（一行最多 5 个，少则拉伸） ---------- */
.recgrid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(120rpx, 1fr));
  gap: 14rpx;
}
.rectile {
  background: var(--bg); border-radius: 14rpx; padding: 20rpx 10rpx 18rpx;
  text-align: center; min-width: 0;
}
.rtname {
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rtmeta {
  margin-top: 6rpx; font-size: 19rpx; color: var(--muted); padding: 0 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ---------- 家长端首页：孩子主页 ---------- */
/* 孩子切换（多孩家庭） */
.kidchips { display: flex; gap: 14rpx; margin: 0 24rpx 18rpx; flex-wrap: wrap; }
.kchip {
  font-size: 26rpx; padding: 12rpx 30rpx; border-radius: 999rpx;
  background: #fff; color: var(--text-2); box-shadow: 0 2rpx 8rpx var(--shadow);
}
.kchip.on { background: var(--brand); color: #fff; font-weight: 700; }

/* 孩子卡 */
.pstu { display: flex; align-items: center; gap: 20rpx; }
.pav { width: 96rpx; height: 96rpx; border-radius: 30rpx; font-size: 38rpx; font-weight: 700;
  background: linear-gradient(135deg, var(--brand-a), var(--brand)); color: #fff;
  display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.pav image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pav text { position: relative; }
.stuinfo { flex: 1; min-width: 0; }

/* 统计徽标：节课绿 / 优秀橙 / 学习日蓝（与学生主页同口径） */
.pstats { display: flex; gap: 14rpx; margin-top: 22rpx; }
.pstat { font-size: 23rpx; font-weight: 600; padding: 8rpx 20rpx; border-radius: 999rpx; }
.ps-c { color: var(--ok); background: var(--ok-soft); }
.ps-g { color: var(--brand); background: var(--brand-soft); }
.ps-d { color: var(--info); background: var(--info-soft); }
.caretip {
  margin-top: 18rpx; padding: 14rpx 20rpx; border-radius: 14rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  font-size: 23rpx; color: var(--sub);
}

/* 最近一次详情 */
.dimhead { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.pill-o { background: var(--brand); }
.lcourse { font-size: 32rpx; font-weight: 700; }
.dhr { margin-left: auto; display: flex; align-items: center; gap: 12rpx; }
.morelink { margin-top: 12rpx; color: var(--faint); }
.notegroups { background: var(--bg); border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; }
.kline { display: flex; align-items: flex-start; line-height: 1.7; font-size: 25rpx; }
.klabel { color: var(--faint); flex: none; }
.ktext { color: var(--text-2); font-weight: 500; flex: 1; min-width: 0; }
.photostrip { display: flex; gap: 12rpx; margin-top: 16rpx; }
.photostrip image { flex: 1; height: 180rpx; border-radius: 12rpx; background: var(--chip); min-width: 0; }

/* 评价徽标：优秀绿 / 良好橙 / 加油蓝灰 */
.badge { font-size: 22rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx; flex: none; }
.badge.good { color: var(--ok); background: var(--ok-soft); }
.badge.mid { color: var(--brand); background: var(--brand-soft); }
.badge.low { color: var(--info); background: var(--info-soft); }
.badge.sm { font-size: 20rpx; padding: 4rpx 14rpx; }

/* 需要注意 / 历史列表行 */
.histr { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--chip); }
.histr:last-child { border-bottom: none; }
.hmain { flex: 1; min-width: 0; }
.ht1 { display: flex; align-items: center; gap: 12rpx; }
.ht1 b { font-size: 29rpx; }
.hcam { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--muted); flex: none; }
.camico { width: 28rpx; height: 28rpx; }
.ps-b { color: var(--brand); background: var(--brand-soft); }

/* ---------- 空库开通卡（首次进入的引导） ---------- */
.onboard { margin-top: 8rpx; }
.obtitle { font-size: 36rpx; font-weight: 700; color: var(--text); line-height: 1.4; }
.obsub { font-size: 25rpx; color: var(--sub); line-height: 1.7; margin: 12rpx 0 26rpx; }
.obsteps { display: flex; gap: 12rpx; margin-bottom: 30rpx; }
.obstep {
  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  font-size: 22rpx; color: var(--sub); background: var(--bg);
  border: 2rpx solid var(--line); border-radius: 18rpx; padding: 18rpx 6rpx;
}
.obn {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 999rpx;
  font-size: 24rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, var(--brand-a), var(--brand-b));
}
.obdemo { text-align: center; font-size: 25rpx; color: var(--muted); margin-top: 26rpx; }

/* ---------- 家长反馈入口 ---------- */
.fbcall { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 28rpx; }
.fbcall-txt { flex: 1; min-width: 0; }
.fbcall-t { font-size: 29rpx; font-weight: 700; margin-bottom: 4rpx; }
.fbnum {
  flex: none; min-width: 36rpx; height: 36rpx; padding: 0 10rpx; box-sizing: border-box;
  border-radius: 999rpx; background: var(--danger); color: #fff;
  font-size: 22rpx; font-weight: 700; line-height: 36rpx; text-align: center;
}
.fic { width: 26rpx; height: 26rpx; }
