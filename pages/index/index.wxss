/* ---------- 顶部欢迎 ---------- */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 36rpx 30rpx 24rpx;
}
.hello { font-size: 27rpx; color: var(--sub); font-weight: 600; }
.datechip {
  flex: none; font-size: 24rpx; color: var(--sub); font-weight: 600;
  background: #fff; border-radius: 999rpx; padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 12rpx var(--shadow);
}
/* ---------- 主操作卡 ---------- */
.hero2 { display: flex; gap: 20rpx; }
.hero-btn {
  flex: 1; border-radius: 22rpx; padding: 28rpx 26rpx; background: var(--line);
  transition: all 0.15s;
}
.hero-btn.primary { background: var(--brand-soft); }
.ht { font-size: 32rpx; font-weight: 800; color: var(--text); }
.hero-btn.primary .ht { color: var(--brand); }
.hs { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
/* ---------- 搜索 ---------- */
.searchwrap { position: relative; z-index: 30; margin-top: 20rpx; }
.searchrow {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 16rpx 26rpx;
}
.sicon { width: 30rpx; height: 30rpx; }
.sinput { flex: 1; font-size: 27rpx; }
.ph { color: var(--faint); }
.sclear {
  flex: none; width: 34rpx; height: 34rpx; padding: 5rpx;
}
/* 搜索结果：搜索框正下方悬浮弹层 */
.sresults {
  position: absolute; left: 0; right: 0; top: calc(100% + 12rpx);
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx var(--shadow);
  padding: 10rpx 24rpx; max-height: 560rpx; overflow-y: auto;
}
.sresult {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 4rpx; border-bottom: 2rpx solid var(--line);
}
.sname { font-size: 28rpx; font-weight: 600; color: var(--text-2); flex: none; }
.smeta { flex: 1; font-size: 24rpx; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chev { width: 28rpx; height: 28rpx; flex: none; }
.sresult .chev { width: 28rpx; height: 28rpx; flex: none; }
.sresult:last-child { border-bottom: none; }
.smore { padding: 14rpx 4rpx 18rpx; font-size: 22rpx; color: var(--faint); text-align: center; }
.ava.sm { width: 72rpx; height: 72rpx; font-size: 30rpx; border-radius: 24rpx; }
/* ---------- 统计 ---------- */
.stats { display: flex; gap: 20rpx; margin: 0 24rpx 24rpx; }
.stat {
  flex: 1; background: #fff; border-radius: 24rpx; padding: 26rpx 0 22rpx;
  text-align: center; box-shadow: 0 4rpx 16rpx var(--shadow);
}
.num { font-size: 44rpx; font-weight: 800; line-height: 1.2; }
.num.warn { color: var(--brand); }
.sl { margin-top: 6rpx; font-size: 23rpx; color: var(--muted); }
/* ---------- 区块标题 ---------- */
.sechead {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10rpx 34rpx 18rpx;
}
.sectitle { font-size: 30rpx; font-weight: 700; }
.seclink { font-size: 25rpx; color: var(--muted); font-weight: 500; }
/* ---------- 班级 / 成果卡片 ---------- */
.clsitem .sturow, .card .sturow { cursor: pointer; }
.stuinfo { flex: 1; min-width: 0; }
.dot {
  display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--brand); margin-left: 10rpx; vertical-align: middle;
}
.oneline {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
/* ---------- 我的班级：三列磁贴 ---------- */
.clsgrid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
  padding: 0 24rpx 24rpx;
}
.clstile {
  position: relative; background: #fff; border-radius: 20rpx;
  padding: 24rpx 20rpx 20rpx; overflow: hidden;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
.clstile::before {
  content: ''; position: absolute; left: 20rpx; top: 0;
  width: 48rpx; height: 6rpx; border-radius: 0 0 6rpx 6rpx;
}
.clstile.c0::before { background: #4a7ddc; }
.clstile.c1::before { background: var(--ok); }
.clstile.c2::before { background: var(--brand); }
.ctname {
  font-size: 27rpx; font-weight: 700; color: var(--text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ctmeta { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.ctwarn { margin-top: 6rpx; font-size: 21rpx; color: var(--brand); }
/* ---------- 最近成果：自适应磁贴（最多一行 5 个，少则拉伸） ---------- */
.recgrid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(132rpx, 1fr));
  gap: 14rpx; padding: 0 24rpx 24rpx;
}
.rectile {
  background: #fff; border-radius: 18rpx; padding: 20rpx 10rpx 18rpx;
  text-align: center; min-width: 0;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
.rtname {
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rtmeta {
  margin-top: 6rpx; font-size: 19rpx; color: var(--muted); padding: 0 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ---------- 家长端首页：孩子主页 ---------- */
/* 孩子切换（多孩家庭） */
.kidchips { display: flex; gap: 14rpx; margin: 0 24rpx 18rpx; flex-wrap: wrap; }
.kchip {
  font-size: 26rpx; padding: 12rpx 30rpx; border-radius: 999rpx;
  background: #fff; color: var(--text-2); box-shadow: 0 2rpx 8rpx var(--shadow);
}
.kchip.on { background: var(--brand); color: #fff; font-weight: 700; }

/* 孩子卡 */
.pstu { display: flex; align-items: center; gap: 20rpx; }
.pav { width: 96rpx; height: 96rpx; border-radius: 30rpx; font-size: 38rpx; font-weight: 700;
  background: linear-gradient(135deg, var(--brand-a), var(--brand)); color: #fff;
  display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.pav image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pav text { position: relative; }
.stuinfo { flex: 1; min-width: 0; }

/* 统计徽标：节课绿 / 优秀橙 / 学习日蓝（与学生主页同口径） */
.pstats { display: flex; gap: 14rpx; margin-top: 22rpx; }
.pstat { font-size: 23rpx; font-weight: 600; padding: 8rpx 20rpx; border-radius: 999rpx; }
.ps-c { color: var(--ok); background: var(--ok-soft); }
.ps-g { color: var(--brand); background: var(--brand-soft); }
.ps-d { color: var(--info); background: var(--info-soft); }
.caretip {
  margin-top: 18rpx; padding: 14rpx 20rpx; border-radius: 14rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  font-size: 23rpx; color: var(--sub);
}

/* 最近一次详情 */
.dimhead { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.pill-o { background: var(--brand); }
.lcourse { font-size: 32rpx; font-weight: 700; }
.dhr { margin-left: auto; display: flex; align-items: center; gap: 12rpx; }
.morelink { margin-top: 12rpx; color: var(--faint); }
.notegroups { background: var(--bg); border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; }
.kline { display: flex; align-items: flex-start; line-height: 1.7; font-size: 25rpx; }
.klabel { color: var(--faint); flex: none; }
.ktext { color: var(--text-2); font-weight: 500; flex: 1; min-width: 0; }
.photostrip { display: flex; gap: 12rpx; margin-top: 16rpx; }
.photostrip image { flex: 1; height: 180rpx; border-radius: 12rpx; background: var(--chip); min-width: 0; }

/* 评价徽标：优秀绿 / 良好橙 / 加油蓝灰 */
.badge { font-size: 22rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx; flex: none; }
.badge.good { color: var(--ok); background: var(--ok-soft); }
.badge.mid { color: var(--brand); background: var(--brand-soft); }
.badge.low { color: var(--info); background: var(--info-soft); }
.badge.sm { font-size: 20rpx; padding: 4rpx 14rpx; }

/* 需要注意 / 历史列表行 */
.histr { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--chip); }
.histr:last-child { border-bottom: none; }
.hmain { flex: 1; min-width: 0; }
.ht1 { display: flex; align-items: center; gap: 12rpx; }
.ht1 b { font-size: 29rpx; }
.hcam { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--muted); flex: none; }
.camico { width: 28rpx; height: 28rpx; }
.ps-b { color: var(--brand); background: var(--brand-soft); }
