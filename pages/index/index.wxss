.clsbar { background: #fff; padding: 20rpx 0; white-space: nowrap; }
.clsrow { display: inline-flex; gap: 16rpx; padding: 0 24rpx; }
.sturow { display: flex; align-items: center; gap: 20rpx; }
.stuinfo { flex: 1; }
.chev { color: #c9c4bd; font-size: 36rpx; }
.latest { margin-top: 16rpx; background: #faf9f7; border-radius: 16rpx; padding: 16rpx 20rpx; }
.lrow { display: flex; align-items: center; gap: 12rpx; }
.score { margin-left: auto; color: #e8590c; font-weight: 800; font-size: 32rpx; }
.lnote { margin-top: 8rpx; font-size: 26rpx; color: #6b655e; }
.empty { text-align: center; color: #9c948a; padding: 120rpx 0; font-size: 27rpx; }
