<view class="theme-root {{themeCls}}">
<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab===index?'on':''}}" bindtap="pickTab" data-i="{{index}}">{{item}}</view>
</view>

<!-- 身份条：预览他人身份时可一键切回 -->
<view wx:if="{{canSwitchHome}}" class="idbar">
  <text>正在以「{{meName}} · {{myRoleLabel}}」身份预览</text>
  <text class="idback" bindtap="backHome">切回我自己</text>
</view>

<!-- ============ 班级 ============ -->
<view wx:if="{{tab===0}}" class="wrap clswrap">
  <view class="card clsitem" wx:for="{{classes}}" wx:key="id">
    <view class="clsrow">
      <view class="clshd" bindtap="onClsTap" data-id="{{item.id}}">
        <view class="itrow"><view class="clsbar"></view>
          <view><b>{{item.name}}</b>
          <view class="mi">{{item.termName || '未挂学期'}} · {{item.modeLabel}}<text wx:if="{{item.teacherLabel}}"> · 主讲 {{item.teacherLabel}}</text> · {{item.stuN}} 人</view></view>
        </view>
      </view>
      <view class="clscaret {{clsExpand===item.id?'up':''}}">▾</view>
      <view class="mi del" catchtap="delClass" data-id="{{item.id}}">删除</view>
    </view>
    <!-- 展开：本班学生筛选 + 名单 -->
    <view wx:if="{{clsExpand===item.id}}" class="clsexp">
      <view class="vin">
        <input class="clsexp-input vin-in" placeholder="筛选本班学生（姓名 / 家长）" placeholder-class="ph" value="{{clsStuQ}}" bindinput="onClsStuQ" />
        <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="clsStuQ" />
      </view>
      <view class="clsmem" wx:for="{{clsStus}}" wx:for-item="s" wx:key="id" bindtap="goStudentPage" data-id="{{s.id}}">
        <ava src="{{s.photo}}" name="{{s.name}}" size="{{64}}" radius="{{18}}" />
        <view class="memname">{{s.name}}</view>
        <view class="mi" style="flex:1;text-align:right">{{s.parent ? '家长 '+s.parent : '未填家长'}}</view>
        <image class="memchev" src="{{icoChev}}" mode="aspectFit" />
      </view>
      <view wx:if="{{!clsStus.length}}" class="mi" style="padding:16rpx 4rpx">{{clsStuQ ? '没有符合筛选的学生' : '这个班还没有学生'}}</view>
      <view class="clsexp-add" hover-class="btn-hover" catchtap="addClsStudent" data-id="{{item.id}}">＋ 添加学生到本班</view>
    </view>
  </view>
</view>
<!-- 添加班级：固定钉在页面底部，点开弹层填表单 -->
<view wx:if="{{tab===0}}" class="clsfab">
  <view class="btn" hover-class="btn-hover" bindtap="openClsForm">＋ 添加班级</view>
</view>

<!-- ============ 课程 ============ -->
<view wx:if="{{tab===1}}" class="wrap">
  <view class="card">
    <view class="sec"><view class="label">添加课程</view></view>
    <picker mode="selector" range="{{classes}}" range-key="name" value="{{courseClsIdx}}" bindchange="onCourseCls">
      <view class="pickerbox">所属班级：{{classes[courseClsIdx].name || '请先添加班级'}} ▾</view>
    </picker>
    <view class="addrow">
      <view class="vin" style="flex:1;min-width:0">
        <input class="input vin-in" style="margin-bottom:0" placeholder="课程名称" value="{{newCourse}}" bindinput="onNewCourse" />
        <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="newCourse" />
      </view>
      <view class="btn addbtn" hover-class="btn-hover" bindtap="addCourse">添加</view>
    </view>
  </view>
  <view class="card item" wx:for="{{courses}}" wx:key="id">
    <view><b>{{item.name}}</b><view class="mi">归属：{{item.cls}}</view></view>
    <view class="mi del" catchtap="delCourse" data-id="{{item.id}}">删除</view>
  </view>
</view>

<!-- ============ 学生 ============ -->
<view wx:if="{{tab===2}}" class="wrap stuwrap">
  <!-- 筛选区：吸顶钉住，列表从其下方滚过；整块收进白色卡片（与页签、列表卡片同一套视觉）。
       行内顺序：入学 → 男/女 → 搜索（含麦克风） -->
  <view class="stufilter">
    <view class="sfcard">
      <view class="sfrow2">
        <picker mode="selector" range="{{stuYears}}" range-key="name" value="{{stuYearIdx}}" bindchange="onStuYear">
          <view class="pkbox">入学：{{stuYears[stuYearIdx].name || '全部'}} ▾</view>
        </picker>
        <view class="gswitch">
          <view class="gopt {{stuGender==='男'?'on':''}}" bindtap="onStuGender" data-v="男">男</view>
          <view class="gopt {{stuGender==='女'?'on':''}}" bindtap="onStuGender" data-v="女">女</view>
        </view>
        <view class="vin sfsearch">
          <input class="sfin vin-in" placeholder="搜索姓名 / 学号 / 家长" value="{{stuQ}}" bindinput="onStuQ" confirm-type="search" />
          <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuQ" />
        </view>
      </view>
      <view class="sfcount">共 {{stuCount}} 人，当前显示 {{students.length}} 人</view>
    </view>
  </view>
  <view class="card item" wx:for="{{students}}" wx:key="id">
    <view style="flex:1;min-width:0" bindtap="goStudentPage" data-id="{{item.id}}">
      <view class="itrow">
        <ava src="{{item.photo}}" name="{{item.name}}" size="{{64}}" radius="{{18}}" />
        <view style="min-width:0"><b>{{item.name}}</b><text wx:if="{{item.gender}}" class="gtag">{{item.gender}}</text>
        <view class="mi"><text wx:if="{{item.no}}" class="sno">学号 {{item.no}}</text>{{item.cls}}{{item.year?' · '+item.year+' 年入学':''}}{{item.parent?' · 家长 '+item.parent:''}}{{item.wechat?' · 微信 '+item.wechat:''}}</view></view>
      </view>
    </view>
    <view class="stuacts">
      <view class="mi act" catchtap="editStudent" data-id="{{item.id}}">编辑</view>
      <view class="mi del" catchtap="delStudent" data-id="{{item.id}}">删除</view>
    </view>
  </view>
  <view wx:if="{{!students.length}}" class="card empty">没有符合条件的学生，试试放宽筛选</view>
</view>
<!-- 学生操作：批量导入 + 添加学生，固定钉在页面底部 -->
<view wx:if="{{tab===2}}" class="stufab">
  <view class="stufab2">
    <view class="btn ghost" hover-class="btn-hover" bindtap="goImport">批量导入</view>
    <view class="btn" hover-class="btn-hover" bindtap="addStudent">＋ 添加学生</view>
  </view>
</view>

<!-- ============ 成员管理（负责人/管理员可见） ============ -->
<view wx:if="{{tab===3 && isManager}}" class="wrap">
  <view class="card">
    <view class="sec"><view class="label">机构名称</view></view>
    <view class="addrow">
      <view class="vin" style="flex:1;min-width:0">
        <input class="input vin-in" style="margin-bottom:0" placeholder="机构名称" value="{{orgName}}" bindinput="onOrgName" />
        <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="orgName" />
      </view>
      <view class="btn addbtn" hover-class="btn-hover" bindtap="saveOrg">保存</view>
    </view>
    <view class="mi" style="margin-top:12rpx">当前身份：{{myRoleLabel}}。同一机构内的数据互相隔离，不同机构之间完全不可见。</view>
  </view>

  <view class="card">
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="addUserTeacher">＋ 加老师</view>
      <view class="btn ghost" hover-class="btn-hover" bindtap="addUserParent">＋ 加家长</view>
    </view>
    <view class="mi">老师只能看到并录入自己负责班级的成果；家长只能看自己孩子「已发布」的成果；管理员与负责人可见全机构。点成员卡片底部可切换身份预览效果。</view>
  </view>

  <view class="card item" wx:for="{{members}}" wx:key="id">
    <view bindtap="goTeacher" data-id="{{item.id}}">
      <view class="itrow">
        <ava src="{{item.photo}}" name="{{item.name}}" size="{{76}}" radius="{{24}}" tone="{{item.avaTone}}" />
        <view><b>{{item.name}}</b>
          <view class="mi">{{item.roleLabel}} · {{item.meta}}<text wx:if="{{item.invited}}" class="mi"> · 待绑定</text></view>
        </view>
      </view>
    </view>
    <view style="display:flex;align-items:center">
      <text wx:if="{{item.cur}}" class="pill" style="background:var(--sent)">当前</text>
      <view class="mi act" catchtap="switchMe" data-id="{{item.id}}">切换</view>
      <view class="mi act" catchtap="editUser" data-id="{{item.id}}">分配</view>
      <view wx:if="{{item.role!=='owner'}}" class="mi del" catchtap="delUser" data-id="{{item.id}}">移除</view>
    </view>
  </view>
</view>

<!-- ============ 学生表单弹层 ============ -->
<view wx:if="{{stuForm}}" class="mask" bindtap="stuCancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">{{stuForm.id?'编辑学生':'添加学生'}}</view>
    <view class="avrow" bindtap="onStuPhoto">
      <view class="ava big">
        <image wx:if="{{stuForm.photo}}" src="{{stuForm.photo}}" mode="aspectFill" />
        <text wx:else class="bigchar">{{stuForm.char}}</text>
        <image src="{{icoCameraW}}" class="cam" mode="aspectFit" />
      </view>
      <text class="mi">{{stuForm.photo?'点击更换照片':'上传学生照片（选填）'}}</text>
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="学生姓名" value="{{stuForm.name}}" bindinput="onStuName" />
      <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.name" />
    </view>
    <!-- 学号由系统分配：新建时保存后生成，编辑时只读展示（家长凭它绑定孩子） -->
    <view class="stuno" bindtap="copyStuNo">
      <text wx:if="{{stuForm.id && stuForm.no}}">学号 {{stuForm.no}} · 点按复制</text>
      <text wx:else>学号保存后自动生成，家长可用它绑定孩子</text>
    </view>
    <view class="label">性别</view>
    <view class="gswitch" style="margin-bottom:20rpx">
      <view class="gopt {{stuForm.gender==='男'?'on':''}}" bindtap="onStuGenderSet" data-v="男">男</view>
      <view class="gopt {{stuForm.gender==='女'?'on':''}}" bindtap="onStuGenderSet" data-v="女">女</view>
    </view>
    <view class="label">入学年份</view>
    <view class="clsfrow" style="margin-bottom:20rpx">
      <picker mode="selector" range="{{enrollYearOpts}}" range-key="name" value="{{stuEnrollYearIdx}}" bindchange="onStuEnrollYear">
        <view class="pickerbox">入学年份：{{enrollYearOpts[stuEnrollYearIdx].name}} ▾</view>
      </picker>
    </view>
    <view class="label">加入班级（可多选）</view>
    <view class="chips" style="margin-bottom:20rpx">
      <view wx:for="{{stuClsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="stuClsTgl" data-id="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="label">家长联系方式</view>
    <view class="vin">
      <input class="input vin-in" placeholder="家长称呼（如：张珊珊/妈妈）" value="{{stuForm.parent}}" bindinput="onStuParent" />
      <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.parent" />
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="家长微信号（方便沟通）" value="{{stuForm.wechat}}" bindinput="onStuWechat" />
      <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.wechat" />
    </view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="stuCancel">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="stuSave">保存</view>
    </view>
  </view>
</view>

<!-- ============ 成员表单弹层 ============ -->
<view wx:if="{{userForm}}" class="mask" bindtap="userCancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">{{userForm.id ? '编辑成员' : '新增成员'}}</view>
    <!-- 头像：点块上传照片；或一键同步微信头像（头像填写能力） -->
    <view class="avrow">
      <view class="ava big" bindtap="onUserPhoto">
        <image wx:if="{{userForm.photo}}" src="{{userForm.photo}}" mode="aspectFill" />
        <text wx:else class="bigchar">{{userForm.char}}</text>
        <image src="{{icoCameraW}}" class="cam" mode="aspectFit" />
      </view>
      <view class="avcol">
        <text class="mi">{{userForm.photo ? '点击头像更换照片' : '点击头像上传照片（选填）'}}</text>
        <button class="wxava" open-type="chooseAvatar" bindchooseavatar="onWxAvatar" hover-class="btn-hover">用微信头像</button>
      </view>
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="姓名" value="{{userForm.name}}" bindinput="onUserName" />
      <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="userForm.name" />
    </view>
    <view class="vin">
      <input class="input vin-in" type="number" placeholder="手机号（选填，可拨号）" value="{{userForm.phone}}" bindinput="onUserPhone" maxlength="13" />
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="微信号（选填，可复制）" value="{{userForm.wechat}}" bindinput="onUserWechat" />
    </view>

    <view class="label">角色</view>
    <view class="chips" style="margin-bottom:16rpx">
      <view wx:for="{{roleOpts}}" wx:key="k" class="chip {{userForm.role===item.k?'on':''}}" bindtap="pickRole" data-k="{{item.k}}">{{item.n}}</view>
    </view>
    <view class="mi" style="margin-bottom:20rpx">
      <block wx:for="{{roleOpts}}" wx:key="k"><text wx:if="{{userForm.role===item.k}}">{{item.d}}</text></block>
    </view>

    <block wx:if="{{userForm.role==='teacher'}}">
      <view class="label">负责班级（可多选，至少一个）</view>
      <view class="chips" style="margin-bottom:16rpx">
        <view wx:for="{{userClsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userClsTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
      <view class="label">课程权限（不选 = 所带班级全部课程）</view>
      <view class="chips" style="margin-bottom:20rpx">
        <view wx:for="{{userCrsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userCrsTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </block>
    <block wx:elif="{{userForm.role==='parent'}}">
      <view class="label">按学号绑定</view>
      <view class="bindrow">
        <input class="input bindin" type="number" placeholder="输入学生学号，如 1001" value="{{userBindNo}}" bindinput="onBindNo" confirm-type="done" bindconfirm="bindByNo" />
        <view class="btn ghost bindbtn" hover-class="btn-hover" bindtap="bindByNo">添加</view>
      </view>
      <view class="mi" style="margin:-8rpx 0 16rpx">同一个家长号码下的孩子会自动带出，不用一个个选。</view>
      <view class="label">关联孩子（可多选，至少一个）</view>
      <view class="chips" style="margin-bottom:20rpx">
        <view wx:for="{{userStuChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userStuTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="mi" style="margin-bottom:20rpx">管理员可见并管理全机构的班级、学生、成员与模板，无需单独分配范围。</view>
    </block>

    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="userCancel">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="userSave">保存</view>
    </view>
  </view>
</view>

<!-- ============ 添加班级弹层 ============ -->
<view wx:if="{{clsFormOpen}}" class="mask" bindtap="closeClsForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">添加班级</view>
    <view class="vin">
      <input class="input vin-in" placeholder="班级名称" value="{{newCls}}" bindinput="onNewCls" />
      <image class="vmic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="newCls" />
    </view>
    <view class="clsfrow">
      <picker mode="selector" range="{{clsTerms}}" range-key="name" value="{{clsTermIdx}}" bindchange="onClsTerm">
        <view class="pickerbox">学期：{{clsTerms[clsTermIdx].name || '请选择'}} ▾</view>
      </picker>
    </view>
    <view class="clsfrow">
      <view class="chip {{clsMode === 'term' ? 'on' : ''}}" bindtap="onClsMode" data-v="term">学期制</view>
      <view class="chip {{clsMode === 'carry' ? 'on' : ''}}" bindtap="onClsMode" data-v="carry">课时结转</view>
    </view>
    <view class="clsfrow" wx:if="{{clsMode === 'term'}}">
      <view class="hint2 note">学期制班：按学期上课与统计，学期结束后默认随学期归档（如需延续到下期，可在「学期管理」里整班结转）。</view>
    </view>
    <view class="clsfrow" wx:if="{{clsMode === 'carry'}}">
      <view class="hint2 note">课时结转班：录一节消一课时，学期结束可整班结转到下期（在「学期管理」里操作）。</view>
    </view>
    <view class="clsfrow" style="margin-bottom:8rpx">
      <picker mode="selector" range="{{clsTeachers}}" range-key="name" value="{{clsTeacherIdx}}" bindchange="onClsTeacher">
        <view class="pickerbox">主讲老师：{{clsTeachers[clsTeacherIdx].name || '暂不指派'}} ▾</view>
      </picker>
    </view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="closeClsForm">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="addClass">添加</view>
    </view>
  </view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup id="privacy" />
</view>
