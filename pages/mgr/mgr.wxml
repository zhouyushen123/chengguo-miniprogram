<view class="theme-root {{themeCls}}">
<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab===index?'on':''}}" bindtap="pickTab" data-i="{{index}}">{{item}}</view>
</view>

<!-- 身份条：预览他人身份时可一键切回 -->
<view wx:if="{{canSwitchHome}}" class="idbar">
  <text>正在以「{{meName}} · {{myRoleLabel}}」身份预览</text>
  <text class="idback" bindtap="backHome">切回我自己</text>
</view>

<!-- ============ 机构（负责人/管理员可见，页签在最前） ============ -->
<view wx:if="{{tabK==='org'}}" class="wrap">
  <view class="card">
    <view class="sec"><view class="label">机构名称<text class="req">*</text></view></view>
    <view class="vin">
      <input class="input vin-in" placeholder="如：橙果书法学堂" placeholder-class="ph" value="{{orgForm.name}}" bindinput="onOrgName" maxlength="30" />
      <image class="vmic {{micKey==='orgForm.name'?'rec':''}}" src="{{micKey==='orgForm.name'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="orgForm.name" />
    </view>

    <view class="sec"><view class="label">机构类型</view></view>
    <view class="chips">
      <view wx:for="{{orgTypes}}" wx:key="*this" class="chip {{orgForm.type===item?'on':''}}" bindtap="pickOrgType" data-v="{{item}}">{{item}}</view>
    </view>

    <view class="sec"><view class="label">所在地区</view></view>
    <picker mode="region" value="{{orgForm.region}}" bindchange="onOrgRegion">
      <view class="pickerbox"><text class="{{orgForm.regionText?'':'ph'}}">{{orgForm.regionText || '选择省 / 市 / 区'}}</text><text class="pkar">▾</text></view>
    </picker>

    <view class="sec"><view class="label">联系人</view></view>
    <view class="vin">
      <input class="input vin-in" placeholder="机构负责人姓名" placeholder-class="ph" value="{{orgForm.contact}}" bindinput="onOrgContact" maxlength="20" />
      <image class="vmic {{micKey==='orgForm.contact'?'rec':''}}" src="{{micKey==='orgForm.contact'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="orgForm.contact" />
    </view>

    <view class="sec"><view class="label">手机号</view></view>
    <input class="input" type="number" placeholder="接收开通通知的手机号" placeholder-class="ph" value="{{orgForm.phone}}" bindinput="onOrgPhone" bindblur="onOrgPhoneBlur" />
    <view wx:if="{{orgPhoneBad}}" class="field-err">手机号格式不对，请检查一下</view>

    <view class="sec"><view class="label">学员规模</view></view>
    <view class="chips">
      <view wx:for="{{orgScales}}" wx:key="*this" class="chip {{orgForm.scale===item?'on':''}}" bindtap="pickOrgScale" data-v="{{item}}">{{item}}</view>
    </view>

    <view class="sec"><view class="label">课程方向（可多选）</view></view>
    <view class="chips">
      <view wx:for="{{orgCourseChips}}" wx:key="name" class="chip {{item.on?'on':''}}" bindtap="toggleOrgCourse" data-v="{{item.name}}">{{item.name}}</view>
    </view>

    <view class="mi" style="margin-top:16rpx">这些信息来自开通引导里填的资料，改完点下面按钮保存；机构名称会同步到首页与记录页的展示。</view>
  </view>

  <view class="btn orgsave pagepad" hover-class="btn-hover" bindtap="saveOrgFull">保存机构资料</view>
</view>

<!-- ============ 班级 ============ -->
<view wx:if="{{tabK==='cls'}}" class="wrap clswrap">
  <view wx:if="{{!classes.length}}" class="card empty slim">还没有班级，点下面「添加班级」建一个</view>
  <view class="card clsitem" wx:for="{{classes}}" wx:key="id">
    <view class="clsrow">
      <view class="clshd" bindtap="onClsTap" data-id="{{item.id}}">
        <view class="itrow"><view class="clsbar"></view>
          <view><b>{{item.name}}</b>
          <view class="mi">{{item.termName || '未挂学期'}} · {{item.modeLabel}}<text wx:if="{{item.teacherLabel}}"> · 主讲 {{item.teacherLabel}}</text> · {{item.stuN}} 人</view></view>
        </view>
      </view>
      <view class="clscaret {{clsExpand===item.id?'up':''}}">▾</view>
      <view class="mi del" catchtap="delClass" data-id="{{item.id}}">删除</view>
    </view>
    <!-- 展开：本班学生筛选 + 名单 -->
    <view wx:if="{{clsExpand===item.id}}" class="clsexp">
      <view class="vin">
        <input class="clsexp-input vin-in" placeholder="筛选本班学生（姓名 / 家长）" placeholder-class="ph" value="{{clsStuQ}}" bindinput="onClsStuQ" />
        <image class="vmic {{micKey==='clsStuQ'?'rec':''}}" src="{{micKey==='clsStuQ'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="clsStuQ" />
      </view>
      <view class="clsmem" wx:for="{{clsStus}}" wx:for-item="s" wx:key="id" bindtap="goStudentPage" data-id="{{s.id}}">
        <ava src="{{s.photo}}" name="{{s.name}}" size="{{64}}" radius="{{18}}" />
        <view class="memname">{{s.name}}</view>
        <view class="mi" style="flex:1;text-align:right">{{s.parent ? '家长 '+s.parent : '未填家长'}}</view>
        <image class="memchev" src="{{icoChev}}" mode="aspectFit" />
      </view>
      <view wx:if="{{!clsStus.length}}" class="mi" style="padding:16rpx 4rpx">{{clsStuQ ? '没有符合筛选的学生' : '这个班还没有学生'}}</view>
      <view class="clsexp-add" hover-class="btn-hover" catchtap="addClsStudent" data-id="{{item.id}}">＋ 添加学生到本班</view>
    </view>
  </view>
</view>
<!-- 添加班级：固定钉在页面底部，点开弹层填表单 -->
<view wx:if="{{tabK==='cls'}}" class="clsfab">
  <view class="btn" hover-class="btn-hover" bindtap="openClsForm">＋ 添加班级</view>
</view>

<!-- ============ 课程：中间列表，添加表单收进底部按钮（与班级/学生一致） ============ -->
<view wx:if="{{tabK==='course'}}" class="wrap">
  <view wx:if="{{courseFormOpen}}" class="card">
    <view class="sec"><view class="label">添加课程</view></view>
    <view class="sec"><view class="label">课程名称</view></view>
    <view class="addrow">
      <view class="vin" style="flex:1;min-width:0">
        <input class="input vin-in" style="margin-bottom:0" placeholder="如：语文 / 软笔书法" value="{{newCourse}}" bindinput="onNewCourse" maxlength="20" />
        <image class="vmic {{micKey==='newCourse'?'rec':''}}" src="{{micKey==='newCourse'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="newCourse" />
      </view>
    </view>
    <view class="sec"><view class="label">课程介绍（选填，可语音）</view></view>
    <view class="vin">
      <textarea class="crstext vin-in" placeholder="这门课学什么、适合谁、怎么上…" placeholder-class="ph" value="{{newIntro}}" bindinput="onNewIntro" maxlength="500" auto-height />
      <image class="vmic {{micKey==='newIntro'?'rec':''}}" src="{{micKey==='newIntro'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="newIntro" />
    </view>
    <view class="sec"><view class="label">开设到（可多选，不选 = 先进课程库）</view></view>
    <view class="chips">
      <view wx:for="{{courseClsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" hover-class="btn-hover" bindtap="toggleCourseCls" data-id="{{item.id}}">{{item.name}}</view>
      <text wx:if="{{!classes.length}}" class="mi">还没有班级，可以先建课程，之后随时开到班</text>
    </view>
    <view class="btn" style="margin-top:28rpx" hover-class="btn-hover" bindtap="addCourse">添加课程</view>
  </view>
  <!-- 同名课程提示：早期"一个班建一条课"，解耦后同名即同一门课，这里给一次收拢的机会 -->
  <view wx:if="{{crsDupGroups}}" class="card dupcard">
    <view class="duptxt">课程库里有 {{crsDupGroups}} 组同名课程，是早期「一个班建一条课」留下的。合并后各班照常开课，历史记录不受影响。</view>
    <view class="btn ghost dupbtn" hover-class="btn-hover" bindtap="mergeCourses">一键合并同名课程</view>
  </view>
  <view wx:if="{{!courses.length && !courseFormOpen}}" class="empty slim">还没有课程，点下面「添加课程」建一个</view>
  <view class="card item crsitem" wx:for="{{courses}}" wx:key="id">
    <view class="crsline">
      <view style="flex:1;min-width:0">
        <b>{{item.name}}</b>
        <view class="mi" wx:if="{{!item.clsList.length}}">未开设到任何班级</view>
        <view class="crsintro" wx:if="{{item.introBrief}}">{{item.introBrief}}</view>
      </view>
      <view class="mi act" catchtap="openCrsDetail" data-id="{{item.id}}">详情</view>
      <view class="mi act" catchtap="renameCourse" data-id="{{item.id}}" data-name="{{item.name}}">改名</view>
      <view class="mi del" catchtap="delCourse" data-id="{{item.id}}">删除</view>
    </view>
    <!-- 开设的班级：点一下就取消这个班的开设（课程本身不删） -->
    <view class="crscls">
      <text class="crscl" wx:for="{{item.clsList}}" wx:for-item="cc" wx:key="id"
            data-id="{{item.id}}" data-cid="{{cc.id}}" data-name="{{cc.name}}" catchtap="delCourseCls">{{cc.name}} ×</text>
      <text class="crsadd" wx:if="{{item.canBind && classes.length}}" data-id="{{item.id}}" catchtap="addCourseCls">＋ 开设到…</text>
    </view>
  </view>
</view>
<view wx:if="{{tabK==='course'}}" class="clsfab">
  <view class="btn" hover-class="btn-hover" bindtap="openCourseForm">＋ 添加课程</view>
</view>

<!-- ============ 学生 ============ -->
<view wx:if="{{tabK==='stu'}}" class="wrap stuwrap">
  <!-- 筛选区：吸顶钉住，列表从其下方滚过；整块收进白色卡片（与页签、列表卡片同一套视觉）。
       行内顺序：入学 → 男/女 → 搜索（含麦克风） -->
  <view class="stufilter">
    <view class="sfcard">
      <view class="sfrow2">
        <picker mode="selector" range="{{stuYears}}" range-key="name" value="{{stuYearIdx}}" bindchange="onStuYear">
          <view class="pkbox">入学：{{stuYears[stuYearIdx].name || '全部'}} ▾</view>
        </picker>
        <view class="gswitch">
          <view class="gopt {{stuGender==='男'?'on':''}}" bindtap="onStuGender" data-v="男">男</view>
          <view class="gopt {{stuGender==='女'?'on':''}}" bindtap="onStuGender" data-v="女">女</view>
        </view>
        <view class="vin sfsearch">
          <input class="sfin vin-in" placeholder="搜索姓名 / 学号 / 家长" value="{{stuQ}}" bindinput="onStuQ" confirm-type="search" />
          <image class="vmic {{micKey==='stuQ'?'rec':''}}" src="{{micKey==='stuQ'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuQ" />
        </view>
      </view>
      <view class="sfcount">共 {{stuCount}} 人，当前显示 {{students.length}} 人</view>
    </view>
  </view>
  <view class="card item" wx:for="{{students}}" wx:key="id">
    <view style="flex:1;min-width:0" bindtap="goStudentPage" data-id="{{item.id}}">
      <view class="itrow">
        <ava src="{{item.photo}}" name="{{item.name}}" size="{{64}}" radius="{{18}}" />
        <view style="min-width:0"><b>{{item.name}}</b><text wx:if="{{item.gender}}" class="gtag">{{item.gender}}</text>
        <view class="mi"><text wx:if="{{item.no}}" class="sno" catchtap="copyStuNoList" data-no="{{item.no}}">学号 {{item.no}} · 点按复制</text>{{item.cls}}{{item.year?' · '+item.year+' 年入学':''}}{{item.parent?' · 家长 '+item.parent:''}}{{item.parentPhone?' · 手机 '+item.parentPhone:''}}{{item.wechat?' · 微信 '+item.wechat:''}}</view></view>
      </view>
    </view>
    <view class="stuacts">
      <view class="mi act" catchtap="editStudent" data-id="{{item.id}}">编辑</view>
      <view class="mi del" catchtap="delStudent" data-id="{{item.id}}">删除</view>
    </view>
  </view>
  <view wx:if="{{!students.length}}" class="card empty">没有符合条件的学生，试试放宽筛选</view>
</view>
<!-- 学生操作：批量导入 + 添加学生，固定钉在页面底部 -->
<view wx:if="{{tabK==='stu'}}" class="stufab">
  <view class="stufab2">
    <view class="btn ghost" hover-class="btn-hover" bindtap="goImport">批量导入</view>
    <view class="btn" hover-class="btn-hover" bindtap="addStudent">＋ 添加学生</view>
  </view>
</view>

<!-- ============ 成员管理（负责人/管理员可见） ============ -->
<!-- ============ 人员：顶部分类（全部/老师/家长） + 中间列表 + 底部双添加按钮（与班级/学生同结构） ============ -->
<view wx:if="{{tabK==='member' && isManager}}" class="wrap clswrap">
  <!-- 这两行不在卡片里：用 .pagepad 跟页签 / 成员卡片 / 底部按钮统一左右 24rpx，
       别再贴着屏幕边。这里只写 margin-top，margin 简写会把 .pagepad 的左右边距冲掉 -->
  <view class="gswitch pagepad" style="align-self:flex-start">
    <view class="gopt {{memTab==='all'?'on':''}}" bindtap="pickMemTab" data-k="all">全部</view>
    <view class="gopt {{memTab==='teacher'?'on':''}}" bindtap="pickMemTab" data-k="teacher">老师</view>
    <view class="gopt {{memTab==='parent'?'on':''}}" bindtap="pickMemTab" data-k="parent">家长</view>
  </view>
  <view class="mi pagepad" style="margin-top:16rpx">老师只能看到并录入自己负责班级的成果；家长只能看自己孩子「已发布」的成果。点成员卡片可切身份预览，点「修改」可改资料与负责范围。</view>

  <!-- G01：左侧说明文字再长也不能把右侧操作区挤换行——文字单行省略，操作区 flex:none -->
  <view class="card item memitem" wx:for="{{memShown}}" wx:key="id">
    <view class="memmain" bindtap="goTeacher" data-id="{{item.id}}">
      <view class="itrow">
        <ava src="{{item.photo}}" name="{{item.name}}" size="{{76}}" radius="{{24}}" tone="{{item.avaTone}}" />
        <view class="memtxt"><b>{{item.name}}</b>
          <view class="mi memmeta">{{item.roleLabel}} · {{item.meta}}<text wx:if="{{item.invited}}" class="mi"> · 待绑定</text><text wx:else class="mi">{{item.bound ? ' · 已绑定微信' : ' · 未绑定微信'}}</text></view>
        </view>
      </view>
    </view>
    <view class="memacts">
      <text wx:if="{{item.cur}}" class="pill" style="background:var(--sent)">当前</text>
      <view class="mi act" catchtap="switchMe" data-id="{{item.id}}">切换</view>
      <view class="mi act" catchtap="editUser" data-id="{{item.id}}">修改</view>
      <view wx:if="{{item.role!=='owner'}}" class="mi del" catchtap="delUser" data-id="{{item.id}}">移除</view>
    </view>
  </view>
  <view wx:if="{{!memShown.length}}" class="empty slim">这个分类下还没有成员，点下面按钮添加</view>
</view>
<view wx:if="{{tabK==='member' && isManager}}" class="stufab">
  <view class="stufab2">
    <view class="btn" hover-class="btn-hover" bindtap="addUserParent">＋ 添加家长</view>
    <view class="btn" hover-class="btn-hover" bindtap="addUserTeacher">＋ 添加老师</view>
  </view>
</view>

<!-- ============ 学生表单弹层 ============ -->
<view wx:if="{{stuForm}}" class="mask" bindtap="stuCancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">{{stuForm.id?'编辑学生':'添加学生'}}</view>
    <view class="avrow" bindtap="onStuPhoto">
      <view class="ava big">
        <image wx:if="{{stuForm.photo}}" src="{{stuForm.photo}}" mode="aspectFill" />
        <text wx:else class="bigchar">{{stuForm.char}}</text>
        <image src="{{icoCameraW}}" class="cam" mode="aspectFit" />
      </view>
      <text class="mi">{{stuForm.photo?'点击更换照片':'上传学生照片（选填）'}}</text>
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="学生姓名" value="{{stuForm.name}}" bindinput="onStuName" />
      <image class="vmic {{micKey==='stuForm.name'?'rec':''}}" src="{{micKey==='stuForm.name'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.name" />
    </view>
    <!-- 学号由系统分配：新建时保存后生成，编辑时只读展示（家长凭它绑定孩子） -->
    <view class="stuno" bindtap="copyStuNo">
      <text wx:if="{{stuForm.id && stuForm.no}}">学号 {{stuForm.no}} · 点按复制</text>
      <text wx:else>学号保存后自动生成，家长可用它绑定孩子</text>
    </view>
    <view class="label">性别</view>
    <view class="gswitch" style="margin-bottom:20rpx">
      <view class="gopt {{stuForm.gender==='男'?'on':''}}" bindtap="onStuGenderSet" data-v="男">男</view>
      <view class="gopt {{stuForm.gender==='女'?'on':''}}" bindtap="onStuGenderSet" data-v="女">女</view>
    </view>
    <view class="label">入学年份</view>
    <view class="clsfrow" style="margin-bottom:20rpx">
      <picker mode="selector" range="{{enrollYearOpts}}" range-key="name" value="{{stuEnrollYearIdx}}" bindchange="onStuEnrollYear">
        <view class="pickerbox">入学年份：{{enrollYearOpts[stuEnrollYearIdx].name}} ▾</view>
      </picker>
    </view>
    <view class="label">加入班级（可多选）</view>
    <view class="chips" style="margin-bottom:20rpx">
      <view wx:for="{{stuClsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="stuClsTgl" data-id="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="label">家长联系方式</view>
    <!-- F-04：手机号是格式化字段，不配麦克风（念中文得不到合法号码）。
         输入中绑裸数字、失焦才分段成 3-4-4，口径同向导/机构页，见 utils/phone.js -->
    <input class="input" type="number" placeholder="家长手机号（选填，11 位）" placeholder-class="ph"
      value="{{stuForm.parentPhone}}" bindinput="onStuPhone" bindblur="onStuPhoneBlur" />
    <view class="vin">
      <input class="input vin-in" placeholder="家长称呼（如：张珊珊/妈妈）" value="{{stuForm.parent}}" bindinput="onStuParent" />
      <image class="vmic {{micKey==='stuForm.parent'?'rec':''}}" src="{{micKey==='stuForm.parent'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.parent" />
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="家长微信号（方便沟通）" value="{{stuForm.wechat}}" bindinput="onStuWechat" />
      <image class="vmic {{micKey==='stuForm.wechat'?'rec':''}}" src="{{micKey==='stuForm.wechat'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuForm.wechat" />
    </view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="stuCancel">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="stuSave">保存</view>
    </view>
  </view>
</view>

<!-- ============ 成员表单弹层 ============ -->
<view wx:if="{{userForm}}" class="mask" bindtap="userCancel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">{{userFormTitle}}</view>
    <!-- 头像：点块上传照片；或一键同步微信头像（头像填写能力） -->
    <view class="avrow">
      <view class="ava big" bindtap="onUserPhoto">
        <image wx:if="{{userForm.photo}}" src="{{userForm.photo}}" mode="aspectFill" />
        <text wx:else class="bigchar">{{userForm.char}}</text>
        <image src="{{icoCameraW}}" class="cam" mode="aspectFit" />
      </view>
      <view class="avcol">
        <text class="mi">{{userForm.photo ? '点击头像更换照片' : '点击头像上传照片（选填）'}}</text>
        <button class="wxava" open-type="chooseAvatar" bindchooseavatar="onWxAvatar" hover-class="btn-hover">用微信头像</button>
      </view>
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="姓名" value="{{userForm.name}}" bindinput="onUserName" />
      <image class="vmic {{micKey==='userForm.name'?'rec':''}}" src="{{micKey==='userForm.name'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="userForm.name" />
    </view>
    <view class="vin">
      <input class="input vin-in" type="number" placeholder="手机号（选填，可拨号）" value="{{userForm.phone}}" bindinput="onUserPhone" bindblur="onUserPhoneBlur" />
    </view>
    <view class="vin">
      <input class="input vin-in" placeholder="微信号（选填，可复制）" value="{{userForm.wechat}}" bindinput="onUserWechat" />
      <image class="vmic {{micKey==='userForm.wechat'?'rec':''}}" src="{{micKey==='userForm.wechat'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="userForm.wechat" />
    </view>

    <view class="label">角色</view>
    <view class="chips" style="margin-bottom:16rpx">
      <view wx:for="{{roleOpts}}" wx:key="k" class="chip {{userForm.role===item.k?'on':''}}" bindtap="pickRole" data-k="{{item.k}}">{{item.n}}</view>
    </view>
    <view class="mi" style="margin-bottom:20rpx">
      <block wx:for="{{roleOpts}}" wx:key="k"><text wx:if="{{userForm.role===item.k}}">{{item.d}}</text></block>
    </view>

    <block wx:if="{{userForm.role==='teacher'}}">
      <view class="label">负责班级（可多选，至少一个）</view>
      <view class="chips" style="margin-bottom:16rpx">
        <view wx:for="{{userClsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userClsTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
      <view class="label">课程权限（不选 = 所带班级全部课程）</view>
      <view class="chips" style="margin-bottom:20rpx">
        <view wx:for="{{userCrsChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userCrsTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </block>
    <block wx:elif="{{userForm.role==='parent'}}">
      <!-- G05：学号是 1001 这种编号，记不住很正常。默认直接列出学生名单点名字，
           也可搜姓名 / 学号 / 家长；按学号输入只留作快捷方式 -->
      <view class="label">关联孩子（不用记学号，点名字即可）</view>
      <view class="vin">
        <input class="input vin-in" placeholder="搜姓名 / 学号 / 家长" value="{{userStuQ}}" bindinput="onUserStuQ" />
        <image class="vmic {{micKey==='userStuQ'?'rec':''}}" src="{{micKey==='userStuQ'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="userStuQ" />
      </view>
      <view class="stucands">
        <view wx:for="{{userStuCands}}" wx:key="id" class="cand {{item.on?'on':''}}" catchtap="pickStuCand" data-id="{{item.id}}">
          <view class="candnm">{{item.name}}<text wx:if="{{item.on}}" class="candok">已选</text></view>
          <view class="mi">{{item.sub}}</view>
        </view>
        <view wx:if="{{!userStuCands.length}}" class="mi">没找到，换个名字或学号试试</view>
      </view>
      <view class="label">按学号快捷绑定（可留空）</view>
      <view class="bindrow">
        <input class="input bindin" type="number" placeholder="输入学生学号，如 1001" value="{{userBindNo}}" bindinput="onBindNo" confirm-type="done" bindconfirm="bindByNo" />
        <view class="btn ghost bindbtn" hover-class="btn-hover" bindtap="bindByNo">添加</view>
      </view>
      <view class="mi" style="margin:-8rpx 0 16rpx">同一个家长号码下的孩子会自动带出，不用一个个选。</view>
      <view class="label">已选孩子（点一下可取消）</view>
      <view class="chips" style="margin-bottom:20rpx">
        <view wx:for="{{userStuChips}}" wx:key="id" class="chip {{item.on?'on':''}}" bindtap="userStuTgl" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="mi" style="margin-bottom:20rpx">管理员可见并管理全机构的班级、学生、成员与模板，无需单独分配范围。</view>
    </block>

    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="userCancel">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="userSave">保存</view>
    </view>
  </view>
</view>

<!-- ============ 添加班级弹层 ============ -->
<view wx:if="{{clsFormOpen}}" class="mask" bindtap="closeClsForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">添加班级</view>
    <view class="vin">
      <input class="input vin-in" placeholder="班级名称" value="{{newCls}}" bindinput="onNewCls" />
      <image class="vmic {{micKey==='newCls'?'rec':''}}" src="{{micKey==='newCls'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="newCls" />
    </view>
    <view class="clsfrow">
      <picker mode="selector" range="{{clsTerms}}" range-key="name" value="{{clsTermIdx}}" bindchange="onClsTerm">
        <view class="pickerbox">学期：{{clsTerms[clsTermIdx].name || '请选择'}} ▾</view>
      </picker>
    </view>
    <view class="clsfrow">
      <view class="chip {{clsMode === 'term' ? 'on' : ''}}" bindtap="onClsMode" data-v="term">学期制</view>
      <view class="chip {{clsMode === 'carry' ? 'on' : ''}}" bindtap="onClsMode" data-v="carry">课时结转</view>
    </view>
    <view class="clsfrow" wx:if="{{clsMode === 'term'}}">
      <view class="hint2 note">学期制班：按学期上课与统计，学期结束后默认随学期归档（如需延续到下期，可在「学期管理」里整班结转）。</view>
    </view>
    <view class="clsfrow" wx:if="{{clsMode === 'carry'}}">
      <view class="hint2 note">课时结转班：录一节消一课时，学期结束可整班结转到下期（在「学期管理」里操作）。</view>
    </view>
    <view class="clsfrow" style="margin-bottom:8rpx">
      <picker mode="selector" range="{{clsTeachers}}" range-key="name" value="{{clsTeacherIdx}}" bindchange="onClsTeacher">
        <view class="pickerbox">主讲老师：{{clsTeachers[clsTeacherIdx].name || '暂不指派'}} ▾</view>
      </picker>
    </view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="closeClsForm">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="addClass">添加</view>
    </view>
  </view>
</view>

<!-- 一次把课程开设到多个班：列出全部班级，已开设的默认选中，取消勾选 = 从该班撤下 -->
<view wx:if="{{crsBind}}" class="mask" bindtap="closeCrsBind">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">「{{crsBind.name}}」开设到</view>
    <view class="mi" style="text-align:center;margin:6rpx 0 24rpx">一次可勾选多个班；取消勾选 = 从该班撤下（课程与历史记录都保留）</view>
    <view class="chips">
      <view wx:for="{{crsBind.chips}}" wx:key="id" class="chip {{item.on?'on':''}}" hover-class="btn-hover" bindtap="crsBindTgl" data-id="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="sheet-tools">
      <text class="act" catchtap="crsBindAll">全选</text>
      <text class="mi" catchtap="crsBindNone">清空</text>
      <text class="mi">已选 {{crsBind.sel.length}} / {{classes.length}} 个班</text>
    </view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="closeCrsBind">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="saveCrsBind">保存</view>
    </view>
  </view>
</view>

<!-- 课程详情：介绍是课程本体的一部分，改它不动班级开设关系与历史记录 -->
<view wx:if="{{crsDetail}}" class="mask" bindtap="closeCrsDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-t">课程详情 · {{crsDetail.name}}</view>
    <view class="sec"><view class="label">课程介绍</view></view>
    <view class="vin">
      <textarea class="crstext vin-in" placeholder="这门课学什么、适合谁、怎么上…" placeholder-class="ph" value="{{crsDetail.intro}}" bindinput="onCrsIntro" maxlength="500" auto-height />
      <image class="vmic {{micKey==='crsDetail.intro'?'rec':''}}" src="{{micKey==='crsDetail.intro'?icoWhite:icoMic}}" mode="aspectFit" catchtap="onMic" data-k="crsDetail.intro" />
    </view>
    <view class="mi" style="margin-top:12rpx">{{crsDetail.intro.length}}/500　以后还能接着加：适合年龄、课时、教材、教学目标、封面</view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="closeCrsDetail">取消</view>
      <view class="btn" hover-class="btn-hover" bindtap="saveCrsDetail">保存</view>
    </view>
  </view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup id="privacy" />
</view>
