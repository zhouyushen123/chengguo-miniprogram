/* ---------- 顶部页签 ---------- */
.tabs {
  display: flex; background: #fff; margin: 20rpx 24rpx 24rpx;
  border-radius: 999rpx; padding: 8rpx; box-shadow: 0 4rpx 16rpx var(--shadow);
}
.tab {
  flex: 1; text-align: center; font-size: 28rpx; color: var(--sub);
  padding: 16rpx 0; border-radius: 999rpx; transition: all .15s;
}
.tab.on { background: var(--brand); color: #fff; font-weight: 700; box-shadow: 0 6rpx 16rpx var(--brand-shadow); }
/* ---------- 列表项 ---------- */
.item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.item b { font-size: 30rpx; }
.addrow { display: flex; gap: 16rpx; align-items: center; }
.addbtn { padding: 20rpx 40rpx; flex: none; }
.del { color: var(--danger); font-size: 25rpx; padding: 10rpx 0 10rpx 24rpx; flex: none; }
.act { color: var(--brand); font-size: 25rpx; font-weight: 600; padding: 10rpx 0 10rpx 24rpx; }
.itrow { display: flex; align-items: center; gap: 20rpx; }
.itrow .ava { width: 76rpx; height: 76rpx; font-size: 30rpx; }
/* ---------- 底部弹层 ---------- */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  z-index: 100; background: rgba(0,0,0,.45);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 82vh; overflow-y: scroll; -webkit-overflow-scrolling: touch; box-sizing: border-box;
}
.sheet-t { text-align: center; font-size: 34rpx; font-weight: 700; margin-bottom: 28rpx; }
.row2 { display: flex; gap: 20rpx; margin-top: 28rpx; }
.row2 .btn { flex: 1; }
/* 卡片内的按钮行：上方只留卡片自身的 28rpx 内边距（此前 28+28 双倍叠间距） */
.card .row2 { margin-top: 0; }
/* 按钮行后紧跟的说明文字：统一 24rpx 标准间距（与卡片间距同标准） */
.row2 + .mi { margin-top: 24rpx; }

/* 学生表单：照片上传行 */
.avrow { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.ava.big { width: 110rpx; height: 110rpx; border-radius: 34rpx; font-size: 44rpx; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.ava.big image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* 无照片时的相机占位图标：独立于铺满式照片规则，居中显示 */
.ava.big .cam { position: static; width: 44rpx; height: 44rpx; }

/* 身份预览条：以他人身份查看时的显式提示与返回出口 */
.idbar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 28rpx 16rpx; padding: 14rpx 22rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border); border-radius: 16rpx;
  font-size: 23rpx; color: var(--sub);
}
.idbar .idback {
  flex: none; margin-left: 18rpx; padding: 6rpx 20rpx;
  background: var(--brand); color: #fff; border-radius: 999rpx; font-size: 22rpx;
}

/* 新建班级表单 */
.clsfrow { margin-top: 20rpx; display: flex; gap: 14rpx; flex-wrap: wrap; align-items: center; }
.clsfrow .chip { font-size: 25rpx; }
.clsfrow .chip.on { background: var(--brand); color: #fff; font-weight: 700; }
.hint2 { font-size: 24rpx; color: var(--sub); line-height: 1.7; }

/* ---------- 班级页签：底部固定添加栏 + 卡片展开成员名单 ---------- */
.clswrap { padding-bottom: 170rpx; }
/* 添加班级固定栏：与学生页的 stufab 同款（页面底部 + 安全区） */
.clsfab {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2rpx solid var(--line);
}
.clsfab .btn { width: 100%; }
/* 班级卡：整卡可点展开，头部行（头像+信息+箭头+删除）+ 展开区 */
.clsrow { display: flex; align-items: center; }
.clshd { flex: 1; min-width: 0; }
.clscaret { flex: none; color: var(--sub); font-size: 26rpx; padding: 10rpx 4rpx 10rpx 16rpx; transition: transform .15s; }
.clscaret.up { transform: rotate(180deg); }
.clsexp { margin-top: 20rpx; border-top: 2rpx solid var(--line); padding-top: 20rpx; }
.clsexp-input {
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 12rpx 26rpx; font-size: 25rpx; margin-bottom: 8rpx;
}
.clsmem { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 4rpx; border-bottom: 2rpx solid var(--line); }
.clsmem:last-child { border-bottom: none; }
.clsmem .ava { width: 56rpx; height: 56rpx; font-size: 24rpx; border-radius: 18rpx; }
.memname { font-size: 27rpx; font-weight: 600; }
.memchev { width: 28rpx; height: 28rpx; flex: none; }

/* ---------- 学生标签页：筛选区（吸顶）+ 底部固定添加按钮 ---------- */
/* 列表加底部留白，避免最后一张卡被固定的添加按钮压住 */
.stuwrap { padding-bottom: 170rpx; }
/* 筛选区：钉在顶部，列表从其下方滚过；底部分割线与导航栏底边视觉一致 */
.stufilter {
  position: sticky; top: 0; z-index: 20;
  background: var(--bg); padding: 0 0 16rpx; margin-bottom: 4rpx;
  border-bottom: 2rpx solid var(--line);
}
.sfinput {
  box-sizing: border-box; width: 100%;
  background: #fff; border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 14rpx 28rpx; font-size: 27rpx; margin-bottom: 16rpx;
}
.sfrow2 { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.pkbox {
  font-size: 24rpx; color: var(--sub); background: #fff;
  border: 2rpx solid var(--line-2); border-radius: 999rpx; padding: 10rpx 24rpx;
  white-space: nowrap; display: inline-flex; align-items: center; gap: 8rpx;
}
.sfcount { margin-top: 14rpx; font-size: 22rpx; color: var(--sub); }
/* 名字旁的性别小徽标 */
.gtag {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx;
  font-size: 20rpx; color: var(--brand); background: var(--brand-tint); border-radius: 999rpx;
}
/* 添加学生按钮：固定钉在页面底部（含全面屏安全区），列表滚动时始终可点 */
.stufab {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2rpx solid var(--line);
}
.stufab .btn { width: 100%; }
.empty { text-align: center; color: var(--sub); font-size: 26rpx; padding: 48rpx 0; }
