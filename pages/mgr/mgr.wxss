.tabs { display: flex; background: #fff; padding: 0 24rpx; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 29rpx; color: #9c948a; border-bottom: 6rpx solid transparent; }
.tab.on { color: #232323; font-weight: 700; border-bottom-color: #e8590c; }
.addrow { display: flex; gap: 16rpx; align-items: center; }
.addbtn { flex: none; padding: 20rpx 40rpx; }
.pickerbox { background: #fff; border: 2rpx solid #e5e2dd; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.item { display: flex; justify-content: space-between; align-items: center; }
.del { color: #c0564a; }
