/* ---------- 顶部页签 ---------- */
.tabs {
  display: flex; background: #fff; margin: 20rpx 24rpx 24rpx;
  border-radius: 999rpx; padding: 8rpx; box-shadow: 0 4rpx 16rpx var(--shadow);
}
.tab {
  flex: 1; text-align: center; font-size: 28rpx; color: var(--sub);
  padding: 16rpx 0; border-radius: 999rpx; transition: all .15s;
}
.tab.on { background: var(--brand); color: #fff; font-weight: 700; box-shadow: 0 6rpx 16rpx var(--brand-shadow); }
/* ---------- 列表项 ---------- */
.item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.item b { font-size: 30rpx; }
.addrow { display: flex; gap: 16rpx; align-items: center; }
.addbtn { padding: 20rpx 40rpx; flex: none; }
.del { color: var(--danger); font-size: 25rpx; padding: 10rpx 0 10rpx 24rpx; flex: none; }
.act { color: var(--brand); font-size: 25rpx; font-weight: 600; padding: 10rpx 0 10rpx 24rpx; }
.itrow { display: flex; align-items: center; gap: 20rpx; }
/* 班级条目标识：大圆形色块改为窄圆角竖杠，弱化装饰、突出名称 */
.clsbar { width: 8rpx; height: 52rpx; border-radius: 6rpx; background: linear-gradient(180deg, var(--brand-a), var(--brand-b)); flex: none; }
/* 学生头像缩略图：小尺寸圆角方块；无照片时浅底首字占位（不再是实色色块） */
.stuava { width: 64rpx; height: 64rpx; border-radius: 18rpx; flex: none; }
.stuava.stub { background: var(--brand-soft); display: flex; align-items: center; justify-content: center; }
.stuava.stub image { width: 36rpx; height: 36rpx; opacity: .55; }
.itrow .ava { width: 76rpx; height: 76rpx; font-size: 30rpx; }
/* ---------- 底部弹层 ---------- */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  z-index: 100; background: rgba(0,0,0,.45);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 94vh; overflow-y: auto; -webkit-overflow-scrolling: touch; box-sizing: border-box;
}
/* 弹层标题：普通流式标题（与学期管理页一致）。
   此前用 sticky 吸顶 + 负边距，但拉键盘时微信会把弹层滚动区上顶、收起后滚动位置残留，
   第一行输入框会被永久压在吸顶标题下面（截图实证）；普通标题跟随内容滚动，不存在遮挡 */
.sheet-t {
  text-align: center; font-size: 34rpx; font-weight: 700;
  margin-bottom: 10rpx;
}
.row2 { display: flex; gap: 20rpx; margin-top: 28rpx; }
.row2 .btn { flex: 1; }

/* 学号提示行（表单内只读）：不占输入框的位置，只用一行小字说明 */
.stuno { font-size: 23rpx; color: var(--sub); margin: -6rpx 0 18rpx; }
.stuno text { color: var(--brand); }
/* 家长按学号绑定：输入框占满剩余宽度，添加按钮定宽不压缩 */
.bindrow { display: flex; gap: 16rpx; align-items: center; margin-bottom: 12rpx; }
.bindrow .bindin { flex: 1; min-width: 0; }
.bindrow .bindbtn { flex: none; width: 168rpx; height: 84rpx; font-size: 28rpx; }
/* 学生条目里的学号小标签 */
.sno { margin-right: 8rpx; font-size: 21rpx; color: var(--brand); background: var(--brand-soft); border-radius: 8rpx; padding: 2rpx 10rpx; }
/* 卡片内的按钮行：上方只留卡片自身的 28rpx 内边距（此前 28+28 双倍叠间距） */
.card .row2 { margin-top: 0; }
/* 按钮行后紧跟的说明文字：统一 24rpx 标准间距（与卡片间距同标准） */
.row2 + .mi { margin-top: 24rpx; }

/* 学生表单：照片上传行 */
.avrow { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.ava.big { width: 110rpx; height: 110rpx; border-radius: 34rpx; font-size: 44rpx; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--brand-a), var(--brand-b)); color: #fff; flex: none; }
.ava.big > image:first-child { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* 无照片时：色块 + 白色首字打底（全站统一口径），相机改右下小角标提示可上传 */
.ava.big .bigchar { font-weight: 700; line-height: 1; }
.ava.big .cam {
  position: absolute; right: 4rpx; bottom: 4rpx; z-index: 2;
  width: 40rpx; height: 40rpx; padding: 8rpx; box-sizing: border-box;
  background: rgba(0, 0, 0, 0.35); border-radius: 999rpx;
}
/* 人员表单：微信头像同步按钮（open-type=chooseAvatar 需 button 承载） */
.avcol { display: flex; flex-direction: column; gap: 12rpx; align-items: flex-start; }
.wxava {
  margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx;
  font-size: 24rpx; color: var(--brand); background: var(--brand-soft);
  border: 2rpx solid var(--brand-border); border-radius: 999rpx;
}
.wxava::after { border: none; }

/* 身份预览条：以他人身份查看时的显式提示与返回出口 */
.idbar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 28rpx 16rpx; padding: 14rpx 22rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border); border-radius: 16rpx;
  font-size: 23rpx; color: var(--sub);
}
.idbar .idback {
  flex: none; margin-left: 18rpx; padding: 6rpx 20rpx;
  background: var(--brand); color: #fff; border-radius: 999rpx; font-size: 22rpx;
}

/* 新建班级表单 */
.clsfrow { margin-top: 20rpx; display: flex; gap: 14rpx; flex-wrap: wrap; align-items: center; }
/* 表单里的下拉框占满整行，与输入框左右边缘对齐（筛选条里的胶囊下拉不受影响） */
.clsfrow > picker { flex: 1; min-width: 0; }
.clsfrow .chip { font-size: 25rpx; }
.clsfrow .chip.on { background: var(--brand); color: #fff; font-weight: 700; }
.hint2 { font-size: 24rpx; color: var(--sub); line-height: 1.7; }

/* ---------- 班级页签：底部固定添加栏 + 卡片展开成员名单 ---------- */
.clswrap { padding-bottom: 170rpx; }
/* 添加班级固定栏：与学生页的 stufab 同款（页面底部 + 安全区） */
.clsfab {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2rpx solid var(--line);
}
.clsfab .btn { width: 100%; }
/* 班级卡：整卡可点展开，头部行（头像+信息+箭头+删除）+ 展开区 */
.clsrow { display: flex; align-items: center; }
.clshd { flex: 1; min-width: 0; }
.clscaret { flex: none; color: var(--sub); font-size: 26rpx; padding: 10rpx 4rpx 10rpx 16rpx; transition: transform .15s; }
.clscaret.up { transform: rotate(180deg); }
.clsexp { margin-top: 20rpx; border-top: 2rpx solid var(--line); padding-top: 20rpx; }
.clsexp-input {
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 12rpx 26rpx; font-size: 25rpx; margin-bottom: 8rpx;
}
.clsmem { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 4rpx; border-bottom: 2rpx solid var(--line); }
.clsmem:last-child { border-bottom: none; }
.memname { font-size: 27rpx; font-weight: 600; }
.memchev { width: 28rpx; height: 28rpx; flex: none; }
.clsexp-add {
  margin-top: 12rpx; text-align: center; font-size: 26rpx; font-weight: 600;
  color: var(--brand); background: var(--brand-soft); border-radius: 16rpx;
  padding: 16rpx 0;
}

/* ---------- 学生标签页：筛选区（吸顶）+ 底部固定添加按钮 ---------- */
/* 列表加底部留白，避免最后一张卡被固定的添加按钮压住 */
.stuwrap { padding-bottom: 170rpx; }
/* 筛选区：钉在顶部，列表从其下方滚过。灰色吸底带只负责滚动遮挡，
   内容全部收进白色圆角卡片，与页签、列表卡片同一套视觉，不再有白胶囊浮在灰条上的断裂感 */
.stufilter {
  position: sticky; top: 0; z-index: 20;
  background: var(--bg); padding: 8rpx 24rpx 16rpx; margin-bottom: 4rpx;
}
.sfcard {
  background: #fff; border-radius: 28rpx; padding: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}
/* 行内搜索框：与入学、男/女同一行，排在性别开关之后 */
.sfsearch { flex: 1; min-width: 220rpx; }
.sfin {
  box-sizing: border-box; width: 100%;
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 12rpx 64rpx 12rpx 24rpx; font-size: 24rpx;
}
.sfrow2 { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
/* 性别筛选：男/女 二段开关。再点已选中的那段 = 取消筛选（回到全部，含未填性别的） */
.gswitch {
  display: inline-flex; gap: 4rpx; padding: 4rpx; flex: none;
  background: #fff; border: 2rpx solid var(--line-2); border-radius: 999rpx;
}
.gswitch .gopt { font-size: 24rpx; color: var(--sub); padding: 8rpx 24rpx; border-radius: 999rpx; }
.gswitch .gopt.on { background: var(--brand); color: #fff; font-weight: 700; }
.pkbox {
  font-size: 24rpx; color: var(--sub); background: var(--bg);
  border: 2rpx solid var(--line-2); border-radius: 999rpx; padding: 10rpx 20rpx;
  white-space: nowrap; display: inline-flex; align-items: center; gap: 8rpx; flex: none;
}
.sfcount { margin-top: 14rpx; font-size: 22rpx; color: var(--sub); }
/* 学生卡片右侧操作区：固定宽度不被长文字挤压（左侧文字区 flex:1 + min-width:0 自行换行） */
.stuacts { display: flex; align-items: center; flex: none; }
.stuacts .act { flex: none; }
/* 名字旁的性别小徽标 */
.gtag {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx;
  font-size: 20rpx; color: var(--brand); background: var(--brand-tint); border-radius: 999rpx;
}
/* 添加学生按钮：固定钉在页面底部（含全面屏安全区），列表滚动时始终可点 */
.stufab {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2rpx solid var(--line);
}
.stufab .btn { width: 100%; }
.stufab2 { display: flex; gap: 16rpx; }
.stufab2 .btn { flex: 1; min-width: 0; }
.empty { text-align: center; color: var(--sub); font-size: 26rpx; padding: 48rpx 0; }

/* 成员头像按角色着色：原来写在 WXML 的 style 里，暖橙渐变在蓝色/极简主题下不会跟着变 */
.ava-owner, .ava-admin { background: linear-gradient(135deg, #6B8FD6, #4A7DDC); }
.ava-parent { background: linear-gradient(135deg, #7FB069, #3A9E5F); }
.ava-teacher { background: linear-gradient(135deg, var(--brand-a), var(--brand-b)); }

/* 机构页签的保存按钮：与卡片留出呼吸间距（用户实测 C-01：两侧与底部都没间距） */
.orgsave { margin: 28rpx 6rpx 44rpx; }
