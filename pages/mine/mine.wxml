<view class="theme-root {{themeCls}}">
<view class="hero"></view>

<!-- 身份条：预览他人身份时可一键切回 -->
<view wx:if="{{canSwitchHome}}" class="idbar">
  <text>正在以「{{name}} · {{roleLabel}}」身份预览</text>
  <text class="idback" bindtap="backHome">切回我自己</text>
</view>

<!-- 个人卡片 -->
<view class="card usercard">
  <view class="ava">{{avaChar}}</view>
  <view class="uc-txt">
    <view class="uc-name">{{name}}</view>
    <view class="uc-meta">{{roleLabel}}<text wx:if="{{orgName}}"> · {{orgName}}</text></view>
    <view wx:if="{{meta}}" class="uc-meta">{{meta}}</view>
  </view>
</view>

<!-- 管理统计层：五个维度概览，点按进入对应管理页签做增删改查 -->
<view wx:if="{{statItems.length}}" class="card statcard">
  <view class="statrow">
    <view wx:for="{{statItems}}" wx:key="k" class="stat5" hover-class="mrow-hover" bindtap="tapStat" data-tab="{{item.tab}}">
      <view class="s5n">{{item.n}}</view>
      <view class="s5t">{{item.t}}</view>
    </view>
  </view>
  <view class="stat5-d">点按进入对应管理</view>
</view>

<!-- 功能入口 -->
<view class="card menucard">
  <view wx:for="{{entries}}" wx:key="k" class="mrow" hover-class="mrow-hover" bindtap="tapEntry" data-k="{{item.k}}">
    <view class="mr-txt">
      <view class="mr-t">{{item.t}}</view>
      <view class="mr-d">{{item.d}}</view>
    </view>
    <view class="chev"></view>
  </view>
</view>

<!-- 换肤：点击即全局切换（卡片/按钮/图标/tabBar 同色系联动） -->
<view class="card skincard">
  <view class="skin-t">换肤</view>
  <view class="skins">
    <view wx:for="{{themes}}" wx:key="k" class="skin {{item.k===theme?'on':''}}" hover-class="mrow-hover" bindtap="pickTheme" data-k="{{item.k}}">
      <view class="skin-dot" style="background:linear-gradient(135deg,{{item.dot2}},{{item.dot}})"></view>
      <view class="skin-n">{{item.name}}</view>
      <view class="skin-d">{{item.desc}}</view>
      <view wx:if="{{item.k===theme}}" class="skin-cur">✓ 使用中</view>
    </view>
  </view>
</view>

<!-- 危险操作：仅负责人/管理员可见 -->
<view wx:if="{{isManager && hasDemo}}" class="card danger" hover-class="mrow-hover" bindtap="clearDemo">清空演示数据</view>

<view class="slogan">橙果 · 让每节课都有回音</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup />
</view>
