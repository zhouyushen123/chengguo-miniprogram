/* 顶部暖色渐变，呼应个人中心设计稿。
   注意 z-index：.hero 是绝对定位，若不压层级会画在非定位的 .card 之上，
   表现为"卡片上蒙了一层蓝/橙"，文字发花。让它待在卡片下面，只做背景装饰。 */
.hero {
  position: absolute; left: 0; top: 0; width: 100%; height: 220rpx;
  background: linear-gradient(180deg, var(--brand-tint), var(--brand-tint-0));
  pointer-events: none; z-index: 0;
}

/* ---------- 身份卡（整张可点，进「机构与身份」） ---------- */
.usercard {
  display: flex; align-items: center; gap: 26rpx; padding: 32rpx 28rpx;
  position: relative; z-index: 1;
}
.usercard .ava {
  width: 108rpx; height: 108rpx; border-radius: 34rpx; flex: none;
  background: linear-gradient(135deg, var(--brand-a), var(--brand));
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 18rpx var(--brand-shadow-soft);
}
.uc-txt { flex: 1; min-width: 0; }
.uc-name { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.uc-meta { font-size: 24rpx; color: var(--muted); line-height: 1.5; }
/* 演示模式徽标：跟在身份后面的一颗小胶囊，提醒现在看的是样板间 */
.uc-demo {
  display: inline-block; margin-left: 10rpx; padding: 2rpx 12rpx;
  font-size: 20rpx; font-weight: 700; color: var(--brand);
  background: var(--brand-soft); border-radius: 999rpx;
}

/* ---------- 三个数字：一行三列 ---------- */
.statcard { padding: 30rpx 12rpx 26rpx; position: relative; z-index: 1; }
.statrow { display: flex; }
.stat5 { flex: 1; text-align: center; padding: 4rpx 0; }
/* 数字底下的浅色小方块：给"可点"一个视觉抓手，比纯数字更像按钮 */
.s5box {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 84rpx; height: 62rpx; padding: 0 16rpx; box-sizing: border-box;
  background: var(--brand-soft); border-radius: 16rpx;
}
.s5n { font-size: 34rpx; font-weight: 800; color: var(--brand); line-height: 1; }
.s5t { margin-top: 10rpx; font-size: 23rpx; color: var(--muted); }

/* ---------- 入口列表 ---------- */
.menucard { padding: 8rpx 28rpx; position: relative; z-index: 1; }
.mrow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 2rpx solid var(--line);
}
.mrow:last-child { border-bottom: none; }
.mrow-hover { opacity: 0.75; }
.mr-txt { flex: 1; min-width: 0; }
.mr-t { font-size: 30rpx; font-weight: 600; }
.mr-d { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
/* 未读数：只给"真的有人等你处理"的项挂角标 */
.cnt {
  flex: none; margin-left: 16rpx; padding: 2rpx 14rpx;
  font-size: 21rpx; font-weight: 700; color: #fff;
  background: var(--brand); border-radius: 999rpx;
}
/* 纯 CSS 右箭头，与全局线性图标粗细一致 */
.chev {
  width: 18rpx; height: 18rpx; flex: none; margin-left: 16rpx;
  border-top: 4rpx solid var(--faint); border-right: 4rpx solid var(--faint);
  transform: rotate(45deg);
}

/* ---------- 身份预览条（与管理页一致） ---------- */
.idbar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 28rpx 20rpx; padding: 14rpx 22rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border); border-radius: 16rpx;
  font-size: 23rpx; color: var(--sub);
}
.idbar .idback {
  flex: none; margin-left: 18rpx; padding: 6rpx 20rpx;
  background: var(--brand); color: #fff; border-radius: 999rpx; font-size: 22rpx;
}

/* 底部留白：贴底的"设置"卡在 iPhone 上不能被小黑条盖住 */
.slogan { padding-bottom: env(safe-area-inset-bottom); }
