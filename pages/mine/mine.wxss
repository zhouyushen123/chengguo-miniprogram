/* 顶部暖色渐变，呼应个人中心设计稿 */
.hero {
  position: absolute; left: 0; top: 0; width: 100%; height: 220rpx;
  background: linear-gradient(180deg, #fdf3ea, rgba(247, 246, 243, 0));
  pointer-events: none;
}
.page-title { font-size: 40rpx; font-weight: 700; margin: 20rpx 32rpx 28rpx; }

/* ---------- 个人卡片 ---------- */
.usercard { display: flex; align-items: center; gap: 26rpx; padding: 32rpx 28rpx; }
.usercard .ava {
  width: 108rpx; height: 108rpx; border-radius: 34rpx; flex: none;
  background: linear-gradient(135deg, #f7a23b, #e8590c);
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(232, 89, 12, 0.25);
}
.uc-name { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.uc-meta { font-size: 24rpx; color: #9c948a; line-height: 1.5; }

/* ---------- 入口列表 ---------- */
.menucard { padding: 8rpx 28rpx; }
.mrow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 2rpx solid #f2efeb;
}
.mrow:last-child { border-bottom: none; }
.mrow-hover { opacity: 0.75; }
.mr-t { font-size: 30rpx; font-weight: 600; }
.mr-d { font-size: 24rpx; color: #9c948a; margin-top: 6rpx; }
/* 纯 CSS 右箭头，与全局线性图标粗细一致 */
.chev {
  width: 18rpx; height: 18rpx; flex: none;
  border-top: 4rpx solid #c9c3ba; border-right: 4rpx solid #c9c3ba;
  transform: rotate(45deg);
}

/* ---------- 危险操作 ---------- */
.danger {
  color: #c0564a; font-weight: 700; text-align: center;
  font-size: 30rpx; padding: 30rpx 0;
}

.slogan { text-align: center; color: #b8b1a7; font-size: 24rpx; margin-top: 56rpx; }

/* ---------- 身份预览条（与管理页一致） ---------- */
.idbar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 28rpx 20rpx; padding: 14rpx 22rpx;
  background: #fff4e8; border: 2rpx solid #f6dcc0; border-radius: 16rpx;
  font-size: 23rpx; color: #8a6d4b;
}
.idbar .idback {
  flex: none; margin-left: 18rpx; padding: 6rpx 20rpx;
  background: #e8590c; color: #fff; border-radius: 999rpx; font-size: 22rpx;
}
