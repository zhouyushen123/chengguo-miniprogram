/* 顶部暖色渐变，呼应个人中心设计稿 */
.hero {
  position: absolute; left: 0; top: 0; width: 100%; height: 220rpx;
  background: linear-gradient(180deg, var(--brand-tint), var(--brand-tint-0));
  pointer-events: none;
}
.page-title { font-size: 40rpx; font-weight: 700; margin: 20rpx 32rpx 28rpx; }

/* ---------- 个人卡片 ---------- */
.usercard { display: flex; align-items: center; gap: 26rpx; padding: 32rpx 28rpx; }
.usercard .ava {
  width: 108rpx; height: 108rpx; border-radius: 34rpx; flex: none;
  background: linear-gradient(135deg, var(--brand-a), var(--brand));
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 18rpx var(--brand-shadow-soft);
}
.uc-name { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.uc-meta { font-size: 24rpx; color: var(--muted); line-height: 1.5; }

/* ---------- 入口列表 ---------- */
.menucard { padding: 8rpx 28rpx; }
.mrow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 2rpx solid var(--line);
}
.mrow:last-child { border-bottom: none; }
.mrow-hover { opacity: 0.75; }
.mr-t { font-size: 30rpx; font-weight: 600; }
.mr-d { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
/* 纯 CSS 右箭头，与全局线性图标粗细一致 */
.chev {
  width: 18rpx; height: 18rpx; flex: none;
  border-top: 4rpx solid var(--faint); border-right: 4rpx solid var(--faint);
  transform: rotate(45deg);
}

/* ---------- 危险操作 ---------- */
.danger {
  color: var(--danger); font-weight: 700; text-align: center;
  font-size: 30rpx; padding: 30rpx 0;
}

.slogan { text-align: center; color: var(--faint); font-size: 24rpx; margin-top: 56rpx; }

/* ---------- 身份预览条（与管理页一致） ---------- */
.idbar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 28rpx 20rpx; padding: 14rpx 22rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border); border-radius: 16rpx;
  font-size: 23rpx; color: var(--sub);
}
.idbar .idback {
  flex: none; margin-left: 18rpx; padding: 6rpx 20rpx;
  background: var(--brand); color: #fff; border-radius: 999rpx; font-size: 22rpx;
}

/* ---------- 换肤卡片 ---------- */
.skin-t { font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.skins { display: flex; gap: 18rpx; }
.skin {
  flex: 1; border-radius: 22rpx; padding: 22rpx 24rpx;
  background: var(--chip); border: 3rpx solid transparent;
  transition: all 0.15s; position: relative;
}
.skin.on { background: var(--brand-soft); border-color: var(--brand); }
.skin-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.65);
  margin-bottom: 14rpx;
}
.skin-n { font-size: 28rpx; font-weight: 700; color: var(--text); }
.skin-d { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.skin-cur {
  position: absolute; right: 20rpx; top: 22rpx;
  font-size: 20rpx; font-weight: 700; color: var(--brand);
}
