<view class="theme-root {{themeCls}}">
<view class="wrap">
  <view wx:if="{{!editing}}" class="card">
    <view class="sec stuhead">
      <view class="label">选择学生<text wx:if="{{over45 && !stuQuery}}" class="stucount">（{{stuExpanded ? '全部 ' + students.length + ' 人' : '前 45 人'}}）</text></view>
      <view class="stusearch-wrap" wx:if="{{over45}}">
        <input class="stusearch" placeholder="快速搜索姓名" placeholder-class="ph" value="{{stuQuery}}" bindinput="onStuQuery" confirm-type="search" />
        <image class="smic" src="{{icoMic}}" mode="aspectFit" catchtap="onMic" data-k="stuQuery" />
      </view>
    </view>
    <view class="chips stuchips">
      <view wx:for="{{stuShow}}" wx:key="id" class="chip {{sid===item.id?'on':''}}" bindtap="pickStu" data-sid="{{item.id}}">{{item.name}}</view>
    </view>
    <view wx:if="{{!stuShow.length}}" class="hint">没找到「{{stuQuery}}」相关学生</view>
    <view wx:if="{{over45 && !stuQuery}}" class="expander" hover-class="btn-hover" bindtap="toggleStuExpand">
      <image class="xico {{stuExpanded?'up':''}}" src="{{icoChevD}}" mode="aspectFit" />
      {{stuExpanded ? '收起' : '展开全部 ' + students.length + ' 人'}}
    </view>
  </view>

  <view class="card">
    <view class="sec"><view class="label">课堂评分</view></view>
    <view class="scorerow">
      <view class="scorenum {{score<60?'low':''}}">{{score}}<text class="scoreunit">分</text></view>
      <slider class="scorebar" min="0" max="100" value="{{score}}" activeColor="{{cBrand}}" backgroundColor="{{cLine}}" block-size="24" bindchange="onScore" bindchanging="onScore" />
    </view>
    <view class="chips tagchips">
      <view wx:for="{{tags}}" wx:key="t" class="chip {{tag===item.t?'on':''}}" bindtap="pickTag" data-t="{{item.t}}">{{item.t}}</view>
    </view>
  </view>

  <view class="card">
    <view class="sec"><view class="label">课程</view></view>
    <picker mode="selector" range="{{courses}}" range-key="name" value="{{courseIdx}}" bindchange="onCourse">
      <view class="pickerbox">{{course || '选择课程'}}<image class="xico" src="{{icoChevD}}" mode="aspectFit" /></view>
    </picker>
  </view>

  <view class="card">
    <view class="sec"><view class="label">课堂成果<text class="mihint">（照片 · 视频 · 语音）</text></view></view>
    <view class="mediarow">
      <view class="mbtn" hover-class="btn-hover" bindtap="addMedia" data-src="camera"><image class="mico" src="{{icoCamera}}" mode="aspectFit" /><text>拍摄</text></view>
      <view class="mbtn" hover-class="btn-hover" bindtap="addMedia" data-src="album"><image class="mico" src="{{icoAlbum}}" mode="aspectFit" /><text>相册</text></view>
    </view>
    <view class="photogrid" wx:if="{{photos.length}}">
      <view class="ph" wx:for="{{photos}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-i="{{index}}" />
        <view class="rm" catchtap="rmPhoto" data-i="{{index}}">×</view>
      </view>
    </view>
    <view class="videolist" wx:if="{{videos.length}}">
      <view class="vitem" wx:for="{{videos}}" wx:key="*this">
        <video class="vplayer" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
        <view class="rm" catchtap="rmVideo" data-i="{{index}}">×</view>
      </view>
    </view>
    <view wx:if="{{audio}}" class="audiorow">
      <image class="aico" src="{{icoAudio}}" mode="aspectFit" /><text class="mi" style="flex:1">语音已录入</text>
      <text class="mi act" bindtap="playAudio">播放</text><text class="mi del" bindtap="rmAudio">删除</text>
    </view>
    <view class="sec" style="margin-top:24rpx"><view class="label">课堂评价</view></view>
    <view class="notearea">
      <textarea class="noteta" placeholder="本节课表现、作品点评等；可用模板或语音快速生成" placeholder-class="ph" value="{{note}}" bindinput="onNote" maxlength="500" auto-height />
      <view class="notetools">
        <text class="notecnt">{{note.length}}/500</text>
        <view class="barbtn" hover-class="btn-hover" bindtap="toggleTpl">模板<text wx:if="{{selCount}}" class="badge">{{selCount}}</text></view>
        <view class="barbtn aibtn {{aiBusy?'busy':''}}" hover-class="btn-hover" bindtap="aiDraft">AI 评</view>
        <view class="micbtn {{(recording||recognizing)?'rec':''}}" hover-class="btn-hover" bindtap="toggleRec"><image class="micico" src="{{(recording||recognizing)?icoWhite:icoOrange}}" mode="aspectFit" /></view>
      </view>
    </view>
    <view wx:if="{{recognizing}}" class="reclayer">正在听写，请说话…说完点麦克风结束，文字可修改</view>
  </view>

  <view class="card sendzone">
    <view class="sec"><view class="label">发布</view></view>
    <view class="row2">
      <view class="btn ghost" hover-class="btn-hover" bindtap="preview">预览效果</view>
      <view class="btn ghost {{saving ? 'busy' : ''}}" hover-class="btn-hover" bindtap="save" data-send="0">{{saving ? '保存中…' : '存草稿'}}</view>
    </view>
    <view wx:if="{{canSend}}" class="btn {{saving ? 'busy' : ''}}" hover-class="btn-hover" bindtap="save" data-send="1">{{saving ? '保存中…' : '发布到家长端'}}</view>
    <view wx:else class="hint">补齐 照片/语音 与 课堂评价 后，即可发布到家长端</view>
    <view class="note">发布后家长打开小程序即可看到，目前不会收到微信消息通知。</view>
  </view>
</view>

<!-- 模板全屏面板：多选 / 增删改选项 -->
<view wx:if="{{tplOpen}}" class="tplpanel">
  <view class="tplhd">
    <view class="tplback" bindtap="tplClose">‹</view>
    <view class="tpltitle">评价模板</view>
    <view class="tplcount">已选 {{sel.length}}</view>
  </view>
  <scroll-view scroll-y class="tplbody">
    <view class="card tpldim" wx:for="{{tplList}}" wx:for-item="dim" wx:for-index="di" wx:key="n">
      <view class="dimhd">
        <view class="dimname">{{dim.n}}</view>
        <view class="dimacts">
          <text wx:if="{{canTplEdit}}" class="dimact" bindtap="tplAdd" data-di="{{di}}">＋ 新增选项</text>
        </view>
      </view>
      <view wx:for="{{dim.opts}}" wx:for-item="opt" wx:for-index="oi" wx:key="*this"
            class="optrow {{opt.on?'on':''}}" bindtap="tplToggle" data-k="{{di}}:{{oi}}">
        <view class="optcheck">{{opt.on?'✓':''}}</view>
        <view class="opttext">{{opt.t}}</view>
        <view class="optacts" catchtap="noop">
          <text wx:if="{{canTplEdit}}" class="optact" catchtap="tplEdit" data-di="{{di}}" data-oi="{{oi}}">编辑</text>
          <text wx:if="{{canTplEdit}}" class="optact del" catchtap="tplDel" data-di="{{di}}" data-oi="{{oi}}">删除</text>
        </view>
      </view>
    </view>
    <view style="height:40rpx"></view>
  </scroll-view>
  <view class="tplft">
    <view class="btn ghost" hover-class="btn-hover" bindtap="tplClear">清空选择</view>
    <view class="btn" hover-class="btn-hover" bindtap="tplApply">插入所选{{sel.length?'（'+sel.length+'）':''}}</view>
  </view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup id="privacy" />
</view>
