.wrap { padding-bottom: 40rpx; }
/* ---------- 评分 ---------- */
.scorerow { display: flex; align-items: center; gap: 30rpx; margin-bottom: 24rpx; }
.scorenum {
  font-size: 64rpx; font-weight: 800; flex: none; min-width: 150rpx;
  background: linear-gradient(135deg, #f7a23b, #e8590c);
  -webkit-background-clip: text; color: transparent;
}
.scorenum.low { background: linear-gradient(135deg, #f0a95f, #c0564a); -webkit-background-clip: text; }
.scoreunit { font-size: 26rpx; font-weight: 500; margin-left: 4rpx; }
.scorebar { flex: 1; margin: 0; }
/* ---------- 照片 / 语音 ---------- */
.mediarow { display: flex; gap: 20rpx; }
.mbtn {
  flex: 1; background: #faf9f7; border: 2rpx dashed #e0dcd6;
  border-radius: 22rpx; text-align: center; padding: 34rpx 0;
  font-size: 27rpx; color: #6b655e; white-space: pre-line; line-height: 1.7;
  transition: all 0.15s;
}
.mbtn.has { border-style: solid; border-color: #f0c9a8; background: #fffaf5; color: #e8590c; }
.photogrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }
.ph { position: relative; aspect-ratio: 1; }
.ph image { width: 100%; height: 100%; border-radius: 18rpx; }
.rm {
  position: absolute; right: 10rpx; top: 10rpx; width: 44rpx; height: 44rpx;
  border-radius: 50%; background: rgba(0,0,0,.55); color: #fff;
  text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.audiorow {
  display: flex; align-items: center; gap: 16rpx; background: #fffaf5;
  border: 2rpx solid #f0c9a8; border-radius: 18rpx; padding: 18rpx 22rpx; margin-top: 20rpx;
}
.act { color: #e8590c; font-weight: 600; margin-left: 8rpx; }
.del { color: #c0564a; margin-left: 16rpx; }
/* ---------- 发送 ---------- */
.row2 { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.row2 .btn { flex: 1; }
.hint { text-align: center; font-size: 25rpx; color: #9c948a; background: #f0eeea; border-radius: 18rpx; padding: 20rpx; }
/* ---------- 贴底输入条 ---------- */
.spaceholder { height: 130rpx; }
.notebar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; gap: 14rpx;
  background: #fff; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eceae6;
  box-shadow: 0 -6rpx 24rpx rgba(60, 40, 20, 0.06);
}
.noteinput {
  flex: 1; min-width: 0; height: 76rpx; line-height: 76rpx;
  background: #f0eeea; border-radius: 999rpx; padding: 0 30rpx; font-size: 28rpx;
}
.ph { color: #b8b2aa; }
.barbtn {
  flex: none; font-size: 26rpx; font-weight: 600; color: #4a4a4a;
  background: #f0eeea; border-radius: 999rpx; padding: 16rpx 26rpx;
  display: flex; align-items: center;
}
.badge {
  background: #e8590c; color: #fff; border-radius: 16rpx;
  font-size: 20rpx; padding: 2rpx 12rpx; margin-left: 8rpx;
}
.micbtn {
  flex: none; width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #fdeee2; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.micbtn.rec { background: #e8590c; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
.reclayer {
  position: fixed; left: 0; right: 0; bottom: 130rpx; z-index: 49;
  text-align: center; font-size: 24rpx; color: #e8590c;
}
