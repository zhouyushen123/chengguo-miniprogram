.wrap { padding-bottom: 40rpx; }
/* ---------- 评分 ---------- */
.scorerow { display: flex; align-items: center; gap: 30rpx; margin-bottom: 24rpx; }
.scorenum {
  font-size: 64rpx; font-weight: 800; flex: none; min-width: 150rpx;
  background: linear-gradient(135deg, #A2DCFD, #59A8FF);
  -webkit-background-clip: text; color: transparent;
}
.scorenum.low { background: linear-gradient(135deg, #f0a95f, #E5647E); -webkit-background-clip: text; }
.scoreunit { font-size: 26rpx; font-weight: 500; margin-left: 4rpx; }
.scorebar { flex: 1; margin: 0; }
/* ---------- 照片 / 语音 ---------- */
.mediarow { display: flex; gap: 20rpx; }
.mbtn {
  flex: 1; border: 2rpx dashed transparent;
  border-radius: 26rpx; text-align: center; padding: 34rpx 0;
  font-size: 27rpx; color: #3A4A63; white-space: pre-line; line-height: 1.7;
  transition: all 0.15s; font-weight: 600;
}
.mediarow .mbtn:nth-child(1) { background: #D8FFF0; }
.mediarow .mbtn:nth-child(2) { background: #B4EEDF; }
.mediarow .mbtn:nth-child(3) { background: #F9D5F8; }
.mbtn.has { border-style: solid; border-color: #A9D6F8; background: #F3FAFF; color: #59A8FF; }
.photogrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }
.ph { position: relative; aspect-ratio: 1; }
.ph image { width: 100%; height: 100%; border-radius: 18rpx; }
.rm {
  position: absolute; right: 10rpx; top: 10rpx; width: 44rpx; height: 44rpx;
  border-radius: 50%; background: rgba(0,0,0,.55); color: #fff;
  text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.audiorow {
  display: flex; align-items: center; gap: 16rpx; background: #F3FAFF;
  border: 2rpx solid #A9D6F8; border-radius: 18rpx; padding: 18rpx 22rpx; margin-top: 20rpx;
}
.act { color: #59A8FF; font-weight: 600; margin-left: 8rpx; }
.del { color: #E5647E; margin-left: 16rpx; }
/* ---------- 发送 ---------- */
.row2 { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.row2 .btn { flex: 1; }
.hint { text-align: center; font-size: 25rpx; color: #93A5BE; background: #EFF5FC; border-radius: 18rpx; padding: 20rpx; }
/* ---------- 贴底输入条 ---------- */
.spaceholder { height: 130rpx; }
.notebar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; gap: 14rpx;
  background: #fff; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #E3ECF6;
  box-shadow: 0 -6rpx 24rpx rgba(13, 19, 73, 0.06);
}
.noteinput {
  flex: 1; min-width: 0; height: 76rpx; line-height: 76rpx;
  background: #EFF5FC; border-radius: 999rpx; padding: 0 30rpx; font-size: 28rpx;
}
.ph { color: #A8B8CC; }
.barbtn {
  flex: none; font-size: 26rpx; font-weight: 600; color: #3A4A63;
  background: #EFF5FC; border-radius: 999rpx; padding: 16rpx 26rpx;
  display: flex; align-items: center;
}
.badge {
  background: #59A8FF; color: #fff; border-radius: 16rpx;
  font-size: 20rpx; padding: 2rpx 12rpx; margin-left: 8rpx;
}
.micbtn {
  flex: none; width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #E3F1FF; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.micbtn.rec { background: #59A8FF; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
.reclayer {
  position: fixed; left: 0; right: 0; bottom: 130rpx; z-index: 49;
  text-align: center; font-size: 24rpx; color: #59A8FF;
}

/* ---------- 模板全屏面板 ---------- */
.tplpanel { position: fixed; inset: 0; z-index: 90; background: #F4FAFF; display: flex; flex-direction: column; }
.tplhd {
  display: flex; align-items: center; padding: calc(20rpx + env(safe-area-inset-top)) 28rpx 20rpx;
  background: #fff; border-bottom: 2rpx solid #E3ECF6;
}
.tplback { font-size: 48rpx; font-weight: 300; color: #0D1349; width: 80rpx; }
.tpltitle { flex: 1; text-align: center; font-size: 34rpx; font-weight: 700; }
.tplcount { width: 140rpx; text-align: right; font-size: 24rpx; color: #59A8FF; font-weight: 600; }
.tplbody { flex: 1; padding-top: 24rpx; box-sizing: border-box; }
.tpldim { padding: 24rpx; }
.dimhd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.dimname { font-size: 30rpx; font-weight: 700; color: #0D1349; }
.dimact { font-size: 25rpx; color: #59A8FF; font-weight: 600; padding: 8rpx 0 8rpx 24rpx; }
.optrow {
  display: flex; align-items: center; gap: 18rpx; padding: 22rpx 20rpx;
  background: #F7FBFF; border-radius: 18rpx; margin-bottom: 14rpx;
  border: 2rpx solid transparent; transition: all .15s;
}
.optrow.on { background: #E3F1FF; border-color: #59A8FF; }
.optcheck {
  width: 40rpx; height: 40rpx; border-radius: 50%; flex: none;
  border: 3rpx solid #C9D8EA; color: #fff; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.optrow.on .optcheck { background: #59A8FF; border-color: #59A8FF; }
.opttext { flex: 1; font-size: 27rpx; color: #3A4A63; line-height: 1.55; }
.optacts { display: flex; flex: none; }
.optact { font-size: 23rpx; color: #93A5BE; padding: 8rpx 0 8rpx 18rpx; }
.optact.del { color: #E5647E; }
.tplft {
  display: flex; gap: 20rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 2rpx solid #E3ECF6;
}
.tplft .btn { flex: 1; }
