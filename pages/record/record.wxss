.wrap { padding-bottom: 40rpx; }
/* ---------- 评分 ---------- */
.scorerow { display: flex; align-items: center; gap: 30rpx; margin-bottom: 24rpx; }
.scorenum {
  font-size: 64rpx; font-weight: 800; flex: none; min-width: 150rpx;
  background: linear-gradient(135deg, var(--brand-a), var(--brand));
  -webkit-background-clip: text; color: transparent;
}
.scorenum.low { background: linear-gradient(135deg, #f0a95f, var(--danger)); -webkit-background-clip: text; }
.scoreunit { font-size: 26rpx; font-weight: 500; margin-left: 4rpx; }
.scorebar { flex: 1; margin: 0; }
/* ---------- 照片 / 语音 ---------- */
.mediarow { display: flex; gap: 20rpx; }
.mbtn {
  flex: 1; background: var(--bg); border: 2rpx dashed var(--line-2);
  border-radius: 22rpx; text-align: center; padding: 34rpx 0;
  font-size: 27rpx; color: var(--sub); white-space: pre-line; line-height: 1.7;
  transition: all 0.15s;
}
.mbtn.has { border-style: solid; border-color: var(--brand-border); background: var(--card); color: var(--brand); }
.photogrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }
.ph { position: relative; aspect-ratio: 1; }
.ph image { width: 100%; height: 100%; border-radius: 18rpx; }
.rm {
  position: absolute; right: 10rpx; top: 10rpx; width: 44rpx; height: 44rpx;
  border-radius: 50%; background: var(--mask); color: #fff;
  text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.audiorow {
  display: flex; align-items: center; gap: 16rpx; background: var(--card);
  border: 2rpx solid var(--brand-border); border-radius: 18rpx; padding: 18rpx 22rpx; margin-top: 20rpx;
}
.act { color: var(--brand); font-weight: 600; margin-left: 8rpx; }
.del { color: var(--danger); margin-left: 16rpx; }
/* ---------- 发送 ---------- */
.row2 { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.row2 .btn { flex: 1; }
.hint { text-align: center; font-size: 25rpx; color: var(--muted); background: var(--line); border-radius: 18rpx; padding: 20rpx; }
/* H-23：编辑已发布记录时，把「这是修改、不是再发布一次」说清楚 */
.sentnote { color: var(--brand); background: var(--brand-soft); border-radius: 16rpx; padding: 16rpx 20rpx; }
/* ---------- 卡内课堂评价：多行文本域 + 模板/语音工具行 ---------- */
/* 输入从单行 input 换成 textarea：评价内容较长，需要大面积书写与换行阅读 */
.notearea {
  margin-top: 16rpx;
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 20rpx;
  padding: 22rpx 26rpx;
}
.noteta { width: 100%; min-height: 160rpx; font-size: 28rpx; line-height: 1.7; }
.notetools { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; }
/* 一键清空评语：有文字才出现，点一下（确认后）清空输入框 */
.noteclear { flex: none; width: 34rpx; height: 34rpx; padding: 8rpx; margin-right: 8rpx; }
.notecnt { flex: 1; font-size: 22rpx; color: var(--faint); text-align: right; }
.ph { color: var(--faint); }
.barbtn {
  flex: none; font-size: 26rpx; font-weight: 600; color: var(--text-2);
  background: var(--line); border-radius: 999rpx; padding: 16rpx 26rpx;
  display: flex; align-items: center;
}
.badge {
  background: var(--brand); color: #fff; border-radius: 16rpx;
  font-size: 20rpx; padding: 2rpx 12rpx; margin-left: 8rpx;
}
/* AI 评：品牌色描边以区别于「模板」；忙碌时降透明度并禁用点击感 */
.barbtn.aibtn { color: var(--brand); background: var(--brand-soft); }
.barbtn.aibtn.busy { opacity: 0.5; }
/* 麦克风按钮的形状、按压反馈、录音脉冲统一在 app.wxss（全站通用），本页不另写一套 */
.reclayer {
  margin-top: 14rpx; text-align: center;
  font-size: 24rpx; color: var(--brand);
}

/* ---------- 模板全屏面板 ---------- */
.tplpanel {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  z-index: 90; background: var(--bg);
  display: flex; flex-direction: column; overflow: hidden;
}
.tplhd {
  display: flex; align-items: center; padding: calc(20rpx + env(safe-area-inset-top)) 28rpx 20rpx;
  background: #fff; border-bottom: 2rpx solid var(--line-3);
}
.tplback { font-size: 48rpx; font-weight: 300; color: var(--text); width: 80rpx; }
.tpltitle { flex: 1; text-align: center; font-size: 34rpx; font-weight: 700; }
.tplcount { width: 140rpx; text-align: right; font-size: 24rpx; color: var(--brand); font-weight: 600; }
.tplbody { flex: 1; height: 0; min-height: 0; padding-top: 24rpx; box-sizing: border-box; }
.tpldim { padding: 24rpx; }
.dimhd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.dimname { font-size: 30rpx; font-weight: 700; color: var(--text); }
.dimact { font-size: 25rpx; color: var(--brand); font-weight: 600; padding: 8rpx 0 8rpx 24rpx; }
.optrow {
  display: flex; align-items: center; gap: 18rpx; padding: 22rpx 20rpx;
  background: var(--bg); border-radius: 18rpx; margin-bottom: 14rpx;
  border: 2rpx solid transparent; transition: all .15s;
}
.optrow.on { background: var(--brand-soft); border-color: var(--brand); }
.optcheck {
  width: 40rpx; height: 40rpx; border-radius: 50%; flex: none;
  border: 3rpx solid var(--line-2); color: #fff; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.optrow.on .optcheck { background: var(--brand); border-color: var(--brand); }
.opttext { flex: 1; font-size: 27rpx; color: var(--text-2); line-height: 1.55; }
.optacts { display: flex; flex: none; }
.optact { font-size: 23rpx; color: var(--muted); padding: 8rpx 0 8rpx 18rpx; }
.optact.del { color: var(--danger); }
.tplft {
  display: flex; gap: 20rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 2rpx solid var(--line-3);
}
.tplft .btn { flex: 1; }

/* ---------- 选择学生：折叠与快速搜索 ---------- */
/* .sec 已是 flex（::before 竖杠是第一个子项），标题保持紧贴竖杠，搜索框靠右填充 */
.stuhead .stusearch-wrap { margin-left: auto; display: flex; align-items: center; gap: 8rpx; flex: 1; max-width: 368rpx; }
.stucount { font-size: 22rpx; color: var(--faint); font-weight: 400; margin-left: 8rpx; }
.stusearch {
  flex: 1; max-width: 320rpx; font-size: 24rpx;
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.expander {
  margin-top: 18rpx; text-align: center; font-size: 24rpx; color: var(--brand);
  background: var(--brand-soft); border-radius: 999rpx; padding: 12rpx 0;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.xico { width: 24rpx; height: 24rpx; }
.xico.up { transform: rotate(180deg); }

/* 学生名帖：固定一行 5 个，等宽居中，超长省略 */
.stuchips { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; }
.stuchips .chip {
  padding: 14rpx 0; text-align: center; min-width: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ---------- 媒体按钮线性图标与视频 ---------- */
.mbtn { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.mico { width: 44rpx; height: 44rpx; }
.mihint { font-size: 22rpx; color: var(--faint); font-weight: 400; margin-left: 8rpx; }
.videolist { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 12rpx; }
.vitem { position: relative; border-radius: 12rpx; overflow: hidden; }
.vplayer { width: 100%; height: 320rpx; display: block; background: #000; }
.vitem .rm {
  position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; line-height: 36rpx;
  text-align: center; border-radius: 50%; background: var(--mask); color: #fff; font-size: 28rpx;
}
.aico { width: 32rpx; height: 32rpx; }

/* 评分等级：固定一行 5 档，等宽居中 */
.tagchips { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.tagchips .chip { text-align: center; padding: 14rpx 0; min-width: 0; }

/* 保存中：按钮变淡，视觉上明确"已经收到点击了"，配合 JS 里的同步锁防连点 */
.btn.busy { opacity: .55; }
