<view class="theme-root {{themeCls}}">
<!-- 筛选区：班级 → 日期 → 等级（级联） -->
<view class="filtbar">
  <scroll-view scroll-x class="clsbar">
    <view class="clsrow">
      <view wx:for="{{tabs}}" wx:key="*this" class="chip {{tab===index?'on':''}}" hover-class="btn-hover" bindtap="pickTab" data-i="{{index}}">{{item}}</view>
    </view>
  </scroll-view>
  <view class="pickers">
    <picker mode="selector" range="{{termOpts}}" value="{{termIdx}}" bindchange="onTerm">
      <view class="pkbox">{{termOpts[termIdx]}}<image class="pico" src="{{icoChevD}}" mode="aspectFit" /></view>
    </picker>
    <picker mode="selector" range="{{dateOpts}}" value="{{dateIdx}}" bindchange="onDate">
      <view class="pkbox">{{dateOpts[dateIdx]}}<image class="pico" src="{{icoChevD}}" mode="aspectFit" /></view>
    </picker>
    <picker mode="selector" range="{{tagOpts}}" value="{{tagIdx}}" bindchange="onTag">
      <view class="pkbox">{{tagOpts[tagIdx]}}<image class="pico" src="{{icoChevD}}" mode="aspectFit" /></view>
    </picker>
    <view class="cnt mi">共 {{total}}/{{allCount}} 条</view>
  </view>
</view>
<view class="card rec" wx:for="{{list}}" wx:key="id">
  <view bindtap="openRec" data-rid="{{item.id}}" data-sid="{{item.sid}}">
    <view class="r1"><b>{{item.name}}</b><text class="mi">{{item.course}} · {{item.date}}</text><text class="scoretag">{{item.score}}分{{item.tag ? ' · ' + item.tag : ''}}</text></view>
    <view class="recrow">
      <image wx:if="{{item.photo}}" class="thumb" src="{{item.photo}}" mode="aspectFill" />
      <view class="recinfo">
        <view class="chips" style="margin:0 0 8rpx">
          <text class="pill" style="background:{{item.sent?'var(--sent)':'var(--warn)'}}">{{item.sent?'已发布':'待发布'}}</text>
        </view>
        <view wx:if="{{item.note}}" class="mi note">“{{item.note}}”</view>
        <view class="mi footer"><image class="fico" src="{{icoCamera}}" /> {{item.photoCount}} 张<block wx:if="{{item.hasAudio}}"> · <image class="fico" src="{{icoAudio}}" /> 语音</block></view>
      </view>
    </view>
  </view>
  <view wx:if="{{item.canEdit || item.canSend}}" class="btnrow">
    <view wx:if="{{item.canEdit}}" class="btn ghost" hover-class="btn-hover" catchtap="editRec" data-rid="{{item.id}}">编辑</view>
    <view wx:if="{{item.canSend}}" class="btn send {{item.sent?'off':''}}" hover-class="{{item.sent?'none':'btn-hover'}}" catchtap="sendRec" data-rid="{{item.id}}">{{item.sent?'已发布':'发布到家长端'}}</view>
  </view>
</view>
<view wx:if="{{!list.length}}" class="empty">当前筛选条件下暂无记录</view>
<view wx:if="{{list.length}}" class="note" style="margin:20rpx 24rpx 40rpx">「已发布」表示家长端已可见，家长打开小程序即可查看，目前不会收到微信消息通知。</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup />
</view>
