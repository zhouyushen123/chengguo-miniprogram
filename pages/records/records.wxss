/* 筛选区：班级 chip 行 + 日期/等级下拉
   底部不再留白内边距，改用统一的 24rpx 外边距——
   之前是「24rpx 白内边距 + 24rpx 灰间隙」叠成双倍间距，第一张卡看起来悬在半空 */
/* 筛选区：钉在顶部（吸顶），列表从其下方滚过；底部细分割线与导航栏底边视觉一致 */
.filtbar {
  position: sticky; top: 0; z-index: 20;
  background: #fff; padding: 20rpx 0 0; margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--line);
  box-shadow: 0 6rpx 16rpx var(--shadow);
}
.clsbar { white-space: nowrap; }
.clsrow { display: inline-flex; gap: 16rpx; padding: 0 24rpx; }
.pickers { display: flex; gap: 12rpx; align-items: center; padding: 16rpx 24rpx 16rpx; }
.pkbox {
  font-size: 24rpx; color: var(--sub); background: var(--bg);
  border: 2rpx solid var(--line-2); border-radius: 999rpx; padding: 10rpx 24rpx;
  white-space: nowrap; display: inline-flex; align-items: center; gap: 8rpx;
}
.pico { width: 22rpx; height: 22rpx; }
/* I-06：去掉「共」字后仍要整块不折行，筛选行三个下拉不被挤换行 */
.cnt { margin-left: auto; padding-right: 8rpx; flex: none; white-space: nowrap; }

/* 头行（姓名+课程+分数）通栏；照片下移与评价同行、位于评价左边 */
.recrow { display: flex; gap: 20rpx; margin-top: 12rpx; }
.thumb { width: 160rpx; height: 160rpx; border-radius: 16rpx; flex: none; align-self: flex-start; }
.recinfo { flex: 1; min-width: 0; }
.r1 { display: flex; align-items: center; gap: 12rpx; }
/* 分数与评价合并成一个胶囊标签（如「85分 · 良好」），右上角对齐 */
.scoretag {
  margin-left: auto; flex: none;
  color: var(--brand); background: var(--brand-soft);
  font-weight: 800; font-size: 26rpx;
  padding: 8rpx 20rpx; border-radius: 999rpx;
}
.note { margin-top: 6rpx; }
.footer { margin-top: 6rpx; display: flex; align-items: center; gap: 6rpx; }
.fico { width: 26rpx; height: 26rpx; }

/* 每条记录双按钮：编辑 + 发送给家长（卡片内操作按钮，比全站大按钮小一档） */
.btnrow { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btnrow .btn { flex: 1; padding: 14rpx 0; font-size: 27rpx; border-radius: 18rpx; box-shadow: none; }
.btn.send.off { background: var(--line-2); color: var(--muted); box-shadow: none; }
.empty { text-align: center; color: var(--muted); padding: 120rpx 0; }
