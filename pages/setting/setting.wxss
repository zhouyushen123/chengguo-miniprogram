.hero {
  position: absolute; left: 0; top: 0; width: 100%; height: 220rpx;
  background: linear-gradient(180deg, var(--brand-tint), var(--brand-tint-0));
  pointer-events: none; z-index: 0;
}

/* ---------- 入口列表（与「我的」同一套观感） ---------- */
.menucard { padding: 8rpx 28rpx; position: relative; z-index: 1; }
.mrow {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; border-bottom: 2rpx solid var(--line);
}
.mrow:last-child { border-bottom: none; }
.mrow-hover { opacity: 0.75; }
.mr-t { font-size: 30rpx; font-weight: 600; color: var(--text); }
.mr-d { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; line-height: 1.45; }
.chev {
  width: 18rpx; height: 18rpx; flex: none; margin-left: 18rpx;
  border-top: 4rpx solid var(--faint); border-right: 4rpx solid var(--faint);
  transform: rotate(45deg);
}

/* ---------- 外观（三主题并排，尺寸按 3 列收敛） ---------- */
.skin-t { font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.skins { display: flex; gap: 14rpx; }
.skin {
  flex: 1; min-width: 0; border-radius: 20rpx; padding: 20rpx 18rpx;
  background: var(--chip); border: 3rpx solid transparent;
  transition: all 0.15s; position: relative;
}
.skin.on { background: var(--brand-soft); border-color: var(--brand); }
.skin-dot {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.65);
  margin-bottom: 12rpx;
}
.skin-n { font-size: 26rpx; font-weight: 700; color: var(--text); }
.skin-d { font-size: 21rpx; color: var(--muted); margin-top: 4rpx; }
.skin-cur { margin-top: 8rpx; font-size: 19rpx; font-weight: 700; color: var(--brand); }

.tip {
  margin: 8rpx 40rpx 60rpx; font-size: 23rpx; line-height: 1.6; color: var(--muted);
  padding-bottom: env(safe-area-inset-bottom);
}
