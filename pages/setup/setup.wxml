<view class="theme-root {{themeCls}}">

<!-- 头部：进度条 + 当前步 -->
<view class="hd">
  <view class="slogan">橙果 · 让每一次进步都被看见</view>
  <view class="bar">
    <view class="seg {{step>=1 || done ? 'on' : ''}}"></view>
    <view class="seg {{step>=2 || done ? 'on' : ''}}"></view>
    <view class="seg {{step>=3 || done ? 'on' : ''}}"></view>
    <view class="seg {{step>=4 || done ? 'on' : ''}}"></view>
  </view>
  <view class="steptip">{{done ? '开通完成' : '第 ' + step + ' / 4 步 · ' + steps[step-1].t}}</view>
</view>

<!-- ============ 完成页 ============ -->
<block wx:if="{{done}}">
  <view class="card okcard">
    <view class="okmark">✓</view>
    <view class="oktitle">已经可以开始记录了</view>
    <view class="oklist">
      <view class="okrow"><text class="okk">机构</text><text class="okv">{{summary.org || '—'}}</text></view>
      <view class="okrow"><text class="okk">学期</text><text class="okv">{{summary.term || '—'}}</text></view>
      <view class="okrow"><text class="okk">班级</text><text class="okv">{{summary.cls || '—'}}</text></view>
      <view class="okrow"><text class="okk">学生</text><text class="okv">{{summary.stu}} 位</text></view>
    </view>
    <view class="note">缺的部分（学期/班级/学生）随时能在「管理」里补，不影响现在开始用。</view>
  </view>
  <view class="donebtns">
    <view class="btn" hover-class="btn-hover" bindtap="goRecord">录入第一条成果</view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="goHome">先去首页看看</view>
  </view>
  <view class="later" bindtap="goMgr">去「管理」补全信息</view>
</block>

<!-- ============ 第 1 步：机构 ============ -->
<block wx:elif="{{step===1}}">
  <view class="q">你的机构叫什么？</view>
  <view class="note">这是家长在小程序里看到的机构名，之后能在「机构资料」里改。</view>
  <view class="card">
    <view class="label">机构名称</view>
    <input class="input" placeholder="如：墨白书法工作室" placeholder-class="ph" value="{{org.name}}" bindinput="onOrgName" maxlength="30" />
    <view class="label">机构类型</view>
    <view class="chips">
      <view wx:for="{{types}}" wx:key="*this" class="chip {{org.type===item?'on':''}}" bindtap="pickType" data-v="{{item}}">{{item}}</view>
    </view>
    <view class="label">联系人</view>
    <input class="input" placeholder="你的姓名" placeholder-class="ph" value="{{org.contact}}" bindinput="onContact" maxlength="12" />
    <view class="label">手机号</view>
    <input class="input" type="number" placeholder="11 位手机号" placeholder-class="ph" value="{{org.phone}}" bindinput="onPhone" bindblur="onPhoneBlur" />
    <view wx:if="{{org.phoneBad}}" class="field-err">手机号需 11 位、1 开头，输完会自动分段显示</view>
  </view>
</block>

<!-- ============ 第 2 步：学期 ============ -->
<block wx:elif="{{step===2}}">
  <view class="q">这一期课程什么时候开始？</view>
  <view class="note">学期只是一个时间段（如「2026 秋季学期」），班级挂在学期下面。已经排好了就改成真实日期。</view>
  <view class="card">
    <view class="label">学期名称</view>
    <input class="input" placeholder="如：2026 秋季学期" placeholder-class="ph" value="{{term.name}}" bindinput="onTermName" maxlength="20" />
    <view class="row2">
      <view class="col">
        <view class="label">开始日期</view>
        <picker mode="date" value="{{term.startDate}}" bindchange="onStart">
          <view class="pickerbox">{{term.startDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="col">
        <view class="label">结束日期</view>
        <picker mode="date" value="{{term.endDate}}" bindchange="onEnd">
          <view class="pickerbox">{{term.endDate || '选择日期'}}</view>
        </picker>
      </view>
    </view>
  </view>
</block>

<!-- ============ 第 3 步：班级 ============ -->
<block wx:elif="{{step===3}}">
  <view class="q">先建一个班</view>
  <view class="note">学生都挂在班级下面，录成果也是按班录。后面还能再加班。</view>
  <view class="card">
    <view class="label">班级名称</view>
    <input class="input" placeholder="如：书法提高班" placeholder-class="ph" value="{{cls.name}}" bindinput="onClsName" maxlength="20" />
    <view class="label">第一门课程</view>
    <input class="input" placeholder="如：软笔书法（默认同班级名）" placeholder-class="ph" value="{{cls.course}}" bindinput="onClsCourse" maxlength="20" />
    <view class="note sm">录入成果时要选课程，这里先建一门；后面还能在「管理 · 课程」里加。</view>
    <view class="label">上课方式</view>
    <view class="chips">
      <view wx:for="{{modes}}" wx:key="k" class="chip {{cls.mode===item.k?'on':''}}" bindtap="pickMode" data-v="{{item.k}}">{{item.t}}</view>
    </view>
    <view class="note sm">{{cls.mode==='carry' ? '课时结转：按购买的课时扣减，适合一对一/小班。' : '学期制：按学期上课，不单独算课时。'}}</view>
  </view>
</block>

<!-- ============ 第 4 步：学生 ============ -->
<block wx:elif="{{step===4}}">
  <view class="q">把学生加进来</view>
  <view class="note">学号会自动分配（1001 起），不用自己编。一次可以加好几位。</view>
  <view class="card">
    <view class="label">学生姓名</view>
    <view class="addrow">
      <input class="input grow" placeholder="如：李思远" placeholder-class="ph" value="{{stuName}}" bindinput="onStuName" maxlength="12" />
      <view class="addbtn" hover-class="btn-hover" bindtap="addStudent">添加</view>
    </view>
    <view wx:if="{{added.length}}" class="addedlist">
      <view wx:for="{{added}}" wx:key="id" class="addedrow">
        <text class="addedname">{{item.name}}</text>
        <text class="addedno">学号 {{item.no}}</text>
      </view>
    </view>
    <view wx:else class="emptyline">还没有添加学生</view>
  </view>
</block>

<!-- ============ 底部操作 ============ -->
<view wx:if="{{!done}}" class="foot">
  <view class="btn" hover-class="btn-hover" bindtap="next">{{step===4 ? '完成开通' : '下一步'}}</view>
  <view class="footrow">
    <text wx:if="{{step>1}}" class="link" bindtap="back">上一步</text>
    <text class="link" bindtap="later">稍后再说，先进去看看</text>
  </view>
  <!-- 走错门的兜底：家长被当成老师进来建机构时，这里能拐回邀请码路线 -->
  <view wx:if="{{step===1}}" class="linkjump" bindtap="goJoin">我有邀请码，用邀请码加入机构 ›</view>
</view>

</view>
