<view class="theme-root {{themeCls}}">
  <view class="wrap">

    <!-- 上次落盘失败：一次性提示，让用户知道"那条没存上"不是幻觉 -->
    <view wx:if="{{failed}}" class="card failcard">
      <view class="ft">上次有数据没能存下来</view>
      <view class="fd">存储空间不足时保存会失败。清理一些空间后，请重新保存那一条。</view>
    </view>

    <!-- 结构化数据 -->
    <view class="card">
      <view class="sec"><view class="label">设备存储</view><view class="sechint">{{kvNote}}</view></view>
      <view class="meter"><view class="meter-bar" style="width:{{kvPct}}%"></view></view>
      <view class="mrow"><text class="mk">已占用</text><text class="mv">{{kvText}}</text></view>
      <view class="mrow"><text class="mk">学生</text><text class="mv">{{students}} 人</text></view>
      <view class="mrow"><text class="mk">班级</text><text class="mv">{{classes}} 个</text></view>
      <view class="mrow"><text class="mk">课堂记录</text><text class="mv">{{records}} 条</text></view>
      <view class="hint note">学生、班级与课堂记录都存在这里。照片和视频单独存放，见下。</view>
    </view>

    <!-- 媒体 -->
    <view class="card">
      <view class="sec"><view class="label">课堂照片与视频</view><view class="sechint">{{mdFiles}} 个文件</view></view>
      <view class="meter"><view class="meter-bar" style="width:{{mdPct}}%"></view></view>
      <view class="mrow"><text class="mk">已占用</text><text class="mv">{{mdText}}</text></view>
      <view class="mrow"><text class="mk">可清理</text><text class="mv">{{orphanCount}} 个 · {{orphanText}}</text></view>
      <view wx:if="{{recent}}" class="hint note">另有 {{recent}} 个最近两小时内新建的文件，可能是你正在录入、还没保存的素材，暂不参与清理。</view>
      <view class="btn clean {{orphanCount ? '' : 'idle'}}" hover-class="btn-hover" bindtap="clean">
        {{cleanText}}
      </view>
    </view>

    <!-- 回收站：删掉的东西都在，随时能放回来 -->
    <view class="card">
      <view class="sec"><view class="label">回收站</view><view class="sechint">{{trashCount ? trashCount + ' 项' : '空'}}</view></view>
      <view class="hint note">学生、班级、记录、成员被删除后都会先放进回收站，连同当时一起删掉的内容都能恢复。</view>
      <view class="btn clean" hover-class="btn-hover" bindtap="goTrash">查看最近删除</view>
    </view>

    <!-- 同步被云端拒绝的改动：本地看着改好了，云端没接受 -->
    <view wx:if="{{rejectCount}}" class="card">
      <view class="sec"><view class="label">没同步上去</view><view class="sechint">{{rejectCount}} 项</view></view>
      <view wx:for="{{rejects}}" wx:key="idx" class="hint note">· {{item.msg}}</view>
      <view class="hint note">这些改动只存在这台手机上：云端有硬约束（学号不能重、一个微信只能绑一个成员、机构不能删）。改掉冲突后会自动重试。</view>
      <view class="btn clean" hover-class="btn-hover" bindtap="clearRejects">知道了，隐藏</view>
    </view>

    <!-- 数据体检：学生 / 老师 / 机构之间的引用是否对得上 -->
    <view class="card">
      <view class="sec">
        <view class="label">数据体检</view>
        <view class="sechint">{{auditOk ? '一切正常' : (auditErr + ' 个问题')}}</view>
      </view>
      <view wx:if="{{auditOk}}" class="hint note">学生 {{students}} 人、班级 {{classes}} 个、记录 {{records}} 条，互相引用都对得上。</view>
      <block wx:else>
        <view wx:for="{{auditItems}}" wx:key="k" class="mrow">
          <text class="mk">{{item.title}}</text>
          <text class="mv {{item.level === 'error' ? 'bad' : ''}}">{{item.count}}</text>
        </view>
        <view wx:if="{{fixable}}" class="btn clean" hover-class="btn-hover" bindtap="fixData">修复可自动处理的问题</view>
        <view class="hint note">只摘掉指向已删除数据的引用、给重复或缺失的学号重新发号。学生、老师、机构本身一条都不会删。</view>
      </block>
    </view>

    <!-- 本地备份：核心资产的滚动快照 -->
    <view class="card">
      <view class="sec"><view class="label">本地备份</view><view class="sechint">{{snapHint}}</view></view>
      <view class="hint note">升级前、每天首次打开时会自动备份学生、老师、机构、班级与最近 300 条记录，最多保留 3 份。本机数据读坏时可从这里恢复。</view>
      <view class="btnrow">
        <view class="btn clean" hover-class="btn-hover" bindtap="doBackup">立即备份</view>
        <view class="btn clean {{snapCount ? '' : 'idle'}}" hover-class="btn-hover" bindtap="doRestore">从备份恢复</view>
      </view>
    </view>

    <!-- 云端每日备份：云数据库被改坏时的最后一道保险 -->
    <view wx:if="{{cbShow}}" class="card">
      <view class="sec"><view class="label">云端备份</view><view class="sechint">{{cbHint}}</view></view>
      <view class="hint note">云端每天凌晨 3 点自动把学生、老师、机构、班级与课堂记录打包存一份，保留 30 天。手机上的备份救不了"云端数据被改坏"，这一层才是那种情况的保险；需要找回时在电脑后台「数据安全」里恢复到某一天。</view>
      <view class="btn clean {{cbBusy ? 'idle' : ''}}" hover-class="btn-hover" bindtap="doCloudBackup">
        {{cbBusy ? '正在备份…' : '立刻备份到云端'}}
      </view>
    </view>

    <!-- 本机数据：原始条数 + 回到出厂。数据看着少了时，这一块能分辨"丢了"和"身份对不上" -->
    <view class="card">
      <view class="sec"><view class="label">本机数据</view><view class="sechint">总条数 / 本机构</view></view>
      <view class="mrow" wx:for="{{rawRows}}" wx:key="k">
        <text class="mk">{{item.label}}</text>
        <text class="mv">{{item.all}} / {{item.mine}}</text>
      </view>
      <view class="hint note">左边是这张表的全部条数，右边是当前机构能看到的。两个数不相等说明数据还在、只是挂在别的机构号下；都是 0 才是真的没了。</view>
      <view class="btn clean" hover-class="btn-hover" bindtap="doReset">重置本机数据</view>
      <view class="hint note">重置会清掉这台手机上的全部学生、班级与记录，且不能撤销（云端数据不受影响）。只在"任何操作都提示请先登录"这种坏档时使用，重置后重新走一遍开通向导即可。</view>
    </view>

    <view class="card note">
      <view class="tip">照片和视频存在这台手机上：换手机、清理小程序存储或卸载重装都会丢失。文字评价与分数存在上面几张卡片里，不受影响。</view>
      <view class="tip">视频最占空间（每条约 10–50 MB）。空间紧张时，删掉几条不需要的视频就能腾出很多。</view>
    </view>

  </view>
</view>
