/* 存储空间：一张卡讲一件事（结构化数据 / 媒体），数字要能一眼读出"还要不要管" */
.wrap { padding-bottom: 40rpx; }

/* ---------- 用量条：细、短、不抢戏，只用来表达"离满还有多远" ---------- */
.meter {
  height: 12rpx; margin: 6rpx 0 20rpx;
  background: var(--chip); border-radius: 999rpx; overflow: hidden;
}
.meter-bar {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-a), var(--brand-b));
  transition: width .3s;
}

/* ---------- 数据行 ---------- */
.mrow {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 12rpx 0; border-bottom: 2rpx solid var(--chip);
}
.mrow:last-of-type { border-bottom: none; }
.mk { font-size: 26rpx; color: var(--sub); }
.mv { font-size: 27rpx; font-weight: 700; color: var(--text); }

/* ---------- 区块标题 + 右侧小字 ---------- */
.sec { display: flex; align-items: baseline; justify-content: space-between; }
/* 全局 .label 带 28rpx 上边距，卡片内部的区块标题不需要 */
.sec .label { margin: 0; }
.sechint { font-size: 23rpx; color: var(--faint); }

.hint { margin-top: 14rpx; font-size: 23rpx; color: var(--muted); line-height: 1.65; }

/* ---------- 清理按钮 ---------- */
.clean { margin-top: 22rpx; }
.clean.idle { background: var(--chip); color: var(--muted); box-shadow: none; font-weight: 600; }

/* ---------- 上次保存失败 ---------- */
.failcard { background: var(--danger-soft, var(--brand-soft)); }
.ft { font-size: 28rpx; font-weight: 800; color: var(--danger); }
.fd { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); line-height: 1.65; }

/* ---------- 底部说明（note 淡黄说明条，见 app.wxss） ---------- */
.tip {
  font-size: 24rpx; color: var(--text-2); line-height: 1.7;
  padding: 6rpx 0;
}

/* ---------- 数据体检 ---------- */
.bad { color: var(--danger); }
/* 两层检查之间的分隔：一条细线，不要做成两个卡片（会让人以为要去两个地方看） */
.sep { height: 2rpx; margin: 24rpx 0 8rpx; background: var(--chip); }
.btnrow { display: flex; gap: 16rpx; margin-top: 22rpx; }
.btnrow .btn { flex: 1; margin-top: 0; }
