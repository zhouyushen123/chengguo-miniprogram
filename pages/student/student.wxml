<view wx:if="{{s}}" class="wrap">
  <view class="card">
    <view class="sturow">
      <view class="ava">
        <image wx:if="{{s.photo}}" src="{{s.photo}}" mode="aspectFill" />
        <text wx:else>{{s.name[0]}}</text>
      </view>
      <view class="stuinfo">
        <view class="h1">{{s.name}}</view>
        <view class="mi">{{s.meta}}{{s.wechat?' · 微信 '+s.wechat:''}}</view>
      </view>
      <view class="chip" bindtap="goProfile">资料</view>
    </view>
  </view>

  <!-- 语音条（自定义，替代原生 audio 的"未知歌曲"显示） -->
  <template name="voicebar">
    <view class="voicebar" hover-class="btn-hover" bindtap="toggleAudio" data-key="{{vk}}" data-src="{{vsrc}}">
      <view class="vbtn">
        <image src="{{playing===vk?icoPause:icoPlay}}" mode="aspectFit" />
      </view>
      <view class="vmeta">
        <view class="vt1">{{teacher}}的课堂语音</view>
        <view class="vt2">{{playing===vk?'正在播放…':'点击播放'}}</view>
      </view>
    </view>
  </template>

  <!-- 指定记录（从记录列表点入） -->
  <view wx:if="{{rec}}" class="card">
    <view class="r1"><b>{{rec.course}}</b><text class="mi">{{rec.date}}</text><text class="score">{{rec.score}}分</text></view>
    <view class="chips" style="margin:12rpx 0">
      <text wx:if="{{rec.tag}}" class="pill" style="background:#e8590c">{{rec.tag}}</text>
      <text class="pill" style="background:{{rec.sent?'#3a9e5f':'#b8860b'}}">{{rec.sent?'已发送':'待发送'}}</text>
    </view>
    <view class="photogrid {{photoCls}}">
      <image wx:for="{{photoUrls}}" wx:key="*this" src="{{item}}" mode="{{photoCls==='pg1'?'aspectFit':'aspectFill'}}" bindtap="previewPhoto" data-i="{{index}}" />
    </view>
    <view class="videolist">
      <video wx:for="{{videoUrls}}" wx:key="*this" class="vplayer" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
    </view>
    <view class="notegroups">
      <view class="mi nline" wx:for="{{rec.noteLines}}" wx:key="index"><text wx:if="{{item.label}}" class="nlabel">{{item.label}}：</text><text class="ntext">{{item.text}}</text></view>
    </view>
    <template is="voicebar" wx:if="{{rec.audio}}" data="{{vk:'rec', vsrc:rec.audio, playing, teacher, icoPlay, icoPause}}" />
  </view>

  <!-- 筛选 + 最近一次详情 + 历史列表 -->
  <block wx:if="{{!rec}}">
    <view wx:if="{{filters.length > 1}}" class="filterbar">
      <view class="fchip {{filt===item?'on':''}}" wx:for="{{filters}}" wx:key="*this" bindtap="pickFilter" data-f="{{item}}">{{item}}</view>
      <text class="fcount">{{shown}} 条</text>
    </view>

    <view wx:if="{{latest}}" class="card">
      <view class="dimhead">
        <text class="pill" style="background:#e8590c">{{filt==='全部'?'最近一次':filt+' · 最近'}}</text>
        <text class="mi">{{latest.date}}</text>
        <text class="score">{{latest.score}}分</text>
      </view>
      <view class="chips" style="margin:12rpx 0">
        <text wx:if="{{latest.tag}}" class="pill" style="background:#3a9e5f">{{latest.tag}}</text>
        <text class="pill" style="background:{{latest.sent?'#3a9e5f':'#b8860b'}}">{{latest.sent?'已发送':'待发送'}}</text>
      </view>
      <view class="photogrid {{photoCls}}">
        <image wx:for="{{photoUrls}}" wx:key="*this" src="{{item}}" mode="{{photoCls==='pg1'?'aspectFit':'aspectFill'}}" bindtap="previewPhoto" data-i="{{index}}" />
      </view>
      <view class="videolist">
        <video wx:for="{{videoUrls}}" wx:key="*this" class="vplayer" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
      </view>
      <view class="notegroups">
        <view class="mi nline" wx:for="{{latest.noteLines}}" wx:key="index"><text wx:if="{{item.label}}" class="nlabel">{{item.label}}：</text><text class="ntext">{{item.text}}</text></view>
      </view>
      <template is="voicebar" wx:if="{{latest.audio}}" data="{{vk:'latest', vsrc:latest.audio, playing, teacher, icoPlay, icoPause}}" />
    </view>
    <view wx:else class="card mi">{{total?'该课程暂无记录':'暂无课程记录'}}</view>

    <view class="card" wx:if="{{history.length}}">
      <view class="label">历史课程 · {{history.length}} 条</view>
      <block wx:for="{{history}}" wx:key="id">
        <view class="hist" hover-class="btn-hover" bindtap="toggleExpand" data-rid="{{item.id}}">
          <view class="hleft">
            <b>{{item.course}}</b>
            <view class="mi">{{item.date}} · {{item.score}}分 {{item.tag?'· '+item.tag:''}}</view>
          </view>
          <text wx:if="{{!item.sent}}" class="pill" style="background:#b8860b">待发送</text>
          <view class="chev {{expandId===item.id?'up':''}}">›</view>
        </view>
        <!-- 行内展开：照片/视频在前，课程评价在后 -->
        <view wx:if="{{expandId===item.id}}" class="histdetail">
          <view class="chips" style="margin:0 0 12rpx">
            <text wx:if="{{item.tag}}" class="pill" style="background:#e8590c">{{item.tag}}</text>
            <text class="pill" style="background:{{item.sent?'#3a9e5f':'#b8860b'}}">{{item.sent?'已发送':'待发送'}}</text>
          </view>
          <view class="photogrid {{item.pcls}}" wx:if="{{item.photos.length}}">
            <image wx:for="{{item.photos}}" wx:for-item="ph" wx:key="*this" src="{{ph}}" mode="{{item.pcls==='pg1'?'aspectFit':'aspectFill'}}" />
          </view>
          <view class="videolist" wx:if="{{item.videos.length}}">
            <video wx:for="{{item.videos}}" wx:for-item="vd" wx:key="*this" class="vplayer" src="{{vd}}" object-fit="cover" controls show-center-play-btn></video>
          </view>
          <view class="notegroups">
            <view class="mi nline" wx:for="{{item.noteLines}}" wx:for-item="line" wx:key="index"><text wx:if="{{line.label}}" class="nlabel">{{line.label}}：</text><text class="ntext">{{line.text}}</text></view>
          </view>
          <template is="voicebar" wx:if="{{item.audio}}" data="{{vk:'h'+item.id, vsrc:item.audio, playing, teacher, icoPlay, icoPause}}" />
        </view>
      </block>
    </view>
  </block>

  <view class="btn" bindtap="goRecord">＋ 记录本节成果</view>
</view>
