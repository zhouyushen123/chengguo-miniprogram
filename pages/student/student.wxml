<view class="theme-root {{themeCls}}">
<view wx:if="{{s}}" class="wrap">
  <!-- 个人卡：头像 + 姓名 + 班级/家长 + 三项统计 -->
  <view class="card">
    <view class="sturow">
      <ava src="{{s.photo}}" name="{{s.name}}" size="{{88}}" radius="{{24}}" />
      <view class="stuinfo">
        <view class="h1">{{s.name}}<text wx:if="{{s.no}}" class="sno">学号 {{s.no}}</text></view>
        <view class="mi">{{s.meta}}{{s.parent?' · 家长：'+s.parent:''}}{{s.wechat?' · 微信 '+s.wechat:''}}</view>
      </view>
      <view class="chip {{!profileFilled ? 'chip-warn' : ''}}" bindtap="goProfile">资料{{!profileFilled ? ' · 待填写' : ''}}</view>
    </view>
    <view wx:if="{{stats}}" class="stats">
      <text class="stat st-c">{{stats.lessons}} 节课</text>
      <text class="stat st-g">优秀 {{stats.great}} 次</text>
      <text class="stat st-d">{{stats.days}} 个学习日</text>
      <text wx:if="{{hasCarry}}" class="stat st-h">剩余 {{hoursRemain}} 课时</text>
    </view>
  </view>

  <!-- 语音条（自定义，替代原生 audio 的"未知歌曲"显示） -->
  <template name="voicebar">
    <view class="voicebar" hover-class="btn-hover" bindtap="toggleAudio" data-key="{{vk}}" data-src="{{vsrc}}">
      <view class="vbtn">
        <image src="{{playing===vk?icoPause:icoPlay}}" mode="aspectFit" />
      </view>
      <view class="vmeta">
        <view class="vt1">{{teacher}}的课堂语音</view>
        <view class="vt2">{{playing===vk?'正在播放…':'点击播放'}}</view>
      </view>
    </view>
  </template>

  <!-- 照片轮播：自动播放；宽度铺满、高度按真实宽高比自适应（pswH 由 JS 计算） -->
  <template name="photoswiper">
    <swiper class="pswiper" style="height:{{pswH}}rpx" autoplay="{{swAuto}}" interval="4000" circular="{{photoUrls.length > 1}}"
      indicator-dots="{{photoUrls.length > 1}}" bindtouchstart="swTouchStart" bindtouchend="swTouchEnd">
      <swiper-item wx:for="{{photoUrls}}" wx:key="*this">
        <image src="{{item}}" mode="widthFix" bindtap="previewPhoto" data-i="{{index}}" />
      </swiper-item>
    </swiper>
  </template>

  <!-- 指定记录（从记录列表点入） -->
  <view wx:if="{{rec}}" class="card">
    <view class="dimhead">
      <text class="lcourse">{{rec.course}}</text>
      <text class="pill" style="background:{{rec.sent?'var(--sent)':'var(--warn)'}}">{{rec.sent?'已发布':'待发布'}}</text>
      <view class="dhr">
        <text class="mi">{{rec.clsName}} · {{rec.date}}{{rec.sess ? ' · 第' + rec.sess + '课' : ''}}</text>
        <text wx:if="{{rec.tag}}" class="badge {{rec.tcls}}">{{rec.tag}}</text>
      </view>
    </view>
    <template is="photoswiper" wx:if="{{photoUrls.length}}" data="{{photoUrls, swAuto, pswH}}" />
    <view class="videolist">
      <video wx:for="{{videoUrls}}" wx:key="*this" class="vplayer" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
    </view>
    <view class="notegroups">
      <view class="mi nline" wx:for="{{rec.noteLines}}" wx:key="index"><text wx:if="{{item.label}}" class="nlabel">{{item.label}}：</text><text class="ntext">{{item.text}}</text></view>
    </view>
    <template is="voicebar" wx:if="{{rec.audio}}" data="{{vk:'rec', vsrc:rec.audio, playing, teacher, icoPlay, icoPause}}" />
    <view wx:if="{{rec.canEdit}}" class="chips" style="margin:12rpx 0 0">
      <text class="pill" style="background:var(--brand);color:#fff" hover-class="btn-hover" bindtap="editRec" data-rid="{{rec.id}}">修改这条记录</text>
    </view>
    <!-- 家长留言：只有家长 + 云通 + 已发布才出现；老师看自己的记录不需要这块 -->
    <view wx:if="{{fbOn && rec.sent}}" class="fbbox">
      <view class="fbbtn" hover-class="btn-hover" bindtap="openNote" data-rid="{{rec.id}}" data-course="{{rec.course}}" data-date="{{rec.date}}">
        {{fbCard.length ? '给老师留句话 · 我已留 ' + fbCard.length + ' 条' : '给老师留句话'}}
      </view>
      <view wx:for="{{fbCard}}" wx:key="id" class="fbn">
        <view class="fbnt">{{item.text}}</view>
        <view class="mi">{{item.time}} · {{item.handled ? '老师已看' : '已送达，等老师看'}}</view>
      </view>
    </view>
  </view>

  <!-- 班级筛选 + 课程页签 + 最近一次详情 + 评价汇总 + 历史列表 -->
  <block wx:if="{{!rec}}">
    <!-- 班级筛选：学生跨多班时出现 -->
    <view wx:if="{{clsFilters.length > 1}}" class="filterbar">
      <view class="fchip {{clsF==item.k?'on':''}}" wx:for="{{clsFilters}}" wx:key="k" bindtap="pickCls" data-k="{{item.k}}">{{item.n}}</view>
    </view>

    <!-- 课程页签：下划线式，同设计稿 -->
    <view wx:if="{{filters.length > 1}}" class="ctabs">
      <view class="ctab {{filt===item?'on':''}}" wx:for="{{filters}}" wx:key="*this" bindtap="pickFilter" data-f="{{item}}">{{item==='全部'?'全部课程':item}}</view>
      <text class="fcount">{{shown}} 条</text>
    </view>

    <view wx:if="{{latest}}" class="card">
      <view class="dimhead">
        <text class="pill pill-o">{{filt==='全部'?'最近一次':filt}}</text>
        <text class="lcourse">{{latest.course}}</text>
        <text class="pill" style="background:{{latest.sent?'var(--sent)':'var(--warn)'}}">{{latest.sent?'已发布':'待发布'}}</text>
        <view class="dhr">
          <text class="mi">{{latest.clsName}} · {{latest.date}}{{latest.sess ? ' · 第' + latest.sess + '课' : ''}}</text>
          <text wx:if="{{latest.tag}}" class="badge {{latest.tcls}}">{{latest.tag}}</text>
        </view>
      </view>
      <view wx:if="{{!photoUrls.length && !videoUrls.length}}" class="mi nofarm">本次还没有拍照片或录音 📷</view>
      <template is="photoswiper" wx:if="{{photoUrls.length}}" data="{{photoUrls, swAuto, pswH}}" />
      <view class="videolist">
        <video wx:for="{{videoUrls}}" wx:key="*this" class="vplayer" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
      </view>
      <view class="notegroups">
        <view class="mi nline" wx:for="{{latest.noteLines}}" wx:key="index"><text wx:if="{{item.label}}" class="nlabel">{{item.label}}：</text><text class="ntext">{{item.text}}</text></view>
      </view>
      <template is="voicebar" wx:if="{{latest.audio}}" data="{{vk:'latest', vsrc:latest.audio, playing, teacher, icoPlay, icoPause}}" />
      <view wx:if="{{latest.canEdit}}" class="chips" style="margin:12rpx 0 0">
        <text class="pill" style="background:var(--brand);color:#fff" hover-class="btn-hover" bindtap="editRec" data-rid="{{latest.id}}">修改这条记录</text>
      </view>
      <!-- 家长留言：对最近这次课给老师留句话（已发布才显示） -->
      <view wx:if="{{fbOn && latest.sent}}" class="fbbox">
        <view class="fbbtn" hover-class="btn-hover" bindtap="openNote" data-rid="{{latest.id}}" data-course="{{latest.course}}" data-date="{{latest.date}}">
          {{fbCard.length ? '给老师留句话 · 我已留 ' + fbCard.length + ' 条' : '给老师留句话'}}
        </view>
        <view wx:for="{{fbCard}}" wx:key="id" class="fbn">
          <view class="fbnt">{{item.text}}</view>
          <view class="mi">{{item.time}} · {{item.handled ? '老师已看' : '已送达，等老师看'}}</view>
        </view>
      </view>
      <!-- 评价汇总：当前筛选范围内各档评价次数 -->
      <view wx:if="{{tagCounts.length}}" class="tagsum">
        <view class="mi ts-title">评价汇总</view>
        <view class="chips">
          <text wx:for="{{tagCounts}}" wx:key="t" class="badge {{item.cls}}">{{item.t}} × {{item.n}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="card mi">{{total?'该课程暂无记录':'暂无课程记录'}}</view>

    <view class="card" wx:if="{{history.length}}">
      <view class="histhead">
        <view class="label">历史课程</view>
        <text class="mi">共 {{history.length}} 条</text>
      </view>
      <block wx:for="{{history}}" wx:key="id">
        <view class="hist" hover-class="btn-hover" bindtap="toggleExpand" data-rid="{{item.id}}">
          <view class="hleft">
            <view class="ht1"><b>{{item.course}}</b><text wx:if="{{item.tag}}" class="badge {{item.tcls}}">{{item.tag}}</text></view>
            <view class="mi">{{item.clsName}} · {{item.date}}{{item.sess ? ' · 第' + item.sess + '课' : ''}} · {{item.score}}分{{item.snip?' · '+item.snip:''}}</view>
          </view>
          <view class="hright">
            <view wx:if="{{item.pcnt}}" class="hcam"><image class="camico" src="{{icoCam}}" mode="aspectFit" />{{item.pcnt}}</view>
            <text wx:if="{{!item.sent}}" class="pill" style="background:var(--warn)">待发布</text>
            <image class="chev {{expandId===item.id?'up':''}}" src="{{icoChev}}" mode="aspectFit" />
          </view>
        </view>
        <!-- 行内展开：照片/视频在前，课程评价在后 -->
        <view wx:if="{{expandId===item.id}}" class="histdetail">
          <view class="chips" style="margin:0 0 12rpx">
            <text class="pill" style="background:{{item.sent?'var(--sent)':'var(--warn)'}}">{{item.sent?'已发布':'待发布'}}</text>
            <text wx:if="{{item.canEdit}}" class="pill" style="background:var(--brand);color:#fff" hover-class="btn-hover" bindtap="editRec" data-rid="{{item.id}}">修改这条</text>
            <text wx:if="{{fbOn && item.sent}}" class="pill" style="background:var(--brand-soft);color:var(--brand)" hover-class="btn-hover" bindtap="openNote" data-rid="{{item.id}}" data-course="{{item.course}}" data-date="{{item.date}}">给老师留句话</text>
          </view>
          <view class="photogrid {{item.pcls}}" wx:if="{{item.photos.length}}">
            <image wx:for="{{item.photos}}" wx:for-item="ph" wx:key="*this" src="{{ph}}" mode="{{item.pcls==='pg1'?'aspectFit':'aspectFill'}}" />
          </view>
          <view class="videolist" wx:if="{{item.videos.length}}">
            <video wx:for="{{item.videos}}" wx:for-item="vd" wx:key="*this" class="vplayer" src="{{vd}}" object-fit="cover" controls show-center-play-btn></video>
          </view>
          <view class="notegroups">
            <view class="mi nline" wx:for="{{item.noteLines}}" wx:for-item="line" wx:key="index"><text wx:if="{{line.label}}" class="nlabel">{{line.label}}：</text><text class="ntext">{{line.text}}</text></view>
          </view>
          <template is="voicebar" wx:if="{{item.audio}}" data="{{vk:'h'+item.id, vsrc:item.audio, playing, teacher, icoPlay, icoPause}}" />
        </view>
      </block>
    </view>
  </block>

  <view class="btn cta" bindtap="goRecord"><image class="bico" src="{{icoPlus}}" mode="aspectFit" />记录本节成果</view>
  <view class="slogan">橙果 · 让每一次进步都被看见</view>
</view>

<!-- 家长留言弹层：写一句给老师（文字或麦克风转文字），下方列出自己在这条成果下说过的话 -->
<view wx:if="{{fbSheet}}" class="fbmask" catchtap="closeNote">
  <view class="fbsheet" catchtap="noop">
    <view class="fbhead">
      <view class="fbh">给老师留句话</view>
      <view class="mi">{{fbCourse}}{{fbDate ? ' · ' + fbDate : ''}}</view>
    </view>
    <view class="vin">
      <textarea class="fbin vin-in" maxlength="200" auto-height cursor-spacing="24"
        placeholder="感谢、建议或疑问都可以，老师会看到" placeholder-class="ph"
        value="{{fbText}}" bindinput="onFbInput"></textarea>
      <image class="vmic {{micKey==='fbText'?'rec':''}}" src="{{micKey==='fbText'?icoWhite:icoMic}}"
        mode="aspectFit" catchtap="onFbMic" />
    </view>
    <view class="fbrow">
      <text class="mi">{{fbText.length}}/200</text>
      <text wx:if="{{fbErr}}" class="fberr">{{fbErr}}</text>
    </view>
    <view class="fbbtns">
      <view class="btn ghost" hover-class="btn-hover" catchtap="closeNote">先不写</view>
      <view class="btn {{fbBusy?'off':''}}" hover-class="btn-hover" catchtap="sendNote">{{fbBusy ? '发送中…' : '发给老师'}}</view>
    </view>
    <view wx:if="{{fbNotes.length}}" class="fblist">
      <view class="label">我在这条成果下说过</view>
      <view wx:for="{{fbNotes}}" wx:key="id" class="fbn">
        <view class="fbnt">{{item.text}}</view>
        <view class="mi">{{item.time}} · {{item.handled ? '老师已看' : '已送达，等老师看'}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup />
</view>
