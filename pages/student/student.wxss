.sturow { display: flex; align-items: center; gap: 20rpx; }
.stuinfo { flex: 1; }
.r1 { display: flex; align-items: center; gap: 12rpx; }
.score { margin-left: auto; color: #e8590c; font-weight: 800; font-size: 34rpx; }
.dimhead { display: flex; align-items: center; gap: 12rpx; }
.notegroups { background: #faf9f7; border-radius: 16rpx; padding: 16rpx 20rpx; margin: 12rpx 0; }
.photogrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 8rpx; }
.photogrid image { width: 100%; aspect-ratio: 1; border-radius: 12rpx; }
.hist { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f5f3f0; }
.hist:last-child { border-bottom: none; }
.hleft { flex: 1; }
.chev { color: #c9c4bd; font-size: 36rpx; }
/* 筛选条 */
.filterbar { display: flex; align-items: center; gap: 12rpx; margin: 0 24rpx 16rpx; flex-wrap: wrap; }
.fchip {
  font-size: 24rpx; color: #6b655e; background: #fff;
  border-radius: 999rpx; padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 40, 20, 0.05);
}
.fchip.on { background: #e8590c; color: #fff; font-weight: 600; }
.fcount { margin-left: auto; font-size: 22rpx; color: #b8b2aa; }

/* 视频详情展示 */
.videolist { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 8rpx; }
.vplayer { width: 100%; height: 320rpx; display: block; background: #000; border-radius: 12rpx; }
