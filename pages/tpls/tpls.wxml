<view class="theme-root {{themeCls}}">
<view wx:if="{{mode==='preview'}}" class="wrap">
  <view class="card">
    <view class="label">家长收到的通知文本</view>
    <view class="prebox">{{previewText}}</view>
  </view>
  <view class="card" style="margin-top:20rpx">
    <view class="label">随记录一起发送的{{pvPhotos.length ? '照片' : ''}}{{pvPhotos.length && pvVideos.length ? '、' : ''}}{{pvVideos.length ? '视频' : ''}}{{(pvPhotos.length || pvVideos.length) && pvAudio ? '、' : ''}}{{pvAudio ? '语音' : ''}}</view>
    <view wx:if="{{pvPhotos.length}}" class="pvgrid">
      <image wx:for="{{pvPhotos}}" wx:key="*this" class="pvph" src="{{item}}" mode="aspectFill" bindtap="pvPhoto" data-i="{{index}}" />
    </view>
    <view wx:if="{{pvVideos.length}}" class="pvvideos">
      <video wx:for="{{pvVideos}}" wx:key="*this" class="pvvideo" src="{{item}}" object-fit="cover" controls show-center-play-btn></video>
    </view>
    <view wx:if="{{pvAudio}}" class="pvaudio">
      <image class="pvaico" src="{{icoAudio}}" mode="aspectFit" />
      <text class="pvatxt">课堂语音点评</text>
      <text class="pvaplay" bindtap="pvPlayAudio">播放</text>
    </view>
    <view wx:if="{{!hasMedia}}" class="pvhint">本条记录还没添加照片、视频或语音，只有文字内容</view>
  </view>
  <view class="btn copybtn" bindtap="copyPreview">一键复制，发给家长</view>
</view>

<view wx:else class="wrap">
  <view wx:if="{{mode==='select'}}" class="tip note">点选项可多选，选完点底部「插入所选」</view>
  <view class="card" wx:for="{{groups}}" wx:key="i">
    <view class="dimhead">
      <view class="dimname">{{item.n}}<text class="mi"> · {{item.opts.length}}项</text></view>
      <view wx:if="{{canEdit}}" class="mini mic" bindtap="voiceOpt" data-i="{{item.i}}"><image class="tico" src="{{icoMic}}" mode="aspectFit" /></view>
      <view wx:if="{{canEdit}}" class="mini add" bindtap="addOpt" data-i="{{item.i}}"><image class="tico s" src="{{icoPlus}}" mode="aspectFit" />新增</view>
    </view>
    <view class="opt" wx:for="{{item.opts}}" wx:for-item="o" wx:key="j">
      <view class="optmain {{o.on?'on':''}}" bindtap="toggleOpt" data-k="{{item.i}}:{{o.j}}">{{o.on?'✓ ':''}}{{o.o}}</view>
      <view wx:if="{{canEdit}}" class="mini" bindtap="editOpt" data-i="{{item.i}}" data-j="{{o.j}}"><image class="tico" src="{{icoEdit}}" mode="aspectFit" /></view>
      <view wx:if="{{canEdit}}" class="mini del" bindtap="delOpt" data-i="{{item.i}}" data-j="{{o.j}}"><image class="tico" src="{{icoClose}}" mode="aspectFit" /></view>
    </view>
  </view>

  <view wx:if="{{mode==='select'}}" class="footbar">
    <view class="btn ghost footbtn" bindtap="clearSel">清空选择</view>
    <view class="btn footbtn" bindtap="confirmSel">插入所选{{sel.length?'（'+sel.length+'）':''}}</view>
  </view>
</view>

<!-- 隐私授权弹窗（全局组件，首次使用前必须同意） -->
<privacy-popup />
</view>
