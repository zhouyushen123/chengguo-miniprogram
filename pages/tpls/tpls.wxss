.wrap { padding-bottom: 160rpx; }
.tip { margin: 24rpx; color: var(--muted); font-size: 25rpx; }
.dimhead { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.dimname { font-size: 29rpx; font-weight: 700; flex: 1; }
.mini { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: var(--line); color: var(--text-2); display: inline-flex; align-items: center; gap: 6rpx; }
.tico { width: 30rpx; height: 30rpx; }
.tico.s { width: 24rpx; height: 24rpx; }
.mini.del { color: var(--danger); }
.mini.del .tico { width: 26rpx; height: 26rpx; }
.mini.mic { background: var(--brand-soft); color: var(--brand); }
.mini.add { background: var(--brand-soft); color: var(--brand); }
.opt { display: flex; align-items: center; gap: 14rpx; margin-bottom: 12rpx; }
.optmain { flex: 1; font-size: 27rpx; padding: 18rpx 24rpx; border-radius: 20rpx; background: var(--bg); border: 2rpx solid var(--line-2); color: var(--text-2); }
.optmain.on { background: var(--brand-soft); border-color: var(--brand); color: var(--brand); font-weight: 600; }
.footbar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid var(--line); }
.footbtn { flex: 1; }
.prebox { background: var(--bg); border-radius: 20rpx; padding: 24rpx; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; }
/* 预览页的复制按钮：裸 .btn 没有边距会通栏，与卡片左右边距（24rpx）对齐 */
.copybtn { margin: 0 24rpx; }
/* ---------- 预览页媒体区（与录入页同款视觉） ---------- */
.pvgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }
.pvph { width: 100%; aspect-ratio: 1; border-radius: 16rpx; background: var(--line); }
.pvvideos { margin-top: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.pvvideo { width: 100%; height: 320rpx; border-radius: 16rpx; background: #000; }
.pvaudio {
  margin-top: 20rpx; display: flex; align-items: center; gap: 14rpx;
  background: var(--bg); border: 2rpx solid var(--line-2); border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.pvaico { width: 32rpx; height: 32rpx; flex: none; }
.pvatxt { flex: 1; font-size: 27rpx; color: var(--text-2); }
.pvaplay { font-size: 27rpx; color: var(--brand); font-weight: 600; }
.pvhint { margin-top: 20rpx; font-size: 24rpx; color: var(--faint); }
/* H-20 家长视角成果卡：头像 / 姓名 / 课程 / 分数档位 / 评语全文 / 媒体 */
.pvwrap { padding-bottom: 60rpx; }
.pvtip { margin: 24rpx 24rpx 12rpx; }
.pvcard { margin: 0 24rpx; }
.pvhead { display: flex; align-items: center; gap: 20rpx; }
.pvheadtxt { flex: 1; min-width: 0; }
.pvname { font-size: 32rpx; font-weight: 700; color: var(--text-2); }
.pvscore { flex: none; text-align: center; background: var(--brand-soft); border-radius: 20rpx; padding: 12rpx 20rpx; }
.pvnum { font-size: 44rpx; font-weight: 800; color: var(--brand); }
.pvunit { font-size: 22rpx; color: var(--brand); margin-left: 4rpx; }
.pvtag { display: inline-block; margin-top: 20rpx; padding: 8rpx 24rpx; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 24rpx; font-weight: 600; }
.pvsect { margin-top: 28rpx; }
.pvnote { font-size: 28rpx; line-height: 1.8; color: var(--text-2); margin-bottom: 8rpx; white-space: pre-wrap; }
.pvfoot { margin-top: 28rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); text-align: center; font-size: 22rpx; color: var(--faint); }
.pvplain { margin: 24rpx; }
.copybtn2 { margin-top: 20rpx; }
