.wrap { padding: 24rpx 24rpx 60rpx; }

.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; overflow-x: auto; white-space: nowrap; }
.tab {
  flex: none; padding: 12rpx 26rpx; border-radius: 999rpx;
  background: #fff; color: var(--muted); font-size: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.tab.on { background: var(--brand); color: #fff; border-color: var(--brand); font-weight: 600; }

.hint { font-size: 24rpx; color: var(--muted); line-height: 1.7; margin: 8rpx 6rpx 18rpx; }

.list { padding: 0 24rpx; }
.row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.row:last-child { border-bottom: none; }
.info { flex: 1; min-width: 0; }
.title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.sub { font-size: 25rpx; color: var(--muted); margin-top: 6rpx; }
.meta { font-size: 23rpx; color: var(--muted); opacity: 0.8; margin-top: 6rpx; }

.btn.small {
  flex: none; width: auto; padding: 0 30rpx; height: 64rpx;
  font-size: 26rpx; margin: 0; border-radius: 999rpx;
}

.empty { padding: 120rpx 40rpx; text-align: center; }
.etitle { font-size: 32rpx; font-weight: 600; color: var(--text); }
.ehint { font-size: 25rpx; color: var(--muted); margin-top: 12rpx; line-height: 1.7; }
