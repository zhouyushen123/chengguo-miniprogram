/* pkg-low/lessons/lessons.wxss —— 课次管理（继承全局卡片/按钮/主题变量） */

.listwrap { padding-bottom: 170rpx; }

/* 学期分组头（沿用 terms 页的行结构） */
.trow { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.tmain { flex: 1; min-width: 0; }
.t1 { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.t1 b { font-size: 30rpx; }
.t2 { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
.btn.sm { font-size: 24rpx; padding: 10rpx 22rpx; }

.pill { font-size: 20rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 999rpx; flex: none; }
.pill-active { color: var(--ok); background: var(--ok-soft); }
.pill-draft { color: var(--sub); background: var(--chip); }
.pill-upd { color: var(--warn, #b7791f); background: var(--brand-tint); }

/* 错乱提示条：点一下弹重排确认 */
.disorder {
  margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 14rpx;
  background: var(--brand-tint); border: 2rpx solid var(--brand-border);
  display: flex; align-items: center; justify-content: space-between;
}
.dis-t { font-size: 24rpx; color: var(--sub); }
.dis-b { font-size: 24rpx; color: var(--brand); font-weight: 700; }

/* 课次行 */
.lsnrow {
  display: flex; align-items: flex-start; gap: 12rpx;
  padding: 20rpx 0; border-bottom: 2rpx solid var(--line);
}
.lsnrow:last-of-type { border-bottom: none; }
.lsnmain { flex: 1; min-width: 0; }
.lsn1 { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.lsn1 b { font-size: 28rpx; }
.lsn1 .mi { font-size: 23rpx; }
.lsn2 { font-size: 26rpx; color: var(--text); font-weight: 600; margin-top: 6rpx; }
.lsn3 {
  font-size: 24rpx; color: var(--sub); margin-top: 4rpx; line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.lsnacts { display: flex; gap: 22rpx; flex: none; padding-top: 4rpx; }
.lsnacts .mi { font-size: 24rpx; }
.lsnacts .act { color: var(--brand); }
.lsnacts .del { color: var(--muted); }

/* 弹层表单 */
.lbl { font-size: 25rpx; color: var(--sub); margin: 22rpx 0 10rpx; }
.inp {
  background: var(--chip); border-radius: 14rpx; padding: 18rpx 22rpx;
  font-size: 28rpx; color: var(--text);
}
.inp.pick { color: var(--text); }
.timerow { display: flex; align-items: center; gap: 16rpx; }
.timerow picker { flex: 1; }
.tsep { font-size: 26rpx; color: var(--muted); }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.chip {
  font-size: 25rpx; padding: 12rpx 26rpx; border-radius: 999rpx;
  background: var(--chip); color: var(--text-2);
}
.chip.on { background: var(--brand); color: #fff; font-weight: 700; }

/* 弹层三件套：遮罩 / 底部弹卡 / 标题（与 terms 页同一视觉；全局 wxss 没有这几个类，
   各页自带——这页建时漏了，导致弹层摊在页面底部、被 termfab(z-index:30) 盖住点不了） */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: var(--mask); z-index: 60;   /* 必须压过固定底栏(30)和页面内容 */
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--card); border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 94vh; overflow-y: auto; -webkit-overflow-scrolling: touch; box-sizing: border-box;
}
.sheet-t { text-align: center; font-size: 34rpx; font-weight: 700; color: var(--text); margin-bottom: 10rpx; }

/* 课次详细内容多行框（照 mgr 页：全局没有，缺了会缩成无底色细线） */
.crstext {
  display: block; width: 100%; box-sizing: border-box; min-height: 150rpx;
  background: var(--bg); border-radius: 16rpx; padding: 20rpx;
  font-size: 27rpx; color: var(--text-2); line-height: 1.6;
}

/* 占位符颜色（其他页都自带，这里漏了） */
.ph { color: var(--faint); }

/* 底部按钮 */
.termfab {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2rpx solid var(--line);
}
.termfab .btn { width: 100%; }

.hint { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin: 20rpx 24rpx 20rpx; }
.hint2 { font-size: 25rpx; color: var(--sub); line-height: 1.8; }
.empty { text-align: center; color: var(--faint); font-size: 26rpx; padding: 30rpx 0; }
.row2 { display: flex; gap: 16rpx; margin-top: 30rpx; }
.row2 .btn { flex: 1; }
